              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                <div"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                                  className={`w-full max-w-[26px] rounded-t-md ${"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
