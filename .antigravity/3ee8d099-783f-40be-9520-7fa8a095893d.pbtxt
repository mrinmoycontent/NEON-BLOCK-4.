ed, true);\nassert.equal(mixedHist.days[1].progressPct, 100);\nassert.equal(mixedHist.days[3].dateKey, \'2026-11-20\');\nassert.equal(mixedHist.days[3].completed, false);\nassert.equal(mixedHist.days[3].attempted, true);\nassert.ok(mixedHist.days[3].progressPct >= 45 && mixedHist.days[3].progressPct <= 55);\nassert.equal(mixedHist.days[5].completed, true);\nassert.equal(mixedHist.days[6].completed, true);\nassert.equal(mixedHist.days[6].isToday, true);\n\nconsole.log(\'ALL 7-DAY STREAK HISTORY TESTS PASSED\');\n\""
