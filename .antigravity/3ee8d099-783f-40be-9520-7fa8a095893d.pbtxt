      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Dismiss Dashboard reward celebration modal on Escape before returning to previous view, while yielding to How to Play overlay\", \"EndLine\":80, \"Instruction\":\"Add optional isHelpOpen prop and capture-phase Escape handler for the reward claim celebration dialog.\", \"ReplacementContent\":\"  onOpenDailyChallenge: () => void;\\n  onBack: () => void;\\n  isHelpOpen?: boolean;\\n}\\n\\nexport const DashboardScreen: React.FC<DashboardScreenProps> = ({\\n  profile,\\n  dailyState,\\n  todayKey,\\n  initialTab = \'OVERVIEW\',\\n  reducedMotion,\\n  onClaimDailyMilestone,\\n  onClearComboHistory,\\n  onSelectTheme,\\n  onSelectParticleStyle,\\n  onOpenDailyChallenge,\\n  onBack,\\n  isHelpOpen = false,\\n}) => {\\n  const [activeTab, setActiveTab] = useState<DashboardTab>(initialTab);\\n  const [confirmClear, setConfirmClear] = useState(false);\\n  const [claimCelebration, setClaimCelebration] =\\n    useState<ClaimMilestoneResult | null>(null);\\n  const backBtnRef = useRef<HTMLButtonElement>(null);\\n\\n  useEffect(() => {\\n    setActiveTab(initialTab);\\n  }, [initialTab]);\\n\\n  useEffect(() => {\\n    backBtnRef.current?.focus();\\n  }, []);\\n\\n  // Dismiss reward celebration dialog on Escape before returning from Dashboard\\n  useEffect(() => {\\n    if (!claimCelebration || isHelpOpen) return;\\n    const onKeyDown = (e: KeyboardEvent) => {\\n      if (e.key === \'Escape\' || e.key === \'GoBack\' || e.key === \'Backspace\') {\\n        e.preventDefault();\\n        e.stopImmediatePropagation();\\n        setClaimCelebration(null);\\n      }\\n    };\\n    window.addEventListener(\'keydown\', onKeyDown, true);\\n    return () => window.removeEventListener(\'keydown\', onKeyDown, true);\\n  }, [claimCelebration, isHelpOpen]);\", \"StartLine\":46, \"TargetContent\":\"  onOpenDailyChallenge: () => void;\\n  onBack: () => void;\\n}\\n\\nexport const DashboardScreen: React.FC<DashboardScreenProps> = ({\\n  profile,\\n  dailyState,\\n  todayKey,\\n  initialTab = \'OVERVIEW\',\\n  reducedMotion,\\n  onClaimDailyMilestone,\\n  onClearComboHistory,\\n  onSelectTheme,\\n  onSelectParticleStyle,\\n  onOpenDailyChallenge,\\n  onBack,\\n}) => {\\n  const [activeTab, setActiveTab] = useState<DashboardTab>(initialTab);\\n  const [confirmClear, setConfirmClear] = useState(false);\\n  const [claimCelebration, setClaimCelebration] =\\n    useState<ClaimMilestoneResult | null>(null);\\n  const backBtnRef = useRef<HTMLButtonElement>(null);\\n\\n  useEffect(() => {\\n    setActiveTab(initialTab);\\n  }, [initialTab]);\\n\\n  useEffect(() => {\\n    backBtnRef.current?.focus();\\n  }, []);\", \"TargetFile\":\"/src/components/DashboardScreen.tsx\", \"toolAction\":\"Adding Escape support for Dashboard celebration modal\", \"toolSummary\":\"Update DashboardScreen Escape handling\"}"
      original_name: "replace_file_content"
    }
