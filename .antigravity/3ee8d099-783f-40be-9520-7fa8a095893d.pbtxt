      thinking_signature: "\022\272\024\n\267\024\001i\024}\0230zd\223\315\f\225\347\247\035i\002\303s;\366\324\356\342k\n\217\3267wZ\276\230\207\201\246<#\362h$\227*\235\242\352\017\2363\236\3025S\375\267\303\201\v\203\300\363\367\005\002\314gZ}@\335\323J\342ej,a\306\b\275\275\227\237/\260qE\263\327o\027\277\302\377\345w\207\033\250z\220o\246K\212\247\237g\241\227\231\3356sI\272\227\020\361r\350\375\005\314[\323\336\317\310#\330}1x!J\f\220\225\377\305\030\231h\000W!\243\357\206\027\222\247b\341)\247\213\276\003\332\367!R\362bL_q\244\017\251d\340\312\351\264^\342\305bf\025r\246t\f\364mh\271\0211K\000\243\372\340\341\227\340.\254|\310\355q!\3060\374\266\327-TT\2231\222\216\017.\n}\253\220C\023\246\211\036\356\330\005\204\"\300[\305.h\f/\020nrA\250\307\357E\261\305\372\221\374\333\232\032\217~\3606\342\314\333\256\352\246\355\225>K\315N;y\342\251\365\246\231\037\372\262\227\237\376\272\223\034^\313o\001DT\005R[\213C\207-s\035\202\023\2434u\256?\232\357V\374\177\351~g\213\371K\021peX\221\354\376\223\337\235\323\0363\350\325\334;T8[%YJQ\316rv\236\334\352\235_U\337gY\330~,m\364\335\235\214XT.\370\315@\214]\356\237\252-\353\253\213\300@h%_\034\317jZ\344X^\235\305\252\341\035\204\016\345\210\300\016\364\303i{\231k\305\027E\374\321\207\360\231\250o^A\375\220\373\332\205\355\326y\257\336s\030\204\275\023\n\vHq~\314\323\034\006\337\274\364H\350\376J\021\026u\005\361\334y\323A1\263w\307A\213\204\264PT\272\360t\364\327\276\200\303\343L\225\316\002\233%\361\350:D@\322\262\243\350\000J.\371\310\t\351\224\351X\016\3108F*$C\367\346\311\251,\016\272\321\317\213\342\207\274b\241\267\373s\004\224\211\202\262\2614`\301\216\031V\320\264\254\212S|\270k\377\t\211m\'E\'\364N\227\323\bH\"\344\3351\272\024\253\302\211\032\270LPT\305X\330\321HLo\367}2\036\254\203\251\bk\226\263\257\3167wb\2310\343\277I\016\210\353|\313\3353\360\347\342\327x;\002\342-\2059\364zQS\t\225\305)\272\226L,\025\327\244\231\310P\342\017\000^~\211\253\242G\331pG\216\325\274^k\316\232$c\f\207\341\36284\273\020F\347\275V\'\242\003\002\273C\342\222rg\246\003\326#2\234u\305J\375vz\300\250{_\037\aH\265c\004\272}\357\275H\353\177\207\a\205\332\232\232\260U\021kM\356\023\217\312\220rg\200\374<w3\210]\237\022g\206\354\254\206\021\305I\262\376\302\301\314g\021\000V\032a)\245\306\217\033W\374\341\341\251\332\2115\305V\211{)+\3024\353oJ\315O\321\342\206\030\263\002\264\202%\364\003WG\261\343)\333\336a\341*S\314;+\232\305\021\3667\204\211u\347h\0343\357\017\246\271\362\325h\333S\202\206\335<\324\211\336(\246*9\b\253\236\236\316\215\243\261\310\320O\234\372*!\320\231\217b\3503a\251\236\237\257\323\031\207\205w\345(o\030\356N\027?\200}<\026\236\310A\271\277E\220H\270\345\217\357\241\232X\215\365\301.\251$:\362\233x)\220\341J\277EO\225\356N\236\321\374\257\334\350\375\212\f\230\316\361w!\337\261_m$\223\035\237J\213F\270dy\377\006\353T\327|\206&\214\373\227\320G\314\"\234r\177X\373\032\344\343\n\220\345\210\3438F\\P\325 \244l\210\033\t\215w8\376,vy\215z/\372F\\\240\332T3M\016\235\256\327dVtv2\265\357\216-5\a\302y\210\r\b\tC/\365a\245\244\2042\2226qyo8@[\345z\223Hrg]\265\t0H+k\336\353\244k\340\275\276\274\274\001\302\312\362f\373v}\265|B\337\374\320\330\356P\v\252\027\325\032\2626\317\326oV\266\374\'\371~\003\006\374N\213fB\371/\221L\301\016\1773\367\017H\037\022k\314*;R$\000;\211`\232A\307#\345\2556\277\206\253\261\2648/O\244\361c\036\2562\242=\247J\332\256\262\365UV\026\n$\204\272}\223\362\375\016\341\036p\201\341\257\314\f\367\305\354\263\237\026\373\320$\273\020\226\352\2478(g\364!\373I\314\271Q\203gy\215\237\036\177u\372\301Y\370\351\rH\312\252JonL\266(J\256\205p\024h\371\004\372G\212\322\273\245K\274&7\340\352\243\030[\005\252\377\310\256\244b\217g%\223\210\004\316}\371V\226\263\371\277r2\000\272\310\317\241\314\354/(\366\n\334g\b\247\362\343T\355}\225\357\266\364\240\224\362A\354\254\321NJ,{\352k\353\227\037F+Yb\224r-\202\026rf^$\363\034\303X\235\320\371\366\234\366\264\313(\263\037\fle\317qt\272\216\336K\237\361*\372\362\343 \310\0238\252 \222\254n\"\3376-\3304&\362q\035\340)\006\033Kk\02