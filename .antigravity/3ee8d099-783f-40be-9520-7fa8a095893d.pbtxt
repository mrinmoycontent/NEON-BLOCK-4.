      thinking_signature: "\022\237\n\n\234\n\001i\024}\023\367\311s\314N\256\372\273 \311\337$u\370p\321\325&\320h\340\256\025q\256\273\261I\223\326\203:\376Y\351\026\261-\366\253\371\301z\273\ax\324lc\256\270\023s\261/\303*O\212t\177%(\033\n9G\257\237\323&\227D\344\273Ob\303X\025\313F\v\2037#\335\027B\021\304CO\247\033\302\201q@\350\255W\004hb*B&\266\330\201\275\262\354Qp\f$\267:\022\032m\336*Q\363\335\374\f\215\3213\373\345\246!\216\f3I\241\227XL\302T\374)W\316\345\253\252\300\323\365\313\331\337\335\271\316\326\203[B\300\340\350/\027\260\004\232\231\236\310\036f\026\035\003\317g\000\325\273\033{\354c\216N`\224\205.\306\205\270\177\t,se\231y\017\342\220\200\273\230Evd\237\020+\212\330V\346\263m\261\331\215\017\233\005\364\266c}\271\n\224\254f\344u\325KU\273=A1\325\243\320\244\003\017\365z\224&?\206j\370\215h\234\350\255Q\3352\271/\"\271\006~\271\020^$\324\247\034\006\341p\273\373%w\\a\203\276\203\242\235Q5\227\371(wM\024\036\267J^\274\345\215>E\211.\034\200\265\262\207\347\3712\251z\263\312\317\223\234\252\312\'\336-\244\260e<\362\255\363\240\2044)\266\2031@\002\017[\206\302\206\363\275\320\323Y\022\335C\237e\317\2268K\337\233\365\004-\214\2003\251\364\254W\322|z\00272\207\345\3226gxb\330pdIQY0f\274\001PPL\233\222up{\234\177\366\346\350(\216O\350!\336\016\321F\255\257\242\203\302\362\371\336mH\362;\311\375.\b@~\306\354\"\365\214\323O\031\317\003\bz\375K\a^-\034\021l\341MyY%@\031\343\220\223\032ZV\361\306\206\344\250\3624\263\006 \004\242\231\340Z\201&\375\324K\373\302V\321g\023\344\247\223\321\221\356ZS\327&S3\262t\205Ib\343\".F+\0058\220\274\236\317\330\237\002\376\217\210;\237\265\204\265i3\221`\333\216\233\271U\2228\377jj\373\324\365\265\341+\311\271\317\026\214\276$*\340\026\033\235\320PlR\317\232:\342<\aJ]\330\365\271\317\244\231\356\035\225r\327\275|\210\377?\266\241\336,\272\001Tq\025\3037\035\273]\033!\230~4\303\222\177}4\3233\203d\263\\7\355\344\335\006B\232\346\b\243\206\351\224\267y\341\367C\341\373\0161\371\352u\346)\366\246\237\357I\nU\355\211p\035\0