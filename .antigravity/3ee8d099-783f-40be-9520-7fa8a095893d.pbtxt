              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const col = Math.floor((x - originX + layout.cellGap * 0.5) / step);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const row = Math.floor((y - originY + layout.cellGap * 0.5) / step);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
