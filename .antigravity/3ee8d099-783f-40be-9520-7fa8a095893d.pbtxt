    content: "import React, { useEffect, useImperativeHandle, useRef } from \'react\';\nimport { neonAudio } from \'../game/audio\';\nimport {\n  applyPiecePlacement,\n  computePlacementPreview,\n  createEmptyGrid,\n  createShowcaseGrid,\n  findAllValidPlacements,\n  generateTray,\n  getMaxTileOnGrid,\n} from \'../game/engine\';\nimport { getTilePalette } from \'../game/palette\';\nimport {\n  AmbientMote,\n  CanvasLayout,\n  CursorVisualState,\n  DragVisualState,\n  computeCanvasLayout,\n  createAmbientMotes,\n  getCellRect,\n  hitTestTraySlot,\n  renderNeonCanvas,\n  screenToGridAnchor,\n  screenToSingleCell,\n} from \'../game/renderer\';\nimport {\n  BlockPiece,\n  FloatingText,\n  GRID_SIZE,\n  GameStats,\n  GameStatus,\n  GridMatrix,\n  LineBeam,\n  MergeGhostTile,\n  Particle,\n  PlacementPreview,\n  ShockwaveRing,\n  TRAY_SIZE,\n  TurnResolution,\n} from \'../game/types\';\n\nexport interface NeonCanvasHandle {\n  startNewGame: () => void;\n  focusBoard: () => void;\n}\n\ninterface NeonCanvasProps {\n  status: GameStatus;\n  bestScore: number;\n  reducedMotion: boolean;\n  onStatsChange: (stats: GameStats) => void;\n  onComboEvent: (label: string) => void;\n  onGameOver: (finalStats: GameStats) => void;\n  onRequestPause: () => void;\n  onRequestToggleMute: () => void;\n  onRequestHudFocus: () => void;\n}\n\ninterface SimState {\n  grid: GridMatrix;\n  tray: (BlockPiece | null)[];\n  selectedSlot: number;\n  stats: GameStats;\n  preview: PlacementPreview | null;\n  drag: DragVisualState | null;\n  pointerDownPos: { x: number; y: number; slot: number; pointerType: string } | null;\n  cursor: CursorVisualState;\n  particles: Particle[];\n  shockwaves: ShockwaveRing[];\n  beams: LineBeam[];\n  floatingTexts: FloatingText[];\n  mergeGhosts: MergeGhostTile[];\n  motes: AmbientMote[];\n  shakeTimer: number;\n  shakeIntensity: number;\n  time: number;\n}\n\nexport const NeonCanvas = React.forwardRef<NeonCanvasHandle, NeonCanvasProps>(\n  (\n    {\n      status,\n      bestScore,\n      reducedMotion,\n      onStatsChange,\n      onComboEvent,\n      onGameOver,\n      onRequestPause,\n      onRequestToggleMute,\n      onRequestHudFocus,\n    },\n    ref\n  ) => {\n    const containerRef = useRef<HTMLDivElement>(null);\n    const canvasRef = useRef<HTMLCanvasElement>(null);\n    const layoutRef = useRef<CanvasLayout>(computeCanvasLayout(800, 600));\n\n    const statusRef = useRef(status);\n    statusRef.current = status;\n\n    const bestScoreRef = useRef(bestScore);\n    bestScoreRef.current = bestScore;\n\n    const reducedMotionRef = useRef(reducedMotion);\n    reducedMotionRef.current = reducedMotion;\n\n    const simRef = useRef<SimState>({\n      grid: createShowcaseGrid(),\n      tray: [null, null, null],\n      selectedSlot: -1,\n      stats: {\n        score: 0,\n        bestScore,\n        maxTile: 512,\n        mergesCount: 0,\n        linesCleared: 0,\n        bestCombo: 0,\n        turnsPlayed: 0,\n        isNewBest: false,\n      },\n      preview: null,\n      drag: null,\n      pointerDownPos: null,\n      cursor: {\n        visible: false,\n        zone: \'GRID\',\n        gridRow: 2,\n        gridCol: 2,\n        traySlot: 0,\n      },\n      particles: [],\n      shockwaves: [],\n      beams: [],\n      floatingTexts: [],\n      mergeGhosts: [],\n      motes: createAmbientMotes(26, 900, 600),\n      shakeTimer: 0,\n      shakeIntensity: 0,\n      time: 0,\n    });\n\n    const selectNextAvailableSlot = (tray: (BlockPiece | null)[], preferred = 0): number => {\n      if (tray[preferred]) return preferred;\n      for (let i = 0; i < TRAY_SIZE; i++) {\n        if (tray[i]) return i;\n      }\n      return -1;\n    };\n\n    const updateCursorPreview = () => {\n      const sim = simRef.current;\n      if (\n        statusRef.current !== \'PLAYING\' ||\n        !sim.cursor.visible ||\n        sim.cursor.zone !== \'GRID\' ||\n        sim.selectedSlot < 0\n      ) {\n        if (!sim.drag?.active) {\n          sim.preview = null;\n        }\n        return;\n      }\n      const piece = sim.tray[sim.selectedSlot];\n      if (!piece) {\n        sim.preview = null;\n        return;\n      }\n      const clampedR = Math.max(0, Math.min(GRID_SIZE - piece.height, sim.cursor.gridRow));\n      const clampedC = Math.max(0, Math.min(GRID_SIZE - piece.width, sim.cursor.gridCol));\n      sim.preview = computePlacementPreview(sim.grid, piece, clampedR, clampedC);\n    };\n\n    const startNewGame = () => {\n      const sim = simRef.current;\n      const freshGrid = createEmptyGrid();\n      const freshTray = generateTray(freshGrid);\n\n      sim.grid = freshGrid;\n      sim.tray = freshTray;\n      sim.selectedSlot = 0;\n      sim.preview = null;\n      sim.drag = null;\n      sim.pointerDownPos = null;\n      sim.particles = [];\n      sim.shockwaves = [];\n      sim.beams = [];\n      sim.floatingTexts = [];\n      sim.mergeGhosts = [];\n      sim.shakeTimer = 0;\n      sim.shakeIntensity = 0;\n      sim.cursor = {\n        visible: false,\n        zone: \'GRID\',\n        gridRow: 2,\n        gridCol: 2,\n        traySlot: 0,\n      };\n      sim.stats = {\n        score: 0,\n        bestScore: bestScoreRef.current,\n        maxTile: 0,\n        mergesCount: 0,\n        linesCleared: 0,\n        bestCombo: 0,\n        turnsPlayed: 0,\n        isNewBest: false,\n      };\n\n      onStatsChange({ ...sim.stats });\n      onComboEvent(\'\');\n    };\n\n    useImperativeHandle(ref, () => ({\n      startNewGame,\n      focusBoard: () => {\n        canvasRef.current?.focus();\n        const sim = simRef.current;\n        sim.cursor.visible = true;\n        sim.cursor.zone = \'GRID\';\n        updateCursorPreview();\n      },\n    }));\n\n    const spawnVfxForResolution = (res: TurnResolution) => {\n      const sim = simRef.current;\n      const layout = layoutRef.current;\n      const rm = reducedMotionRef.current;\n\n      // Placement subtle sparks\n      if (!rm) {\n        for (const pt of res.placedCells) {\n          const rect = getCellRect(layout, pt.r, pt.c);\n          const cx = rect.x + rect.w / 2;\n          const cy = rect.y + rect.h / 2;\n          for (let i = 0; i < 4; i++) {\n            const ang = (Math.PI * 2 * i) / 4 + Math.random() * 0.6;\n            const spd = 40 + Math.random() * 70;\n            sim.particles.push({\n              x: cx,\n              y: cy,\n              vx: Math.cos(ang) * spd,\n              vy: Math.sin(ang) * spd,\n              size: 2 + Math.random() * 1.5,\n              color: \'#38BDF8\',\n              alpha: 0.9,\n              life: 0.35,\n              maxLife: 0.35,\n            });\n          }\n        }\n      }\n\n      // Merge VFX\n      for (const merge of res.mergeSteps) {\n        const targetRect = getCellRect(layout, merge.targetCell.r, merge.targetCell.c);\n        const tx = targetRect.x + targetRect.w / 2;\n        const ty = targetRect.y + targetRect.h / 2;\n        const pal = getTilePalette(merge.newValue);\n\n        if (!rm) {\n          for (const fc of merge.fromCells) {\n            const fromRect = getCellRect(layout, fc.r, fc.c);\n            sim.mergeGhosts.push({\n              fromX: fromRect.x,\n              fromY: fromRect.y,\n              toX: targetRect.x,\n              toY: targetRect.y,\n              size: targetRect.w,\n              value: merge.oldValue,\n              progress: 0,\n              duration: 0.14,\n            });\n          }\n\n          sim.shockwaves.push({\n            x: tx,\n            y: ty,\n            radius: targetRect.w * 0.25,\n            maxRadius: targetRect.w * (1.25 + merge.comboDepth * 0.2),\n            color: pal.border,\n            alpha: 0.9,\n            life: 0.34,\n            maxLife: 0.34,\n            lineWidth: 3,\n          });\n\n          const burstCount = Math.min(24, 10 + merge.comboDepth * 4);\n          for (let i = 0; i < burstCount; i++) {\n            const ang = Math.random() * Math.PI * 2;\n            const spd = 70 + Math.random() * 170;\n            sim.particles.push({\n              x: tx,\n              y: ty,\n              vx: Math.cos(ang) * spd,\n              vy: Math.sin(ang) * spd,\n              size: 2.2 + Math.random() * 2.5,\n              color: i % 2 === 0 ? pal.border : \'#E0F2FE\',\n              alpha: 1,\n              life: 0.45 + Math.random() * 0.2,\n              maxLife: 0.65,\n            });\n          }\n        }\n\n        sim.floatingTexts.push({\n          x: tx,\n          y: ty - 8,\n          vy: -42,\n          text: `+${merge.points}`,\n          subtext: merge.comboDepth > 1 ? `CHAIN \303\227${merge.comboDepth}` : `MERGE ${merge.newValue}`,\n          color: pal.border,\n          life: 0.95,\n          maxLife: 0.95,\n          scale: merge.comboDepth > 1 ? 1.15 : 1,\n        });\n      }\n\n      // Line Clear VFX\n      if (res.lineClearStep) {\n        const { rows, cols, points } = res.lineClearStep;\n        const { boardRect, cellSize } = layout;\n\n        for (const r of rows) {\n          const first = getCellRect(layout, r, 0);\n          sim.beams.push({\n            x: boardRect.x + 6,\n            y: first.y + cellSize * 0.18,\n            w: boardRect.w - 12,\n            h: cellSize * 0.64,\n            color: \'rgba(34, 211, 238, 0.85)\',\n            life: 0.36,\n            maxLife: 0.36,\n          });\n        }\n        for (const c of cols) {\n          const first = getCellRect(layout, 0, c);\n          sim.beams.push({\n            x: first.x + cellSize * 0.18,\n            y: boardRect.y + 6,\n            w: cellSize * 0.64,\n            h: boardRect.h - 12,\n            color: \'rgba(192, 132, 252, 0.85)\',\n            life: 0.36,\n            maxLife: 0.36,\n          });\n        }\n\n        if (!rm) {\n          for (const cell of res.lineClearStep.clearedCells) {\n            const rect = getCellRect(layout, cell.r, cell.c);\n            const cx = rect.x + rect.w / 2;\n            const cy = rect.y + rect.h / 2;\n            const pal = getTilePalette(cell.value);\n            for (let i = 0; i < 6; i++) {\n              const ang = Math.random() * Math.PI * 2;\n              const spd = 80 + Math.random() * 180;\n              sim.particles.push({\n                x: cx,\n                y: cy,\n                vx: Math.cos(ang) * spd,\n                vy: Math.sin(ang) * spd,\n                size: 2.5 + Math.random() * 2,\n                color: pal.border,\n                alpha: 1,\n                life: 0.5,\n                maxLife: 0.5,\n              });\n            }\n          }\n        }\n\n        const totalLines = rows.length + cols.length;\n        sim.floatingTexts.push({\n          x: boardRect.x + boardRect.w / 2,\n          y: boardRect.y + boardRect.h / 2,\n          vy: -36,\n          text: `+${points}`,\n          subtext: totalLines > 1 ? `MEGA CLEAR \303\227${totalLines}` : \'LINE CLEAR\',\n          color: \'#67E8F9\',\n          life: 1.05,\n          maxLife: 1.05,\n          scale: 1.2,\n        });\n      }\n\n      // Micro camera shake on big combos or line clears\n      if (!rm && (res.maxComboDepth >= 2 || res.lineClearStep)) {\n        sim.shakeTimer = 0.2;\n        sim.shakeIntensity = Math.min(9, 3 + res.maxComboDepth * 2 + (res.lineClearStep ? 2.5 : 0));\n      }\n    };\n\n    const executePlacement = (slotIndex: number, anchorRow: number, anchorCol: number): boolean => {\n      const sim = simRef.current;\n      const piece = sim.tray[slotIndex];\n      if (!piece) return false;\n\n      const clampedR = Math.max(0, Math.min(GRID_SIZE - piece.height, anchorRow));\n      const clampedC = Math.max(0, Math.min(GRID_SIZE - piece.width, anchorCol));\n\n      const res = applyPiecePlacement(sim.grid, sim.tray, slotIndex, clampedR, clampedC);\n      if (!res) {\n        neonAudio.playInvalid();\n        return false;\n      }\n\n      neonAudio.playPlace();\n\n      if (res.mergeSteps.length > 0) {\n        const lastMerge = res.mergeSteps[res.mergeSteps.length - 1];\n        setTimeout(() => {\n          neonAudio.playMerge(res.maxComboDepth, lastMerge.newValue);\n        }, 45);\n      }\n\n      if (res.lineClearStep) {\n        const totalLines = res.lineClearStep.rows.length + res.lineClearStep.cols.length;\n        setTimeout(() => {\n          neonAudio.playLineClear(totalLines);\n        }, 70);"
    num_lines: 1023
