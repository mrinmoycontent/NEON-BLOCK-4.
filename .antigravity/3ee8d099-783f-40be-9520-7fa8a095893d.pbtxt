    content: "export interface TilePaletteEntry {\n  bgTop: string;\n  bgBottom: string;\n  border: string;\n  glow: string;\n  text: string;\n  innerAccent: string;\n}\n\nexport const TILE_PALETTE: Record<number, TilePaletteEntry> = {\n  2: {\n    bgTop: \'#083344\',\n    bgBottom: \'#062030\',\n    border: \'#22D3EE\',\n    glow: \'rgba(34, 211, 238, 0.55)\',\n    text: \'#ECFEFF\',\n    innerAccent: \'rgba(34, 211, 238, 0.22)\',\n  },\n  4: {\n    bgTop: \'#0C4A6E\',\n    bgBottom: \'#082F49\',\n    border: \'#38BDF8\',\n    glow: \'rgba(56, 189, 248, 0.6)\',\n    text: \'#F0F9FF\',\n    innerAccent: \'rgba(56, 189, 248, 0.24)\',\n  },\n  8: {\n    bgTop: \'#1E3A8A\',\n    bgBottom: \'#172554\',\n    border: \'#60A5FA\',\n    glow: \'rgba(96, 165, 250, 0.65)\',\n    text: \'#EFF6FF\',\n    innerAccent: \'rgba(96, 165, 250, 0.26)\',\n  },\n  16: {\n    bgTop: \'#312E81\',\n    bgBottom: \'#1E1B4B\',\n    border: \'#818CF8\',\n    glow: \'rgba(129, 140, 248, 0.68)\',\n    text: \'#EEF2FF\',\n    innerAccent: \'rgba(129, 140, 248, 0.28)\',\n  },\n  32: {\n    bgTop: \'#4C1D95\',\n    bgBottom: \'#2E1065\',\n    border: \'#A78BFA\',\n    glow: \'rgba(167, 139, 250, 0.72)\',\n    text: \'#F5F3FF\',\n    innerAccent: \'rgba(167, 139, 250, 0.30)\',\n  },\n  64: {\n    bgTop: \'#581C87\',\n    bgBottom: \'#3B0764\',\n    border: \'#C084FC\',\n    glow: \'rgba(192, 132, 252, 0.76)\',\n    text: \'#FAF5FF\',\n    innerAccent: \'rgba(192, 132, 252, 0.32)\',\n  },\n  128: {\n    bgTop: \'#701A75\',\n    bgBottom: \'#4A044E\',\n    border: \'#E879F9\',\n    glow: \'rgba(232, 121, 249, 0.78)\',\n    text: \'#FDF4FF\',\n    innerAccent: \'rgba(232, 121, 249, 0.32)\',\n  },\n  256: {\n    bgTop: \'#0E7490\',\n    bgBottom: \'#164E63\',\n    border: \'#00F0FF\',\n    glow: \'rgba(0, 240, 255, 0.85)\',\n    text: \'#FFFFFF\',\n    innerAccent: \'rgba(0, 240, 255, 0.36)\',\n  },\n  512: {\n    bgTop: \'#4338CA\',\n    bgBottom: \'#1E1B4B\',\n    border: \'#67E8F9\',\n    glow: \'rgba(103, 232, 249, 0.88)\',\n    text: \'#FFFFFF\',\n    innerAccent: \'rgba(168, 85, 247, 0.40)\',\n  },\n  1024: {\n    bgTop: \'#6D28D9\',\n    bgBottom: \'#3B0764\',\n    border: \'#F0ABFC\',\n    glow: \'rgba(240, 171, 252, 0.92)\',\n    text: \'#FFFFFF\',\n    innerAccent: \'rgba(34, 211, 238, 0.42)\',\n  },\n  2048: {\n    bgTop: \'#0284C7\',\n    bgBottom: \'#581C87\',\n    border: \'#E0F2FE\',\n    glow: \'rgba(224, 242, 254, 0.95)\',\n    text: \'#FFFFFF\',\n    innerAccent: \'rgba(255, 255, 255, 0.45)\',\n  },\n};\n\nexport function getTilePalette(value: number): TilePaletteEntry {\n  if (TILE_PALETTE[value]) {\n    return TILE_PALETTE[value];\n  }\n  if (value > 2048) {\n    return {\n      bgTop: \'#0891B2\',\n      bgBottom: \'#6B21A8\',\n      border: \'#F0FDFA\',\n      glow: \'rgba(103, 232, 249, 0.98)\',\n      text: \'#FFFFFF\',\n      innerAccent: \'rgba(255, 255, 255, 0.5)\',\n    };\n  }\n  return TILE_PALETTE[2];\n}\n"
