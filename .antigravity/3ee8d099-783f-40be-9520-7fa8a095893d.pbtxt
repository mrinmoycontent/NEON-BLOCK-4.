ingle2];\nconst res = applyPiecePlacement(grid, tray, 0, 0, 2);\nassert.ok(res, \'Resolution succeeded\');\nassert.equal(res.mergeSteps.length, 2, \'Triggered 2 cascading merge steps\');\nassert.equal(res.maxComboDepth, 2, \'Max combo depth is 2\');\nassert.equal(grid[0][2]?.value, 8, \'Target cell upgraded 2 -> 4 -> 8\');\nassert.equal(grid[0][0], null, \'Merged source cleared\');\nassert.equal(grid[0][3], null, \'Chain source cleared\');\nassert.equal(tray[0], null, \'Placed slot cleared\');\nassert.equal(canPlacePiece(grid, single2, 0, 2), false, \'Collision rejects occupied cell (0,2)\');\n\n// 3. Full Row Line Clear + Scoring\nconst lineGrid = createEmptyGrid();\nfor (let c = 0; c < 5; c++) {\n  lineGrid[2][c] = { id: allocateTileId(), value: c % 2 === 0 ? 4 : 8, scale: 1, targetScale: 1, offsetX: 0, offsetY: 0, flash: 0 };\n}\nconst single16: BlockPiece = {\n  id: \'test-single16\',\n  shapeName: \'SINGLE\',\n  cells: [{ dr: 0, dc: 0, value: 16 }],\n  width: 1,\n  height: 1,\n};\nconst lineTray: (BlockPiece | null)[] = [single16, single2, single2];\nconst lineRes = applyPiecePlacement(lineGrid, lineTray, 0, 2, 5);\nassert.ok(lineRes?.lineClearStep, \'Row 2 cleared\');\nassert.deepEqual(lineRes.lineClearStep.rows, [2]);\nfor (let c = 0; c < GRID_SIZE; c++) {\n  assert.equal(lineGrid[2][c], null, \'All cells in cleared row are null\');\n}\n\n// 4. Tray Refill & Game Over Detection\nconst fullGrid = createEmptyGrid();\nfor (let r = 0; r < GRID_SIZE; r++) {\n  for (let c = 0; c < GRID_SIZE; c++) {\n    // Checkerboard of 2 and 4 so nothing merges and board is completely full\n    fullGrid[r][c] = { id: allocateTileId(), value: (r + c) % 2 === 0 ? 2 : 4, scale: 1, targetScale: 1, offsetX: 0, offsetY: 0, flash: 0 };\n  }\n}\nconst blockedTray = generateTray(fullGrid);\nassert.equal(hasAnyValidMove(fullGrid, blockedTray), false, \'Full board detects zero valid moves\');\n\n// 5. Nearly full board with only 1 empty cell -> guaranteed single piece fits\nfullGrid[5][5] = null;\nconst rescueTray = generateTray(fullGrid);\nassert.equal(hasAnyValidMove(fullGrid, rescueTray), true, \'Board with 1 empty cell gets playable piece\');\n\n// 6. Responsive Layout Geometry Check across tablet/desktop/mobile sizes\nconst viewports = [\n  [1280, 800],\n  [1024, 600],\n  [1440, 900],\n  [390, 844],\n  [768, 1024],\n];\nfor (const [w, h] of viewports) {\n  const layout = computeCanvasLayout(w, h);\n  assert.ok(layout.boardRect.x >= 0 && layout.boardRect.y >= 0);\n  assert.ok(layout.boardRect.x + layout.boardRect.w <= w);\n  assert.ok(layout.boardRect.y + layout.boardRect.h <= h);\n  for (const s of layout.traySlots) {\n    assert.ok(s.x >= 0 && s.y >= 0);\n    assert.ok(s.x + s.w <= w);\n    assert.ok(s.y + s.h <= h);\n  }\n}\nconsole.log(\'ALL NEON BLOCK ENGINE & LAYOUT TESTS PASSED!\');\n\""
