            lines {
              text: "export function drawBlockPiece("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx: CanvasRenderingContext2D,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  piece: BlockPiece,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
