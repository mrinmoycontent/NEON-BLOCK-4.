P\322i\3325\250\004\354\271^H\354N-\272{\253wc\266\367\204h\316\351\246\333\316\033k\034#6\361l\027\f\202/^~\263t\204\356\322EY@<\215\204J\002r\246\254H\274\221:\255\200MC\264\177\025SIy1\254\346].\036\311*=_6\340\245\2679}\225\370!\244\353\033\222R-P\334\351a\211\342\246\207Y\266\255\333UOf\245\205~\257Sg\006\345(\210\004\030\237i\321!e\267pV\357\324\215R\355L\t\300\344V8\203\311\355\233\360Qc }-\333\003A\3357k\251V\264\331\333G\316\222\276n\245\036\354\205\230x!\262G]j\310o\262h\332\256\3505g\177R\032\033H\341P\275\314?\036Au\352\373\003\021\"\202\366Y\303\333\314\3033,X>\364\367h\220i\266pF!\371\277\277\226\026\332v\256w\357\230W\246\330\347q\224\214\243\301\376\311E\fa\204\311\331\356x\244g\231FA\314\236s/\016\024\301,\'-\275\271;\367\215\326\357\311\206]\270\31233\210w\361\004d\254\f\331\264\256\305\243\314\367p\366m\335\201\\u/\241\277W\216\262\243\277{\274\2224\377L5\311\375\aVoN\016\255C\b\265\215\377\230\351\371\003-R\243Q\225X\321d[\223\253\r%\220?\322\227\356\006\016Z\213\031l\265\323\236\321j\251\200e\223C\210o\335\200\334eg\224\361\310\005\205,t\'KV\356\'\'\027\352W\250*r=F\352}\202\204\266\b\000\346\2540Ka~\017\305\350\224\213\326\207\343q2\027\370\272vy\220%\323b{kE\270\217\026\3536>\210\247?b\201\236\362\250\tm\2668u[K:G\242T\250i\345\263Q\202N\311}\260h\322\bV\273\354xF\327s*\256\213F\374\352\321\277\300\317_\222\237\1770i\246\236\330\264et]\332\r\230I NOK,(*\2276\354r\343\302\256xo\320J\256\220\237\312\233\306G\321D\233o\230\001\340Q\263\202\020\vO\031\215k\2243\202,\2365\314\2120\375u\322\376\244>C\317\002\262H\266\322\230\263\025\311\030\375A\215LN\006\213w\274@\356\370\3028\245\177iw\023P)\377\'c\215$\377$L\231=:\262@\246\033\b[\3514\236D\265O 65\267\200\030\217\211[\312\003\235\266\222\r\353r.\313^g\242)\\f\237r\224\032\370\324\221\323\000\325P\323\325\226\351(o\202\v{8\024X\352\025g\240r\027\374\210\017i\265C\006\245\214*\253jv\006L]!\2129\0049\361\025\234\364\372\203\036K\020\247S\272m\f* \206\343\355\205{\303\244\250v\036ev\'\246C\245\027H\217\272Vd\247\334\277)\262\273p\037\231\177*\326\266\203\2061,\022z\326\252+8D\273\202Z\256\334Y|\vig$a>9[\236\020m\271\320\314b\333\226\362\223\370]RQ\vA\313\r\325_n\331\353r\202\250\325%0\315O\242\340\177\244\355Yaj\216\360b\310\252\372\357\346$\0043\364\241\3730h\211\262\236/,\316\376\331\242\360\247\275\\\301%j\370x\257\006\325\035\267\246\307\356\276Pl\220\022{\373\365\335H\357\340\202\004\323\324\255\341\323\302l\351lr\020|>.\375\205\307-\337NL;\022I%\230\035\375\323\306\272\223`]\250\002l\347Y\005\005x\255_\311i\373\023\254\225\213\221+3WSF\245J$\343\006\365$\263\324A6\363\270\003m\267\177\305\313\230&\245\362\313\032\245\t>aK\1776\303\374}jF\3762\316\367\227\213wA\024\n*\v\314j\035C\245\207\034\a\247\242z\201\221L\363x!\354\350\275n\323\240\307\345D\311\023\"\252$\2315\263\035\210t\3049w\274\360\343\334\364\246U\332T\342\351\323M\244\274\006\337\033 \220\312\370\'D\250\357\234@6\216\006\254\360\336\n}J\3248\307n4\233\215+\372L5\tZ?\313\375\225\351A\202\035o!\276\\rO2\252\020\344\001\271Mj\231\a\267\f\364\274\216\372\026\247\265\215\303\214\270\352\3069\321%\031\300\323\207\305,\300\373-v\2213\331\2369\367\236\325B\a5J\241Q\027\236\372\374\363;CP\253I\326\265\263\211-\224O\337(K4\b;\276\021\035\343\265O|O%\323\340"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_3936425443248651558"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useImperativeHandle, useRef } from \'react\';\\nimport { neonAudio } from \'../game/audio\';\\nimport {\\n  applyPiecePlacement,\\n  computePlacementPreview,\\n  createEmptyGrid,\\n  createShowcaseGrid,\\n  findAllValidPlacements,\\n  generateTray,\\n  getMaxTileOnGrid,\\n} from \'../game/engine\';\\nimport { getTilePalette } from \'../game/palette\';\\nimport {\\n  AmbientMote,\\n  CanvasLayout,\\n  CursorVisualState,\\n  DragVisualState,\\n  computeCanvasLayout,\\n  createAmbientMotes,\\n  getCellRect,\\n  hitTestTraySlot,\\n  renderNeonCanvas,\\n  screenToGridAnchor,\\n  screenToSingleCell,\\n} from \'../game/renderer\';\\nimport {\\n  BlockPiece,\\n  FloatingText,\\n  GRID_SIZE,\\n  GameStats,\\n  GameStatus,\\n  GridMatrix,\\n  LineBeam,\\n  MergeGhostTile,\\n  Particle,\\n  PlacementPreview,\\n  ShockwaveRing,\\n  TRAY_SIZE,\\n  TurnResolution,\\n} from \'../game/types\';\\n\\nexport interface NeonCanvasHandle {\\n  startNewGame: () => void;\\n  focusBoard: () => void;\\n}\\n\\ninterface NeonCanvasProps {\\n  status: GameStatus;\\n  bestScore: number;\\n  reducedMotion: boolean;\\n  onStatsChange: (stats: GameStats) => void;\\n  onComboEvent: (label: string) => void;\\n  onGameOver: (finalStats: GameStats) => void;\\n  onRequestPause: () => void;\\n  onRequestToggleMute: () => void;\\n  onRequestHudFocus: () => void;\\n}\\n\\ninterface SimState {\\n  grid: GridMatrix;\\n  tray: (BlockPiece | null)[];\\n  selectedSlot: number;\\n  stats: GameStats;\\n  preview: PlacementPreview | null;\\n  drag: DragVisualState | null;\\n  pointerDownPos: { x: number; y: number; slot: number; pointerType: string } | null;\\n  cursor: CursorVisualState;\\n  particles: Particle[];\\n  shockwaves: ShockwaveRing[];\\n  beams: LineBeam[];\\n  floatingTexts: FloatingText[];\\n  mergeGhosts: MergeGhostTile[];\\n  motes: AmbientMote[];\\n  shakeTimer: number;\\n  shakeIntensity: number;\\n  time: number;\\n}\\n\\nexport const NeonCanvas = React.forwardRef<NeonCanvasHandle, NeonCanvasProps>(\\n  (\\n    {\\n      status,\\n      bestScore,\\n      reducedMotion,\\n      onStatsChange,\\n      onComboEvent,\\n      onGameOver,\\n      onRequestPause,\\n      onRequestToggleMute,\\n      onRequestHudFocus,\\n    },\\n    ref\\n  ) => {\\n    const containerRef = useRef<HTMLDivElement>(null);\\n    const canvasRef = useRef<HTMLCanvasElement>(null);\\n    const layoutRef = useRef<CanvasLayout>(computeCanvasLayout(800, 600));\\n\\n    const statusRef = useRef(status);\\n    statusRef.current = status;\\n\\n    const bestScoreRef = useRef(bestScore);\\n    bestScoreRef.current = bestScore;\\n\\n    const reducedMotionRef = useRef(reducedMotion);\\n    reducedMotionRef.current = reducedMotion;\\n\\n    const simRef = useRef<SimState>({\\n      grid: createShowcaseGrid(),\\n      tray: [null, null, null],\\n      selectedSlot: -1,\\n      stats: {\\n        score: 0,\\n        bestScore,\\n        maxTile: 512,\\n        mergesCount: 0,\\n        linesCleared: 0,\\n        bestCombo: 0,\\n        turnsPlayed: 0,\\n        isNewBest: false,\\n      },\\n      preview: null,\\n      drag: null,\\n      pointerDownPos: null,\\n      cursor: {\\n        visible: false,\\n        zone: \'GRID\',\\n        gridRow: 2,\\n        gridCol: 2,\\n        traySlot: 0,\\n      },\\n      particles: [],\\n      shockwaves: [],\\n      beams: [],\\n      floatingTexts: [],\\n      mergeGhosts: [],\\n      motes: createAmbientMotes(26, 900, 600),\\n      shakeTimer: 0,\\n      shakeIntensity: 0,\\n      time: 0,\\n    });\\n\\n    const selectNextAvailableSlot = (tray: (BlockPiece | null)[], preferred = 0): number => {\\n      if (tray[preferred]) return preferred;\\n      for (let i = 0; i < TRAY_SIZE; i++) {\\n        if (tray[i]) return i;\\n      }\\n      return -1;\\n    };\\n\\n    const updateCursorPreview = () => {\\n      const sim = simRef.current;\\n      if (\\n        statusRef.current !== \'PLAYING\' ||\\n        !sim.cursor.visible ||\\n        sim.cursor.zone !== \'GRID\' ||\\n        sim.selectedSlot < 0\\n      ) {\\n        if (!sim.drag?.active) {\\n          sim.preview = null;\\n        }\\n        return;\\n      }\\n      const piece = sim.tray[sim.selectedSlot];\\n      if (!piece) {\\n        sim.preview = null;\\n        return;\\n      }\\n      const clampedR = Math.max(0, Math.min(GRID_SIZE - piece.height, sim.cursor.gridRow));\\n      const clampedC = Math.max(0, Math.min(GRID_SIZE - piece.width, sim.cursor.gridCol));\\n      sim.preview = computePlacementPreview(sim.grid, piece, clampedR, clampedC);\\n    };\\n\\n    const startNewGame = () => {\\n      const sim = simRef.current;\\n      const freshGrid = createEmptyGrid();\\n      const freshTray = generateTray(freshGrid);\\n\\n      sim.grid = freshGrid;\\n      sim.tray = freshTray;\\n      sim.selectedSlot = 0;\\n      sim.preview = null;\\n      sim.drag = null;\\n      sim.pointerDownPos = null;\\n      sim.particles = [];\\n      sim.shockwaves = [];\\n      sim.beams = [];\\n      sim.floatingTexts = [];\\n      sim.mergeGhosts = [];\\n      sim.shakeTimer = 0;\\n      sim.shakeIntensity = 0;\\n      sim.cursor = {\\n        visible: false,\\n        zone: \'GRID\',\\n        gridRow: 2,\\n        gridCol: 2,\\n        traySlot: 0,\\n      };\\n      sim.stats = {\\n        score: 0,\\n        bestScore: bestScoreRef.current,\\n        maxTile: 0,\\n        mergesCount: 0,\\n        linesCleared: 0,\\n        bestCombo: 0,\\n        turnsPlayed: 0,\\n        isNewBest: false,\\n      };\\n\\n      onStatsChange({ ...sim.stats });\\n      onComboEvent(\'\');\\n    };\\n\\n    useImperativeHandle(ref, () => ({\\n      startNewGame,\\n      focusBoard: () => {\\n        canvasRef.current?.focus();\\n        const sim = simRef.current;\\n        sim.cursor.visible = true;\\n        sim.cursor.zone = \'GRID\';\\n        updateCursorPreview();\\n      },\\n    }));\\n\\n    const spawnVfxForResolution = (res: TurnResolution) => {\\n      const sim = simRef.current;\\n      const layout = layoutRef.current;\\n      const rm = reducedMotionRef.current;\\n\\n      // Placement subtle sparks\\n      if (!rm) {\\n        for (const pt of res.placedCells) {\\n          const rect = getCellRect(layout, pt.r, pt.c);\\n          const cx = rect.x + rect.w / 2;\\n          const cy = rect.y + rect.h / 2;\\n          for (let i = 0; i < 4; i++) {\\n            const ang = (Math.PI * 2 * i) / 4 + Math.random() * 0.6;\\n            const spd = 40 + Math.random() * 70;\\n            sim.particles.push({\\n              x: cx,\\n              y: cy,\\n              vx: Math.cos(ang) * spd,\\n              vy: Math.sin(ang) * spd,\\n              size: 2 + Math.random() * 1.5,\\n              color: \'#38BDF8\',\\n              alpha: 0.9,\\n              life: 0.35,\\n              maxLife: 0.35,\\n            });\\n          }\\n        }\\n      }\\n\\n      // Merge VFX\\n      for (const merge of res.mergeSteps) {\\n        const targetRect = getCellRect(layout, merge.targetCell.r, merge.targetCell.c);\\n        const tx = targetRect.x + targetRect.w / 2;\\n        const ty = targetRect.y + targetRect.h / 2;\\n        const pal = getTilePalette(merge.newValue);\\n\\n        if (!rm) {\\n          for (const fc of merge.fromCells) {\\n            const fromRect = getCellRect(layout, fc.r, fc.c);\\n            sim.mergeGhosts.push({\\n              fromX: fromRect.x,\\n              fromY: fromRect.y,\\n              toX: targetRect.x,\\n              toY: targetRect.y,\\n              size: targetRect.w,\\n              value: merge.oldValue,\\n              progress: 0,\\n              duration: 0.14,\\n            });\\n          }\\n\\n          sim.shockwaves.push({\\n            x: tx,\\n            y: ty,\\n            radius: targetRect.w * 0.25,\\n            maxRadius: targetRect.w * (1.25 + merge.comboDepth * 0.2),\\n            color: pal.border,\\n            alpha: 0.9,\\n            life: 0.34,\\n            maxLife: 0.34,\\n            lineWidth: 3,\\n          });\\n\\n          const burstCount = Math.min(24, 10 + merge.comboDepth * 4);\\n          for (let i = 0; i < burstCount; i++) {\\n            const ang = Math.random() * Math.PI * 2;\\n            const spd = 70 + Math.random() * 170;\\n            sim.particles.push({\\n              x: tx,\\n              y: ty,\\n              vx: Math.cos(ang) * spd,\\n              vy: Math.sin(ang) * spd,\\n              size: 2.2 + Math.random() * 2.5,\\n              color: i % 2 === 0 ? pal.border : \'#E0F2FE\',\\n              alpha: 1,\\n              life: 0.45 + Math.random() * 0.2,\\n              maxLife: 0.65,\\n            });\\n          }\\n        }\\n\\n        sim.floatingTexts.push({\\n          x: tx,\\n          y: ty - 8,\\n          vy: -42,\\n          text: `+${merge.points}`,\\n          subtext: merge.comboDepth > 1 ? `CHAIN \303\227${merge.comboDepth}` : `MERGE ${merge.newValue}`,\\n          color: pal.border,\\n          life: 0.95,\\n          maxLife: 0.95,\\n          scale: merge.comboDepth > 1 ? 1.15 : 1,\\n        });\\n      }\\n\\n      // Line Clear VFX\\n      if (res.lineClearStep) {\\n        const { rows, cols, points } = res.lineClearStep;\\n        const { boardRect, cellSize } = layout;\\n\\n        for (const r of rows) {\\n          const first = getCellRect(layout, r, 0);\\n          sim.beams.push({\\n            x: boardRect.x + 6,\\n            y: first.y + cellSize * 0.18,\\n            w: boardRect.w - 12,\\n            h: cellSize * 0.64,\\n            color: \'rgba(34, 211, 238, 0.85)\',\\n            life: 0.36,\\n            maxLife: 0.36,\\n          });\\n        }\\n        for (const c of cols) {\\n          const first = getCellRect(layout, 0, c);\\n          sim.beams.push({\\n            x: first.x + cellSize * 0.18,\\n            y: boardRect.y + 6,\\n            w: cellSize * 0.64,\\n            h: boardRect.h - 12,\\n            color: \'rgba(192, 132, 252, 0.85)\',\\n            life: 0.36,\\n            maxLife: 0.36,\\n          });\\n        }\\n\\n        if (!rm) {\\n          for (const cell of res.lineClearStep.clearedCells) {\\n            const rect = getCellRect(layout, cell.r, cell.c);\\n            const cx = rect.x + rect.w / 2;\\n            const cy = rect.y + rect.h / 2;\\n            const pal = getTilePalette(cell.value);\\n            for (let i = 0; i < 6; i++) {\\n              const ang = Math.random() * Math.PI * 2;\\n              const spd = 80 + Math.random() * 180;\\n              sim.particles.push({\\n                x: cx,\\n                y: cy,\\n                vx: Math.cos(ang) * spd,\\n                vy: Math.sin(ang) * spd,\\n                size: 2.5 + Math.random() * 2,\\n                color: pal.border,\\n                alpha: 1,\\n                life: 0.5,\\n                maxLife: 0.5,\\n              });\\n            }\\n          }\\n        }\\n\\n        const totalLines = rows.length + cols.length;\\n        sim.floatingTexts.push({\\n          x: boardRect.x + boardRect.w / 2,\\n          y: boardRect.y + boardRect.h / 2,\\n          vy: -36,\\n          text: `+${points}`,\\n          subtext: totalLines > 1 ? `MEGA CLEAR \303\227${totalLines}` : \'LINE CLEAR\',\\n          color: \'#67E8F9\',\\n          life: 1.05,\\n          maxLife: 1.05,\\n          scale: 1.2,\\n        });\\n      }\\n\\n      // Micro camera shake on big combos or line clears\\n      if (!rm && (res.maxComboDepth >= 2 || res.lineClearStep)) {\\n        sim.shakeTimer = 0.2;\\n        sim.shakeIntensity = Math.min(9, 3 + res.maxComboDepth * 2 + (res.lineClearStep ? 2.5 : 0));\\n      }\\n    };\\n\\n    const executePlacement = (slotIndex: number, anchorRow: number, anchorCol: number): boolean => {\\n      const sim = simRef.current;\\n      const piece = sim.tray[slotIndex];\\n      if (!piece) return false;\\n\\n      const clampedR = Math.max(0, Math.min(GRID_SIZE - piece.height, anchorRow));\\n      const clampedC = Math.max(0, Math.min(GRID_SIZE - piece.width, anchorCol));\\n\\n      const res = applyPiecePlacement(sim.grid, sim.tray, slotIndex, clampedR, clampedC);\\n      if (!res) {\\n        neonAudio.playInvalid();\\n        return false;\\n      }\\n\\n      neonAudio.playPlace();\\n\\n      if (res.mergeSteps.length > 0) {\\n        const lastMerge = res.mergeSteps[res.mergeSteps.length - 1];\\n        setTimeout(() => {\\n          neonAudio.playMerge(res.maxComboDepth, lastMerge.newValue);\\n        }, 45);\\n      }\\n\\n      if (res.lineClearStep) {\\n        const totalLines = res.lineClearStep.rows.length + res.lineClearStep.cols.length;\\n        setTimeout(() => {\\n          neonAudio.playLineClear(totalLines);\\n        }, 70);\\n      }\\n\\n      if (res.refilledTray && !res.isGameOver) {\\n        setTimeout(() => {\\n          neonAudio.playNewTray();\\n        }, 140);\\n      }\\n\\n      spawnVfxForResolution(res);\\n\\n      // Update stats\\n      const prevBest = sim.stats.bestScore;\\n      const newScore = sim.stats.score + res.totalPointsGained;\\n      const newBestScore = Math.max(prevBest, newScore);\\n      const brokeRecord = newScore > prevBest && prevBest > 0;\\n\\n      if (brokeRecord && !sim.stats.isNewBest) {\\n        neonAudio.playNewBest();\\n      }\\n\\n      sim.stats = {\\n        score: newScore,\\n        bestScore: newBestScore,\\n        maxTile: Math.max(sim.stats.maxTile, getMaxTileOnGrid(sim.grid)),\\n        mergesCount: sim.stats.mergesCount + res.mergeSteps.length,\\n        linesCleared:\\n          sim.stats.linesCleared +\\n          (res.lineClearStep\\n            ? res.lineClearStep.rows.length + res.lineClearStep.cols.length\\n            : 0),\\n        bestCombo: Math.max(sim.stats.bestCombo, res.maxComboDepth),\\n        turnsPlayed: sim.stats.turnsPlayed + 1,\\n        isNewBest: sim.stats.isNewBest || newScore > prevBest,\\n      };\\n\\n      if (res.maxComboDepth >= 2) {\\n        onComboEvent(`CHAIN \303\227${res.maxComboDepth}`);\\n      } else if (res.lineClearStep) {\\n        const lines = res.lineClearStep.rows.length + res.lineClearStep.cols.length;\\n        onComboEvent(lines > 1 ? `MULTI CLEAR \303\227${lines}` : \'LINE CLEAR\');\\n      } else if (res.mergeSteps.length > 0) {\\n        const topVal = Math.max(...res.mergeSteps.map((m) => m.newValue));\\n        onComboEvent(`MERGED ${topVal}`);\\n      }\\n\\n      sim.selectedSlot = selectNextAvailableSlot(sim.tray, slotIndex);\\n      if (sim.selectedSlot >= 0) {\\n        sim.cursor.traySlot = sim.selectedSlot;\\n      }\\n      sim.preview = null;\\n      updateCursorPreview();\\n\\n      onStatsChange({ ...sim.stats });\\n\\n      if (res.isGameOver) {\\n        setTimeout(() => {\\n          neonAudio.playGameOver();\\n          onGameOver({ ...sim.stats });\\n        }, 380);\\n      }\\n\\n      return true;\\n    };\\n\\n    // Canvas resize & 60fps animation loop\\n    useEffect(() => {\\n      const container = containerRef.current;\\n      const canvas = canvasRef.current;\\n      if (!container || !canvas) return;\\n\\n      const updateSize = () => {\\n        const rect = container.getBoundingClientRect();\\n        const dpr = Math.min(window.devicePixelRatio || 1, 2);\\n        const w = Math.max(320, Math.floor(rect.width));\\n        const h = Math.max(260, Math.floor(rect.height));\\n\\n        canvas.width = Math.floor(w * dpr);\\n        canvas.height = Math.floor(h * dpr);\\n        canvas.style.width = `${w}px`;\\n        canvas.style.height = `${h}px`;\\n\\n        const ctx = canvas.getContext(\'2d\');\\n        if (ctx) {\\n          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\\n        }\\n\\n        layoutRef.current = computeCanvasLayout(w, h);\\n        if (simRef.current.motes.length === 0) {\\n          simRef.current.motes = createAmbientMotes(26, w, h);\\n        }\\n      };\\n\\n      updateSize();\\n      const ro = new ResizeObserver(updateSize);\\n      ro.observe(container);\\n\\n      let rafId = 0;\\n      let lastTime = performance.now();\\n\\n      const tick = (now: number) => {\\n        const rawDt = (now - lastTime) / 1000;\\n        lastTime = now;\\n        const dt = Math.min(rawDt, 0.05);\\n\\n        const sim = simRef.current;\\n        const layout = layoutRef.current;\\n        sim.time += dt;\\n\\n        // Ambient motes drift\\n        if (!reducedMotionRef.current) {\\n          for (const mote of sim.motes) {\\n            mote.x += mote.vx * dt;\\n            mote.y += mote.vy * dt;\\n            if (mote.y < -10) {\\n              mote.y = layout.height + 10;\\n              mote.x = Math.random() * layout.width;\\n            }\\n            if (mote.x < -10) mote.x = layout.width + 10;\\n            if (mote.x > layout.width + 10) mote.x = -10;\\n          }\\n        }\\n\\n        // Tile spring scale & flash decay\\n        const springLerp = 1 - Math.exp(-18 * dt);\\n        const flashDecay = 1 - Math.exp(-10 * dt);\\n        for (let r = 0; r < GRID_SIZE; r++) {\\n          for (let c = 0; c < GRID_SIZE; c++) {\\n            const tile = sim.grid[r][c];\\n            if (!tile) continue;\\n            tile.scale += (tile.targetScale - tile.scale) * springLerp;\\n            if (Math.abs(tile.scale - tile.targetScale) < 0.002) {\\n              tile.scale = tile.targetScale;\\n            }\\n            tile.flash *= 1 - flashDecay;\\n            if (tile.flash < 0.01) tile.flash = 0;\\n          }\\n        }\\n\\n        // Merge Ghosts\\n        for (let i = sim.mergeGhosts.length - 1; i >= 0; i--) {\\n          const g = sim.mergeGhosts[i];\\n          g.progress += dt;\\n          if (g.progress >= g.duration) {\\n            sim.mergeGhosts.splice(i, 1);\\n          }\\n        }\\n\\n        // Particles\\n        for (let i = sim.particles.length - 1; i >= 0; i--) {\\n          const p = sim.particles[i];\\n          p.life -= dt;\\n          if (p.life <= 0) {\\n            sim.particles.splice(i, 1);\\n            continue;\\n          }\\n          p.x += p.vx * dt;\\n          p.y += p.vy * dt;\\n          p.vx *= 0.94;\\n          p.vy *= 0.94;\\n          p.alpha = p.life / p.maxLife;\\n        }\\n\\n        // Shockwaves\\n        for (let i = sim.shockwaves.length - 1; i >= 0; i--) {\\n          const s = sim.shockwaves[i];\\n          s.life -= dt;\\n          if (s.life <= 0) {\\n            sim.shockwaves.splice(i, 1);\\n            continue;\\n          }\\n          const t = 1 - s.life / s.maxLife;\\n          s.radius = s.maxRadius * (0.25 + 0.75 * (1 - Math.pow(1 - t, 2)));\\n          s.alpha = s.life / s.maxLife;\\n        }\\n\\n        // Beams\\n        for (let i = sim.beams.length - 1; i >= 0; i--) {\\n          sim.beams[i].life -= dt;\\n          if (sim.beams[i].life <= 0) {\\n            sim.beams.splice(i, 1);\\n          }\\n        }\\n\\n        // Floating Texts\\n        for (let i = sim.floatingTexts.length - 1; i >= 0; i--) {\\n          const ft = sim.floatingTexts[i];\\n          ft.life -= dt;\\n          if (ft.life <= 0) {\\n            sim.floatingTexts.splice(i, 1);\\n            continue;\\n          }\\n          ft.y += ft.vy * dt;\\n          ft.vy *= 0.95;\\n        }\\n\\n        // Shake\\n        let shakeX = 0;\\n        let shakeY = 0;\\n        if (sim.shakeTimer > 0) {\\n          sim.shakeTimer = Math.max(0, sim.shakeTimer - dt);\\n          const mag = sim.shakeIntensity * (sim.shakeTimer / 0.2);\\n          shakeX = (Math.random() - 0.5) * 2 * mag;\\n          shakeY = (Math.random() - 0.5) * 2 * mag;\\n        }\\n\\n        const ctx = canvas.getContext(\'2d\');\\n        if (ctx) {\\n          renderNeonCanvas(ctx, layout, {\\n            time: sim.time,\\n            grid: sim.grid,\\n            tray: sim.tray,\\n            selectedSlot: statusRef.current === \'PLAYING\' ? sim.selectedSlot : -1,\\n            preview: statusRef.current === \'PLAYING\' ? sim.preview : null,\\n            drag: statusRef.current === \'PLAYING\' ? sim.drag : null,\\n            cursor:\\n              statusRef.current === \'PLAYING\'\\n                ? sim.cursor\\n                : { ...sim.cursor, visible: false },\\n            particles: sim.particles,\\n            shockwaves: sim.shockwaves,\\n            beams: sim.beams,\\n            floatingTexts: sim.floatingTexts,\\n            mergeGhosts: sim.mergeGhosts,\\n            motes: sim.motes,\\n            shakeX,\\n            shakeY,\\n            isDimmed: statusRef.current !== \'PLAYING\',\\n          });\\n        }\\n\\n        rafId = requestAnimationFrame(tick);\\n      };\\n\\n      rafId = requestAnimationFrame(tick);\\n\\n      return () => {\\n        cancelAnimationFrame(rafId);\\n        ro.disconnect();\\n      };\\n    }, []);\\n\\n    // Pointer Events (Touch Drag, Mouse Drag, & Tap-to-Place)\\n    const getCanvasCoords = (e: React.PointerEvent<HTMLCanvasElement>) => {\\n      const canvas = canvasRef.current!;\\n      const rect = canvas.getBoundingClientRect();\\n      return {\\n        x: e.clientX - rect.left,\\n        y: e.clientY - rect.top,\\n      };\\n    };\\n\\n    const handlePointerDown = (e: React.PointerEvent<HTMLCanvasElement>) => {\\n      if (statusRef.current !== \'PLAYING\') return;\\n      neonAudio.unlock();\\n      canvasRef.current?.focus();\\n\\n      const sim = simRef.current;\\n      sim.cursor.visible = false;\\n      const { x, y } = getCanvasCoords(e);\\n      const layout = layoutRef.current;\\n\\n      const slotIdx = hitTestTraySlot(layout, x, y);\\n      if (slotIdx >= 0 && sim.tray[slotIdx]) {\\n        const piece = sim.tray[slotIdx]!;\\n        const liftY = e.pointerType === \'touch\' ? 52 : 0;\\n        sim.selectedSlot = slotIdx;\\n        sim.cursor.traySlot = slotIdx;\\n        sim.pointerDownPos = { x, y, slot: slotIdx, pointerType: e.pointerType };\\n        sim.drag = {\\n          active: true,\\n          slotIndex: slotIdx,\\n          piece,\\n          pointerX: x,\\n          pointerY: y,\\n          liftY,\\n        };\\n        neonAudio.playSelect();\\n        e.currentTarget.setPointerCapture(e.pointerId);\\n        return;\\n      }\\n\\n      // Direct tap/click on Grid when a tray piece is selected\\n      if (sim.selectedSlot >= 0 && sim.tray[sim.selectedSlot]) {\\n        const piece = sim.tray[sim.selectedSlot]!;\\n        const anchor = screenToGridAnchor(layout, x, y, piece);\\n        if (anchor) {\\n          executePlacement(sim.selectedSlot, anchor.r, anchor.c);\\n        }\\n      }\\n    };\\n\\n    const handlePointerMove = (e: React.PointerEvent<HTMLCanvasElement>) => {\\n      if (statusRef.current !== \'PLAYING\') return;\\n      const sim = simRef.current;\\n      const layout = layoutRef.current;\\n      const { x, y } = getCanvasCoords(e);\\n\\n      if (sim.drag?.active) {\\n        sim.drag.pointerX = x;\\n        sim.drag.pointerY = y;\\n        const anchor = screenToGridAnchor(\\n          layout,\\n          x,\\n          y - sim.drag.liftY,\\n          sim.drag.piece\\n        );\\n        if (anchor) {\\n          sim.preview = computePlacementPreview(\\n            sim.grid,\\n            sim.drag.piece,\\n            anchor.r,\\n            anchor.c\\n          );\\n        } else {\\n          sim.preview = null;\\n        }\\n        return;\\n      }\\n\\n      // Mouse hover preview over grid\\n      if (e.pointerType === \'mouse\' && sim.selectedSlot >= 0) {\\n        const piece = sim.tray[sim.selectedSlot];\\n        if (!piece) {\\n          sim.preview = null;\\n          return;\\n        }\\n        const cell = screenToSingleCell(layout, x, y);\\n        if (cell) {\\n          const anchor = screenToGridAnchor(layout, x, y, piece);\\n          if (anchor) {\\n            sim.preview = computePlacementPreview(sim.grid, piece, anchor.r, anchor.c);\\n          } else {\\n            sim.preview = null;\\n          }\\n        } else if (!sim.cursor.visible) {\\n          sim.preview = null;\\n        }\\n      }\\n    };\\n\\n    const handlePointerUp = (e: React.PointerEvent<HTMLCanvasElement>) => {\\n      const sim = simRef.current;\\n      if (!sim.drag?.active) return;\\n\\n      const { x, y } = getCanvasCoords(e);\\n      const layout = layoutRef.current;\\n      const down = sim.pointerDownPos;\\n      const dist = down ? Math.hypot(x - down.x, y - down.y) : 999;\\n\\n      const dragState = sim.drag;\\n      sim.drag = null;\\n      sim.pointerDownPos = null;\\n\\n      if (dist < 12) {\\n        // Clean tap on a tray slot -> keep it selected for tap-to-place\\n        sim.selectedSlot = dragState.slotIndex;\\n        sim.preview = null;\\n        return;\\n      }\\n\\n      const anchor = screenToGridAnchor(\\n        layout,\\n        x,\\n        y - dragState.liftY,\\n        dragState.piece\\n      );\\n\\n      if (anchor) {\\n        executePlacement(dragState.slotIndex, anchor.r, anchor.c);\\n      } else {\\n        sim.preview = null;\\n      }\\n    };\\n\\n    const handlePointerCancel = () => {\\n      const sim = simRef.current;\\n      sim.drag = null;\\n      sim.pointerDownPos = null;\\n      sim.preview = null;\\n    };\\n\\n    // Keyboard & Amazon Fire TV D-Pad Support\\n    const handleCanvasKeyDown = (e: React.KeyboardEvent<HTMLCanvasElement>) => {\\n      if (statusRef.current !== \'PLAYING\') return;\\n      neonAudio.unlock();\\n\\n      const sim = simRef.current;\\n      const layout = layoutRef.current;\\n      const key = e.key;\\n\\n      // Global in-play shortcuts\\n      if (key === \'Escape\' || key === \'p\' || key === \'P\' || key === \'GoBack\' || key === \'MediaPlayPause\') {\\n        e.preventDefault();\\n        onRequestPause();\\n        return;\\n      }\\n      if (key === \'m\' || key === \'M\') {\\n        e.preventDefault();\\n        onRequestToggleMute();\\n        return;\\n      }\\n      if (key === \'1\' || key === \'2\' || key === \'3\') {\\n        e.preventDefault();\\n        const idx = parseInt(key, 10) - 1;\\n        if (sim.tray[idx]) {\\n          sim.selectedSlot = idx;\\n          sim.cursor.visible = true;\\n          sim.cursor.traySlot = idx;\\n          neonAudio.playSelect();\\n          updateCursorPreview();\\n        }\\n        return;\\n      }\\n      if (key === \'Tab\') {\\n        e.preventDefault();\\n        for (let offset = 1; offset <= TRAY_SIZE; offset++) {\\n          const next = (Math.max(0, sim.selectedSlot) + offset) % TRAY_SIZE;\\n          if (sim.tray[next]) {\\n            sim.selectedSlot = next;\\n            sim.cursor.visible = true;\\n            sim.cursor.traySlot = next;\\n            neonAudio.playSelect();\\n            updateCursorPreview();\\n            break;\\n          }\\n        }\\n        return;\\n      }\\n\\n      const isUp = key === \'ArrowUp\' || key === \'w\' || key === \'W\';\\n      const isDown = key === \'ArrowDown\' || key === \'s\' || key === \'S\';\\n      const isLeft = key === \'ArrowLeft\' || key === \'a\' || key === \'A\';\\n      const isRight = key === \'ArrowRight\' || key === \'d\' || key === \'D\';\\n      const isConfirm = key === \'Enter\' || key === \' \' || key === \'Select\' || key === \'DPadCenter\';\\n\\n      if (isUp || isDown || isLeft || isRight) {\\n        e.preventDefault();\\n        sim.cursor.visible = true;\\n\\n        if (sim.cursor.zone === \'GRID\') {\\n          const activePiece =\\n            sim.selectedSlot >= 0 ? sim.tray[sim.selectedSlot] : null;\\n          const maxRow = activePiece ? GRID_SIZE - activePiece.height : GRID_SIZE - 1;\\n          const maxCol = activePiece ? GRID_SIZE - activePiece.width : GRID_SIZE - 1;\\n\\n          if (isUp) {\\n            if (sim.cursor.gridRow > 0) {\\n              sim.cursor.gridRow--;\\n              neonAudio.playMove();\\n            } else {\\n              // Top row -> allow D-pad to reach HUD controls\\n              sim.cursor.visible = false;\\n              sim.preview = null;\\n              onRequestHudFocus();\\n              return;\\n            }\\n          } else if (isDown) {\\n            if (sim.cursor.gridRow < maxRow) {\\n              sim.cursor.gridRow++;\\n              neonAudio.playMove();\\n            } else if (!layout.isLandscape) {\\n              // Portrait: jump down into Tray\\n              sim.cursor.zone = \'TRAY\';\\n              sim.cursor.traySlot = selectNextAvailableSlot(\\n                sim.tray,\\n                Math.max(0, sim.selectedSlot)\\n              );\\n              neonAudio.playMove();\\n            }\\n          } else if (isLeft) {\\n            if (sim.cursor.gridCol > 0) {\\n              sim.cursor.gridCol--;\\n              neonAudio.playMove();\\n            }\\n          } else if (isRight) {\\n            if (sim.cursor.gridCol < maxCol) {\\n              sim.cursor.gridCol++;\\n              neonAudio.playMove();\\n            } else if (layout.isLandscape) {\\n              // Landscape: jump right into Tray\\n              sim.cursor.zone = \'TRAY\';\\n              sim.cursor.traySlot = selectNextAvailableSlot(\\n                sim.tray,\\n                Math.max(0, sim.selectedSlot)\\n              );\\n              neonAudio.playMove();\\n            }\\n          }\\n        } else {\\n          // Focus inside TRAY\\n          if (layout.isLandscape) {\\n            if (isUp) {\\n              sim.cursor.traySlot = (sim.cursor.traySlot + TRAY_SIZE - 1) % TRAY_SIZE;\\n              neonAudio.playMove();\\n            } else if (isDown) {\\n              sim.cursor.traySlot = (sim.cursor.traySlot + 1) % TRAY_SIZE;\\n              neonAudio.playMove();\\n            } else if (isLeft) {\\n              sim.cursor.zone = \'GRID\';\\n              neonAudio.playMove();\\n            }\\n          } else {\\n            if (isLeft) {\\n              sim.cursor.traySlot = (sim.cursor.traySlot + TRAY_SIZE - 1) % TRAY_SIZE;\\n              neonAudio.playMove();\\n            } else if (isRight) {\\n              sim.cursor.traySlot = (sim.cursor.traySlot + 1) % TRAY_SIZE;\\n              neonAudio.playMove();\\n            } else if (isUp) {\\n              sim.cursor.zone = \'GRID\';\\n              neonAudio.playMove();\\n            }\\n          }\\n        }\\n\\n        updateCursorPreview();\\n        return;\\n      }\\n\\n      if (isConfirm) {\\n        e.preventDefault();\\n        sim.cursor.visible = true;\\n\\n        if (sim.cursor.zone === \'TRAY\') {\\n          const slot = sim.cursor.traySlot;\\n          if (sim.tray[slot]) {\\n            sim.selectedSlot = slot;\\n            sim.cursor.zone = \'GRID\';\\n            const piece = sim.tray[slot]!;\\n            // Keep cursor in bounds for new piece; if invalid, snap to nearest valid\\n            sim.cursor.gridRow = Math.min(sim.cursor.gridRow, GRID_SIZE - piece.height);\\n            sim.cursor.gridCol = Math.min(sim.cursor.gridCol, GRID_SIZE - piece.width);\\n            const valids = findAllValidPlacements(sim.grid, piece);\\n            if (\\n              valids.length > 0 &&\\n              !valids.some(\\n                (v) => v.r === sim.cursor.gridRow && v.c === sim.cursor.gridCol\\n              )\\n            ) {\\n              sim.cursor.gridRow = valids[0].r;\\n              sim.cursor.gridCol = valids[0].c;\\n            }\\n            neonAudio.playSelect();\\n            updateCursorPreview();\\n          } else {\\n            neonAudio.playInvalid();\\n          }\\n          return;\\n        }\\n\\n        // Confirm placement on GRID\\n        if (sim.selectedSlot >= 0 && sim.tray[sim.selectedSlot]) {\\n          const placed = executePlacement(\\n            sim.selectedSlot,\\n            sim.cursor.gridRow,\\n            sim.cursor.gridCol\\n          );\\n          if (placed && sim.selectedSlot >= 0) {\\n            const nextPiece = sim.tray[sim.selectedSlot];\\n            if (nextPiece) {\\n              sim.cursor.gridRow = Math.min(sim.cursor.gridRow, GRID_SIZE - nextPiece.height);\\n              sim.cursor.gridCol = Math.min(sim.cursor.gridCol, GRID_SIZE - nextPiece.width);\\n            }\\n            updateCursorPreview();\\n          }\\n        }\\n      }\\n    };\\n\\n    // Clear drag state on window blur\\n    useEffect(() => {\\n      const onBlur = () => {\\n        const sim = simRef.current;\\n        sim.drag = null;\\n        sim.pointerDownPos = null;\\n      };\\n      window.addEventListener(\'blur\', onBlur);\\n      return () => window.removeEventListener(\'blur\', onBlur);\\n    }, []);\\n\\n    return (\\n      <div\\n        ref={containerRef}\\n        className=\\\"relative flex-1 w-full h-full min-w-0 min-h-0 overflow-hidden\\\"\\n      >\\n        <canvas\\n          ref={canvasRef}\\n          tabIndex={0}\\n          aria-label=\\\"Neon Block 6 by 6 puzzle board and piece tray\\\"\\n          onPointerDown={handlePointerDown}\\n          onPointerMove={handlePointerMove}\\n          onPointerUp={handlePointerUp}\\n          onPointerCancel={handlePointerCancel}\\n          onKeyDown={handleCanvasKeyDown}\\n          className=\\\"block w-full h-full touch-none outline-none focus-visible:ring-2 focus-visible:ring-cyan-400/60 focus-visible:ring-inset cursor-pointer\\\"\\n        />\\n      </div>\\n    );\\n  }\\n);\\n\\nNeonCanvas.displayName = \'NeonCanvas\';\\n\",\"Description\":\"Build isolated 60fps NeonCanvas game stage supporting HiDPI resizing, touch drag with finger lift, mouse drag/tap, keyboard arrows/Enter/Space, and Fire TV D-pad navigation\",\"Overwrite\":true,\"TargetFile\":\"/src/components/NeonCanvas.tsx\",\"toolAction\":\"Creating NeonCanvas stage\",\"toolSummary\":\"Create NeonCanvas stage\"}"
      original_name: "write_to_file"
    }
