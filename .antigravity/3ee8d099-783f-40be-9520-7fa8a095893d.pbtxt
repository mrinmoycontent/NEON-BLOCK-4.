      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Upgrade renderer.ts with multi-shape particles, additive glow sparks, twinkling background motes, and firework rockets\",\"Instruction\":\"Add FireworkRocket, twinkling motes, and multi-shape particle rendering to renderer.ts\",\"ReplacementChunks\":[{\"AllowMultiple\":false,\"EndLine\":15,\"ReplacementContent\":\"import {\\n  BlockPiece,\\n  FireworkRocket,\\n  FloatingText,\\n  FocusZone,\\n  GRID_SIZE,\\n  GridMatrix,\\n  LineBeam,\\n  MergeGhostTile,\\n  Particle,\\n  PlacementPreview,\\n  ShockwaveRing,\\n  TRAY_SIZE,\\n} from \'./types\';\",\"StartLine\":2,\"TargetContent\":\"import {\\n  BlockPiece,\\n  FloatingText,\\n  FocusZone,\\n  GRID_SIZE,\\n  GridMatrix,\\n  LineBeam,\\n  MergeGhostTile,\\n  Particle,\\n  PlacementPreview,\\n  ShockwaveRing,\\n  TRAY_SIZE,\\n} from \'./types\';\"},{\"AllowMultiple\":false,\"EndLine\":43,\"ReplacementContent\":\"export interface AmbientMote {\\n  x: number;\\n  y: number;\\n  r: number;\\n  vx: number;\\n  vy: number;\\n  alpha: number;\\n  color: string;\\n  phase: number;\\n  twinkleSpeed: number;\\n}\",\"StartLine\":34,\"TargetContent\":\"export interface AmbientMote {\\n  x: number;\\n  y: number;\\n  r: number;\\n  vx: number;\\n  vy: number;\\n  alpha: number;\\n  color: string;\\n}\"},{\"AllowMultiple\":false,\"EndLine\":78,\"ReplacementContent\":\"  particles: Particle[];\\n  fireworks: FireworkRocket[];\\n  shockwaves: ShockwaveRing[];\\n  beams: LineBeam[];\\n  floatingTexts: FloatingText[];\\n  mergeGhosts: MergeGhostTile[];\\n  motes: AmbientMote[];\\n  shakeX: number;\\n  shakeY: number;\\n  isDimmed: boolean;\\n}\",\"StartLine\":69,\"TargetContent\":\"  particles: Particle[];\\n  shockwaves: ShockwaveRing[];\\n  beams: LineBeam[];\\n  floatingTexts: FloatingText[];\\n  mergeGhosts: MergeGhostTile[];\\n  motes: AmbientMote[];\\n  shakeX: number;\\n  shakeY: number;\\n  isDimmed: boolean;\\n}\"},{\"AllowMultiple\":false,\"EndLine\":472,\"ReplacementContent\":\"export function createAmbientMotes(count: number, width: number, height: number): AmbientMote[] {\\n  const colors = [\'#22D3EE\', \'#3B82F6\', \'#A855F7\', \'#818CF8\', \'#67E8F9\'];\\n  const motes: AmbientMote[] = [];\\n  for (let i = 0; i < count; i++) {\\n    motes.push({\\n      x: Math.random() * width,\\n      y: Math.random() * height,\\n      r: 1 + Math.random() * 2.1,\\n      vx: (Math.random() - 0.5) * 14,\\n      vy: -8 - Math.random() * 20,\\n      alpha: 0.16 + Math.random() * 0.34,\\n      color: colors[i % colors.length],\\n      phase: Math.random() * Math.PI * 2,\\n      twinkleSpeed: 1.5 + Math.random() * 2.5,\\n    });\\n  }\\n  return motes;\\n}\\n\\nexport function renderNeonCanvas(\\n  ctx: CanvasRenderingContext2D,\\n  layout: CanvasLayout,\\n  state: RenderFrameState\\n): void {\\n  const { width, height, boardRect, cellSize, cellGap, traySlots } = layout;\\n\\n  ctx.save();\\n  ctx.clearRect(0, 0, width, height);\\n\\n  // Subtle deep obsidian radial backdrop\\n  const bgGrad = ctx.createRadialGradient(\\n    width * 0.45,\\n    height * 0.42,\\n    Math.min(width, height) * 0.08,\\n    width * 0.5,\\n    height * 0.5,\\n    Math.max(width, height) * 0.8\\n  );\\n  bgGrad.addColorStop(0, \'#0B122B\');\\n  bgGrad.addColorStop(0.55, \'#070B1A\');\\n  bgGrad.addColorStop(1, \'#04060F\');\\n  ctx.fillStyle = bgGrad;\\n  ctx.fillRect(0, 0, width, height);\\n\\n  // Ambient floating background particles with gentle twinkle\\n  for (const mote of state.motes) {\\n    const twinkle = 0.65 + 0.35 * Math.sin(state.time * mote.twinkleSpeed + mote.phase);\\n    ctx.save();\\n    ctx.globalAlpha = mote.alpha * twinkle;\\n    ctx.fillStyle = mote.color;\\n    ctx.beginPath();\\n    ctx.arc(mote.x, mote.y, mote.r, 0, Math.PI * 2);\\n    ctx.fill();\\n    ctx.restore();\\n  }\",\"StartLine\":420,\"TargetContent\":\"export function createAmbientMotes(count: number, width: number, height: number): AmbientMote[] {\\n  const colors = [\'#22D3EE\', \'#3B82F6\', \'#A855F7\', \'#818CF8\'];\\n  const motes: AmbientMote[] = [];\\n  for (let i = 0; i < count; i++) {\\n    motes.push({\\n      x: Math.random() * width,\\n      y: Math.random() * height,\\n      r: 1 + Math.random() * 1.8,\\n      vx: (Math.random() - 0.5) * 14,\\n      vy: -8 - Math.random() * 18,\\n      alpha: 0.14 + Math.random() * 0.32,\\n      color: colors[i % colors.length],\\n    });\\n  }\\n  return motes;\\n}\\n\\nexport function renderNeonCanvas(\\n  ctx: CanvasRenderingContext2D,\\n  layout: CanvasLayout,\\n  state: RenderFrameState\\n): void {\\n  const { width, height, boardRect, cellSize, cellGap, traySlots } = layout;\\n\\n  ctx.save();\\n  ctx.clearRect(0, 0, width, height);\\n\\n  // Subtle deep obsidian radial backdrop\\n  const bgGrad = ctx.createRadialGradient(\\n    width * 0.45,\\n    height * 0.42,\\n    Math.min(width, height) * 0.08,\\n    width * 0.5,\\n    height * 0.5,\\n    Math.max(width, height) * 0.8\\n  );\\n  bgGrad.addColorStop(0, \'#0B122B\');\\n  bgGrad.addColorStop(0.55, \'#070B1A\');\\n  bgGrad.addColorStop(1, \'#04060F\');\\n  ctx.fillStyle = bgGrad;\\n  ctx.fillRect(0, 0, width, height);\\n\\n  // Ambient subtle background dust motes\\n  for (const mote of state.motes) {\\n    ctx.save();\\n    ctx.globalAlpha = mote.alpha;\\n    ctx.fillStyle = mote.color;\\n    ctx.beginPath();\\n    ctx.arc(mote.x, mote.y, mote.r, 0, Math.PI * 2);\\n    ctx.fill();\\n    ctx.restore();\\n  }\"},{\"AllowMultiple\":false,\"EndLine\":656,\"ReplacementContent\":\"  // Shockwave Rings\\n  for (const ring of state.shockwaves) {\\n    ctx.save();\\n    ctx.globalCompositeOperation = \'lighter\';\\n    ctx.globalAlpha = Math.max(0, ring.alpha);\\n    ctx.strokeStyle = ring.color;\\n    ctx.lineWidth = ring.lineWidth;\\n    ctx.shadowColor = ring.color;\\n    ctx.shadowBlur = 14;\\n    ctx.beginPath();\\n    ctx.arc(ring.x, ring.y, ring.radius, 0, Math.PI * 2);\\n    ctx.stroke();\\n    ctx.restore();\\n  }\\n\\n  // Rising Firework Rockets\\n  for (const fw of state.fireworks) {\\n    ctx.save();\\n    ctx.globalCompositeOperation = \'lighter\';\\n    ctx.fillStyle = \'#FFFFFF\';\\n    ctx.shadowColor = fw.color;\\n    ctx.shadowBlur = 16;\\n    ctx.beginPath();\\n    ctx.arc(fw.x, fw.y, 3.2, 0, Math.PI * 2);\\n    ctx.fill();\\n    ctx.restore();\\n  }\\n\\n  // Advanced Multi-Shape Particles (circle, spark streak, diamond shard)\\n  if (state.particles.length > 0) {\\n    ctx.save();\\n    ctx.globalCompositeOperation = \'lighter\';\\n    for (const p of state.particles) {\\n      const a = Math.max(0, p.alpha);\\n      if (a <= 0.01) continue;\\n      ctx.globalAlpha = a;\\n      ctx.fillStyle = p.color;\\n\\n      if (p.shape === \'spark\') {\\n        const angle = Math.atan2(p.vy, p.vx);\\n        const speed = Math.hypot(p.vx, p.vy);\\n        const len = Math.max(p.size * 2.2, Math.min(18, speed * 0.048));\\n        ctx.save();\\n        ctx.translate(p.x, p.y);\\n        ctx.rotate(angle);\\n        ctx.beginPath();\\n        ctx.ellipse(0, 0, len, p.size * 0.55, 0, 0, Math.PI * 2);\\n        ctx.fill();\\n        ctx.restore();\\n      } else if (p.shape === \'diamond\') {\\n        const s = p.size * 1.45;\\n        ctx.beginPath();\\n        ctx.moveTo(p.x, p.y - s);\\n        ctx.lineTo(p.x + s * 0.72, p.y);\\n        ctx.lineTo(p.x, p.y + s);\\n        ctx.lineTo(p.x - s * 0.72, p.y);\\n        ctx.closePath();\\n        ctx.fill();\\n      } else {\\n        ctx.beginPath();\\n        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\\n        ctx.fill();\\n      }\\n    }\\n    ctx.restore();\\n  }\",\"StartLine\":630,\"TargetContent\":\"  // Shockwave Rings\\n  for (const ring of state.shockwaves) {\\n    ctx.save();\\n    ctx.globalAlpha = Math.max(0, ring.alpha);\\n    ctx.strokeStyle = ring.color;\\n    ctx.lineWidth = ring.lineWidth;\\n    ctx.shadowColor = ring.color;\\n    ctx.shadowBlur = 12;\\n    ctx.beginPath();\\n    ctx.arc(ring.x, ring.y, ring.radius, 0, Math.PI * 2);\\n    ctx.stroke();\\n    ctx.restore();\\n  }\\n\\n  // Particles\\n  for (const p of state.particles) {\\n    ctx.save();\\n    ctx.globalAlpha = Math.max(0, p.alpha);\\n    ctx.fillStyle = p.color;\\n    ctx.shadowColor = p.color;\\n    ctx.shadowBlur = 8;\\n    ctx.beginPath();\\n    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\\n    ctx.fill();\\n    ctx.restore();\\n  }\"}],\"TargetFile\":\"/src/game/renderer.ts\",\"toolAction\":\"Upgrading particle & firework renderer\",\"toolSummary\":\"Upgrade particle & firework renderer\"}"
