        replacement_content: "import React, { useEffect, useMemo, useRef, useState } from \'react\';\nimport {\n  ArrowLeft,\n  Award,\n  Check,\n  CheckCircle2,\n  Flame,\n  Gift,\n  History,\n  Lock,\n  Palette,\n  Sparkles,\n  Trash2,\n  Trophy,\n  Zap,\n} from \'lucide-react\';\nimport {\n  buildSevenDayStreakHistory,\n  formatReadableDate,\n  getEffectiveStreak,\n} from \'../game/daily\';"
