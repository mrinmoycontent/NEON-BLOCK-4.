            lines {
              text: "    x > layout.boardRect.x + layout.boardRect.w ||"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    y < layout.boardRect.y ||"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    y > layout.boardRect.y + layout.boardRect.h"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
