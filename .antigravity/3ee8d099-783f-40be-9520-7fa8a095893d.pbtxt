            }
            lines {
              text: "        const springLerp = 1 - Math.exp(-18 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const flashDecay = 1 - Math.exp(-10 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for (let r = 0; r < GRID_SIZE; r++) {"
