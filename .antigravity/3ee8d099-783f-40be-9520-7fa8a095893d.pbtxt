          replacement_content: "import { getTilePalette } from \'./palette\';\nimport { getThemeDefinition } from \'./themes\';\nimport {\n  BlockPiece,\n  FireworkRocket,\n  FloatingText,\n  FocusZone,\n  GRID_SIZE,\n  GridMatrix,\n  LineBeam,\n  MergeGhostTile,\n  Particle,\n  PlacementPreview,\n  ShockwaveRing,\n  TRAY_SIZE,\n  ThemeId,\n} from \'./types\';"
          start_line: 1
          end_line: 18
        }
        replacement_chunks {
          target_content: "  shakeX: number;\n  shakeY: number;\n  isDimmed: boolean;\n}"
          replacement_content: "  shakeX: number;\n  shakeY: number;\n  isDimmed: boolean;\n  themeId: ThemeId;\n}"
          start_line: 75
          end_line: 84
        }
        replacement_chunks {
          target_content: "export function drawNeonTile(\n  ctx: CanvasRenderingContext2D,\n  x: number,\n  y: number,\n  size: number,\n  value: number,\n  opts?: {\n    alpha?: number;\n    scale?: number;\n    flash?: number;\n    mergeHighlight?: boolean;\n    glowBoost?: number;\n  }\n): void {\n  const alpha = opts?.alpha ?? 1;\n  const scale = opts?.scale ?? 1;\n  const flash = opts?.flash ?? 0;\n  const mergeHighlight = opts?.mergeHighlight ?? false;\n  const glowBoost = opts?.glowBoost ?? 1;\n\n  const pal = getTilePalette(value);"
          replacement_content: "export function drawNeonTile(\n  ctx: CanvasRenderingContext2D,\n  x: number,\n  y: number,\n  size: number,\n  value: number,\n  opts?: {\n    alpha?: number;\n    scale?: number;\n    flash?: number;\n    mergeHighlight?: boolean;\n    glowBoost?: number;\n    themeId?: ThemeId;\n  }\n): void {\n  const alpha = opts?.alpha ?? 1;\n  const scale = opts?.scale ?? 1;\n  const flash = opts?.flash ?? 0;\n  const mergeHighlight = opts?.mergeHighlight ?? false;\n  const glowBoost = opts?.glowBoost ?? 1;\n\n  const pal = getTilePalette(value, opts?.themeId ?? \'NEON_CYBER\');"
          start_line: 300
          end_line: 325
        }
        replacement_chunks {
          target_content: "export function drawBlockPiece(\n  ctx: CanvasRenderingContext2D,\n  piece: BlockPiece,\n  centerX: number,\n  centerY: number,\n  cellSize: number,\n  cellGap: number,\n  alpha = 1,\n  glowBoost = 1\n): void {\n  const totalW = piece.width * cellSize + (piece.width - 1) * cellGap;\n  const totalH = piece.height * cellSize + (piece.height - 1) * cellGap;\n  const startX = centerX - totalW / 2;\n  const startY = centerY - totalH / 2;\n\n  for (const cell of piece.cells) {\n    const tx = startX + cell.dc * (cellSize + cellGap);\n    const ty = startY + cell.dr * (cellSize + cellGap);\n    drawNeonTile(ctx, tx, ty, cellSize, cell.value, { alpha, glowBoost });\n  }\n}\n\nexport function createAmbientMotes(count: number, width: number, height: number): AmbientMote[] {\n  const colors = [\'#22D3EE\', \'#3B82F6\', \'#A855F7\', \'#818CF8\', \'#67E8F9\'];\n  const motes: AmbientMote[] = [];\n  for (let i = 0; i < count; i++) {\n    motes.push({\n      x: Math.random() * width,\n      y: Math.random() * height,\n      r: 1 + Math.random() * 2.1,\n      vx: (Math.random() - 0.5) * 14,\n      vy: -8 - Math.random() * 20,\n      alpha: 0.16 + Math.random() * 0.34,\n      color: colors[i % colors.length],\n      phase: Math.random() * Math.PI * 2,\n      twinkleSpeed: 1.5 + Math.random() * 2.5,\n    });\n  }\n  return motes;\n}"
          replacement_content: "export function drawBlockPiece(\n  ctx: CanvasRenderingContext2D,\n  piece: BlockPiece,\n  centerX: number,\n  centerY: number,\n  cellSize: number,\n  cellGap: number,\n  alpha = 1,\n  glowBoost = 1,\n  themeId: ThemeId = \'NEON_CYBER\'\n): void {\n  const totalW = piece.width * cellSize + (piece.width - 1) * cellGap;\n  const totalH = piece.height * cellSize + (piece.height - 1) * cellGap;\n  const startX = centerX - totalW / 2;\n  const startY = centerY - totalH / 2;\n\n  for (const cell of piece.cells) {\n    const tx = startX + cell.dc * (cellSize + cellGap);\n    const ty = startY + cell.dr * (cellSize + cellGap);\n    drawNeonTile(ctx, tx, ty, cellSize, cell.value, { alpha, glowBoost, themeId });\n  }\n}\n\nexport function createAmbientMotes(\n  count: number,\n  width: number,\n  height: number,\n  themeId: ThemeId = \'NEON_CYBER\'\n): AmbientMote[] {\n  const colors = getThemeDefinition(themeId).moteColors;\n  const motes: AmbientMote[] = [];\n  for (let i = 0; i < count; i++) {\n    motes.push({\n      x: Math.random() * width,\n      y: Math.random() * height,\n      r: 1 + Math.random() * 2.1,\n      vx: (Math.random() - 0.5) * 14,\n      vy: -8 - Math.random() * 20,\n      alpha: 0.16 + Math.random() * 0.34,\n      color: colors[i % colors.length],\n      phase: Math.random() * Math.PI * 2,\n      twinkleSpeed: 1.5 + Math.random() * 2.5,\n    });\n  }\n  return motes;\n}"
