            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const trayY = startY + boardSize + gap;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
