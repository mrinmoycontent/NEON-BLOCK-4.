      thinking_signature: "\022\314\030\n\311\030\001i\024}\0239\351!\234\376\272\257\325\322u\265L.\375P\006.\241&\2240Q\336\213\322\241\230S\264\333\373~F\247\254\351RN\260q\021\231\373\204\255z\b\326\240a\222oN\223\362]\304\232\353\320\372\353\2508\001\r-:\3455\r$\217\032e\005$u\002\353!2\302L\267$\313\205\273y\002\337/\r\255\341\271kMR\261o5\353\177\266\t\261\037\376)_\216\344s\024\371\216\034\235\247\354\251\247\035\222\025:Cu\357kWD\324\355\020\364\236UH:`\234\231#\035\2526\365N~fWjk\345\215 >\220{\305\020\354{\250b7\266TV\363\271\3045\253K\3403E\v\'DN;<\225\210\322|r\341\326C\244\244.\332\b\363S\372\225\360\016\261\313\336{\243\207f\023C\215\373\221\253\361#\035\356\204\356\364\233\256F\302\335\207\234\037\220\346\004\274L\023\217)\004\217\372\024\314@\222b]\211\273\315\0374\326]\033\216\213\365a\2338\036I}5\226j[\274L\276]m1\342>\254@\334\3779d\'\n\n\352\004PV=\232\262\364R\332;\376AY\2359q\310\326N\234\363\242\004Hz\352O9\370\301y\360!(i\a\315\305\273\372\301p\023\253\251\2267]\207~8\357\253\266\a\357\341sm\352\231\035\0220\277\037\017\372\325i\360UK#<tS\223\001\302\231\035\235\237\307\353\347r#\017\345\361Z\377\210/\253\276\260\016\022\241\372P\235\313c\002\035=\364\356_K\264&\320#\253\002Q\276\216\215\356\310\340$\321Ye\357x\276\2229e\304\201\222\253\301\005\347\214\237\016\325\r\313V\000\310\030\214\263\ral\224m\'j\242\212e\367\272\022f\2760\003w=\271\226.Y47\333!\023\373\f\rC\033S\304\251\311\250+8\301d\227\343%\375\317w7Zc\241\332Bt\271\355sm}\020\210\356\"\001\217M\306>\273\256\372\267-E\316B\373W\374L\r\366\021\326\017\\\235\t\353a%8\372\346\031\277\034\201:\366\217\376eeiy\224\243\367\233\301Bv\312\t\257\251\357\3054W\034X\334\027%\005\n\252D\226\343\2567\314\3324\251\242`L\341r\206\355\313\371\256\n(yw\003\311\346P\317\335\320]\303\374\240\266\240 \331C8\032&\306\267U\275\220%\375x]\220\354\230\211\3512({\326\323l]D\232\336\327%\247W\231\365\3748\"Lx\000\316\265\276\364\317\214\021f\337P\213\330\032\326\"A0_@{\265\016\330;\333\'\244\324\000\211&o\2