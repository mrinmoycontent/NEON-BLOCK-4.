  planner_response {
    thinking: "**Refining Code Imports**\n\nI\'m now integrating the required imports into `/src/components/NeonCanvas.tsx`. This includes `createSeededRng`, `createDailyStarterGrid`, `DailyChallengeConfig`, `FireworkRocket`, `ParticleIntensity`, and `ParticleShape`. The focus is on ensuring these are correctly added via `multi_replace_file_content`. I\'ll next integrate the particle definitions.\n\n\n"
    tool_calls {
      id: "call_7992857720836474765"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Upgrade NeonCanvas with Daily Challenge deterministic runs, pooled mobile-optimized multi-shape particles, combo explosions, line shockwaves, and high-score fireworks\",\"Instruction\":\"Update NeonCanvas props, state, particle emitters, fireworks, and simulation loop\",\"ReplacementChunks\":[{\"AllowMultiple\":false,\"EndLine\":78,\"ReplacementContent\":\"import { createSeededRng } from \'../game/daily\';\\nimport {\\n  applyPiecePlacement,\\n  computePlacementPreview,\\n  createDailyStarterGrid,\\n  createEmptyGrid,\\n  createShowcaseGrid,\\n  findAllValidPlacements,\\n  generateTray,\\n  getMaxTileOnGrid,\\n} from \'../game/engine\';\\nimport { getTilePalette } from \'../game/palette\';\\nimport {\\n  AmbientMote,\\n  CanvasLayout,\\n  CursorVisualState,\\n  DragVisualState,\\n  computeCanvasLayout,\\n  createAmbientMotes,\\n  getCellRect,\\n  hitTestTraySlot,\\n  renderNeonCanvas,\\n  screenToGridAnchor,\\n  screenToSingleCell,\\n} from \'../game/renderer\';\\nimport {\\n  BlockPiece,\\n  DailyChallengeConfig,\\n  FireworkRocket,\\n  FloatingText,\\n  GRID_SIZE,\\n  GameStats,\\n  GameStatus,\\n  GridMatrix,\\n  LineBeam,\\n  MergeGhostTile,\\n  Particle,\\n  ParticleIntensity,\\n  ParticleShape,\\n  PlacementPreview,\\n  ShockwaveRing,\\n  TRAY_SIZE,\\n  TurnResolution,\\n} from \'../game/types\';\\n\\nexport interface StartGameOptions {\\n  dailyChallenge?: DailyChallengeConfig;\\n}\\n\\nexport interface NeonCanvasHandle {\\n  startNewGame: (options?: StartGameOptions) => void;\\n  focusBoard: () => void;\\n  triggerFireworks: (count?: number) => void;\\n}\\n\\ninterface NeonCanvasProps {\\n  status: GameStatus;\\n  bestScore: number;\\n  reducedMotion: boolean;\\n  particleIntensity: ParticleIntensity;\\n  onStatsChange: (stats: GameStats) => void;\\n  onComboEvent: (label: string) => void;\\n  onGameOver: (finalStats: GameStats) => void;\\n  onRequestPause: () => void;\\n  onRequestToggleMute: () => void;\\n  onRequestHudFocus: () => void;\\n}\\n\\ninterface SimState {\\n  grid: GridMatrix;\\n  tray: (BlockPiece | null)[];\\n  selectedSlot: number;\\n  stats: GameStats;\\n  preview: PlacementPreview | null;\\n  drag: DragVisualState | null;\\n  pointerDownPos: { x: number; y: number; slot: number; pointerType: string } | null;\\n  cursor: CursorVisualState;\\n  particles: Particle[];\\n  fireworks: FireworkRocket[];\\n  shockwaves: ShockwaveRing[];\\n  beams: LineBeam[];\\n  floatingTexts: FloatingText[];\\n  mergeGhosts: MergeGhostTile[];\\n  motes: AmbientMote[];\\n  shakeTimer: number;\\n  shakeIntensity: number;\\n  time: number;\\n  rng: () => number;\\n}\",\"StartLine\":3,\"TargetContent\":\"import {\\n  applyPiecePlacement,\\n  computePlacementPreview,\\n  createEmptyGrid,\\n  createShowcaseGrid,\\n  findAllValidPlacements,\\n  generateTray,\\n  getMaxTileOnGrid,\\n} from \'../game/engine\';\\nimport { getTilePalette } from \'../game/palette\';\\nimport {\\n  AmbientMote,\\n  CanvasLayout,\\n  CursorVisualState,\\n  DragVisualState,\\n  computeCanvasLayout,\\n  createAmbientMotes,\\n  getCellRect,\\n  hitTestTraySlot,\\n  renderNeonCanvas,\\n  screenToGridAnchor,\\n  screenToSingleCell,\\n} from \'../game/renderer\';\\nimport {\\n  BlockPiece,\\n  FloatingText,\\n  GRID_SIZE,\\n  GameStats,\\n  GameStatus,\\n  GridMatrix,\\n  LineBeam,\\n  MergeGhostTile,\\n  Particle,\\n  PlacementPreview,\\n  ShockwaveRing,\\n  TRAY_SIZE,\\n  TurnResolution,\\n} from \'../game/types\';\\n\\nexport interface NeonCanvasHandle {\\n  startNewGame: () => void;\\n  focusBoard: () => void;\\n}\\n\\ninterface NeonCanvasProps {\\n  status: GameStatus;\\n  bestScore: number;\\n  reducedMotion: boolean;\\n  onStatsChange: (stats: GameStats) => void;\\n  onComboEvent: (label: string) => void;\\n  onGameOver: (finalStats: GameStats) => void;\\n  onRequestPause: () => void;\\n  onRequestToggleMute: () => void;\\n  onRequestHudFocus: () => void;\\n}\\n\\ninterface SimState {\\n  grid: GridMatrix;\\n  tray: (BlockPiece | null)[];\\n  selectedSlot: number;\\n  stats: GameStats;\\n  preview: PlacementPreview | null;\\n  drag: DragVisualState | null;\\n  pointerDownPos: { x: number; y: number; slot: number; pointerType: string } | null;\\n  cursor: CursorVisualState;\\n  particles: Particle[];\\n  shockwaves: ShockwaveRing[];\\n  beams: LineBeam[];\\n  floatingTexts: FloatingText[];\\n  mergeGhosts: MergeGhostTile[];\\n  motes: AmbientMote[];\\n  shakeTimer: number;\\n  shakeIntensity: number;\\n  time: number;\\n}\"},{\"AllowMultiple\":false,\"EndLine\":141,\"ReplacementContent\":\"export const NeonCanvas = React.forwardRef<NeonCanvasHandle, NeonCanvasProps>(\\n  (\\n    {\\n      status,\\n      bestScore,\\n      reducedMotion,\\n      particleIntensity,\\n      onStatsChange,\\n      onComboEvent,\\n      onGameOver,\\n      onRequestPause,\\n      onRequestToggleMute,\\n      onRequestHudFocus,\\n    },\\n    ref\\n  ) => {\\n    const containerRef = useRef<HTMLDivElement>(null);\\n    const canvasRef = useRef<HTMLCanvasElement>(null);\\n    const layoutRef = useRef<CanvasLayout>(computeCanvasLayout(800, 600));\\n\\n    const statusRef = useRef(status);\\n    statusRef.current = status;\\n\\n    const bestScoreRef = useRef(bestScore);\\n    bestScoreRef.current = bestScore;\\n\\n    const reducedMotionRef = useRef(reducedMotion);\\n    reducedMotionRef.current = reducedMotion;\\n\\n    const intensityRef = useRef<ParticleIntensity>(particleIntensity);\\n    intensityRef.current = particleIntensity;\\n\\n    const simRef = useRef<SimState>({\\n      grid: createShowcaseGrid(),\\n      tray: [null, null, null],\\n      selectedSlot: -1,\\n      stats: {\\n        score: 0,\\n        bestScore,\\n        maxTile: 512,\\n        mergesCount: 0,\\n        linesCleared: 0,\\n        bestCombo: 0,\\n        turnsPlayed: 0,\\n        isNewBest: false,\\n      },\\n      preview: null,\\n      drag: null,\\n      pointerDownPos: null,\\n      cursor: {\\n        visible: false,\\n        zone: \'GRID\',\\n        gridRow: 2,\\n        gridCol: 2,\\n        traySlot: 0,\\n      },\\n      particles: [],\\n      fireworks: [],\\n      shockwaves: [],\\n      beams: [],\\n      floatingTexts: [],\\n      mergeGhosts: [],\\n      motes: createAmbientMotes(26, 900, 600),\\n      shakeTimer: 0,\\n      shakeIntensity: 0,\\n      time: 0,\\n      rng: Math.random,\\n    });\",\"StartLine\":79,\"TargetContent\":\"export const NeonCanvas = React.forwardRef<NeonCanvasHandle, NeonCanvasProps>(\\n  (\\n    {\\n      status,\\n      bestScore,\\n      reducedMotion,\\n      onStatsChange,\\n      onComboEvent,\\n      onGameOver,\\n      onRequestPause,\\n      onRequestToggleMute,\\n      onRequestHudFocus,\\n    },\\n    ref\\n  ) => {\\n    const containerRef = useRef<HTMLDivElement>(null);\\n    const canvasRef = useRef<HTMLCanvasElement>(null);\\n    const layoutRef = useRef<CanvasLayout>(computeCanvasLayout(800, 600));\\n\\n    const statusRef = useRef(status);\\n    statusRef.current = status;\\n\\n    const bestScoreRef = useRef(bestScore);\\n    bestScoreRef.current = bestScore;\\n\\n    const reducedMotionRef = useRef(reducedMotion);\\n    reducedMotionRef.current = reducedMotion;\\n\\n    const simRef = useRef<SimState>({\\n      grid: createShowcaseGrid(),\\n      tray: [null, null, null],\\n      selectedSlot: -1,\\n      stats: {\\n        score: 0,\\n        bestScore,\\n        maxTile: 512,\\n        mergesCount: 0,\\n        linesCleared: 0,\\n        bestCombo: 0,\\n        turnsPlayed: 0,\\n        isNewBest: false,\\n      },\\n      preview: null,\\n      drag: null,\\n      pointerDownPos: null,\\n      cursor: {\\n        visible: false,\\n        zone: \'GRID\',\\n        gridRow: 2,\\n        gridCol: 2,\\n        traySlot: 0,\\n      },\\n      particles: [],\\n      shockwaves: [],\\n      beams: [],\\n      floatingTexts: [],\\n      mergeGhosts: [],\\n      motes: createAmbientMotes(26, 900, 600),\\n      shakeTimer: 0,\\n      shakeIntensity: 0,\\n      time: 0,\\n    });\"},{\"AllowMultiple\":false,\"EndLine\":445,\"ReplacementContent\":\"    const getIntensityScale = (): number => {\\n      if (reducedMotionRef.current) return 0;\\n      switch (intensityRef.current) {\\n        case \'LOW\':\\n          return 0.42;\\n        case \'MEDIUM\':\\n          return 0.72;\\n        case \'HIGH\':\\n        default:\\n          return 1.0;\\n      }\\n    };\\n\\n    const getMaxParticleBudget = (): number => {\\n      if (reducedMotionRef.current) return 0;\\n      switch (intensityRef.current) {\\n        case \'LOW\':\\n          return 90;\\n        case \'MEDIUM\':\\n          return 185;\\n        case \'HIGH\':\\n        default:\\n          return 360;\\n      }\\n    };\\n\\n    const pushParticle = (p: Particle): void => {\\n      const budget = getMaxParticleBudget();\\n      if (budget <= 0) return;\\n      const particles = simRef.current.particles;\\n      if (particles.length >= budget) {\\n        particles.shift();\\n      }\\n      particles.push(p);\\n    };\\n\\n    const launchFireworks = (count = 4): void => {\\n      if (reducedMotionRef.current) return;\\n      const sim = simRef.current;\\n      const layout = layoutRef.current;\\n      const colors = [\'#22D3EE\', \'#60A5FA\', \'#C084FC\', \'#E879F9\', \'#67E8F9\'];\\n      const actualCount = Math.max(2, Math.round(count * getIntensityScale()));\\n\\n      for (let i = 0; i < actualCount; i++) {\\n        const delayMs = i * 150;\\n        window.setTimeout(() => {\\n          const w = layoutRef.current.width;\\n          const h = layoutRef.current.height;\\n          const startX = w * (0.18 + Math.random() * 0.64);\\n          const targetY = h * (0.14 + Math.random() * 0.28);\\n          sim.fireworks.push({\\n            x: startX,\\n            y: h + 12,\\n            vx: (Math.random() - 0.5) * 65,\\n            vy: -(480 + Math.random() * 140),\\n            targetY,\\n            color: colors[i % colors.length],\\n            trailTimer: 0,\\n          });\\n        }, delayMs);\\n      }\\n    };\\n\\n    const detonateFirework = (fw: FireworkRocket): void => {\\n      const sim = simRef.current;\\n      const scale = getIntensityScale();\\n      if (scale <= 0) return;\\n\\n      neonAudio.playFireworkBurst();\\n\\n      const palette = [fw.color, \'#E0F2FE\', \'#A855F7\', \'#38BDF8\'];\\n      const count = Math.max(14, Math.round(34 * scale));\\n      const shapes: ParticleShape[] = [\'spark\', \'diamond\', \'circle\'];\\n\\n      sim.shockwaves.push({\\n        x: fw.x,\\n        y: fw.y,\\n        radius: 6,\\n        maxRadius: 95,\\n        color: fw.color,\\n        alpha: 0.85,\\n        life: 0.36,\\n        maxLife: 0.36,\\n        lineWidth: 2.5,\\n      });\\n\\n      for (let i = 0; i < count; i++) {\\n        const ang = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.18;\\n        const spd = 95 + Math.random() * 210;\\n        const life = 0.65 + Math.random() * 0.45;\\n        pushParticle({\\n          x: fw.x,\\n          y: fw.y,\\n          vx: Math.cos(ang) * spd,\\n          vy: Math.sin(ang) * spd - 20,\\n          size: 2.2 + Math.random() * 2.2,\\n          color: palette[i % palette.length],\\n          alpha: 1,\\n          life,\\n          maxLife: life,\\n          shape: shapes[i % shapes.length],\\n          gravity: 165,\\n          drag: 0.96,\\n        });\\n      }\\n    };\\n\\n    const startNewGame = (options?: StartGameOptions) => {\\n      const sim = simRef.current;\\n      const daily = options?.dailyChallenge;\\n      const rng = daily ? createSeededRng(daily.seed + 101) : Math.random;\\n      const freshGrid = daily\\n        ? createDailyStarterGrid(daily.starterCells)\\n        : createEmptyGrid();\\n      const freshTray = generateTray(freshGrid, rng);\\n\\n      sim.rng = rng;\\n      sim.grid = freshGrid;\\n      sim.tray = freshTray;\\n      sim.selectedSlot = 0;\\n      sim.preview = null;\\n      sim.drag = null;\\n      sim.pointerDownPos = null;\\n      sim.particles = [];\\n      sim.fireworks = [];\\n      sim.shockwaves = [];\\n      sim.beams = [];\\n      sim.floatingTexts = [];\\n      sim.mergeGhosts = [];\\n      sim.shakeTimer = 0;\\n      sim.shakeIntensity = 0;\\n      sim.cursor = {\\n        visible: false,\\n        zone: \'GRID\',\\n        gridRow: 2,\\n        gridCol: 2,\\n        traySlot: 0,\\n      };\\n      sim.stats = {\\n        score: 0,\\n        bestScore: bestScoreRef.current,\\n        maxTile: getMaxTileOnGrid(freshGrid),\\n        mergesCount: 0,\\n        linesCleared: 0,\\n        bestCombo: 0,\\n        turnsPlayed: 0,\\n        isNewBest: false,\\n      };\\n\\n      onStatsChange({ ...sim.stats });\\n      onComboEvent(\'\');\\n    };\\n\\n    useImperativeHandle(ref, () => ({\\n      startNewGame,\\n      focusBoard: () => {\\n        canvasRef.current?.focus();\\n        const sim = simRef.current;\\n        sim.cursor.visible = true;\\n        sim.cursor.zone = \'GRID\';\\n        updateCursorPreview();\\n      },\\n      triggerFireworks: (count = 5) => {\\n        launchFireworks(count);\\n      },\\n    }));\\n\\n    // Keep ambient floating motes count responsive to ParticleIntensity setting\\n    useEffect(() => {\\n      const targetMotes = reducedMotion\\n        ? 6\\n        : particleIntensity === \'LOW\'\\n          ? 10\\n          : particleIntensity === \'MEDIUM\'\\n            ? 20\\n            : 34;\\n      const layout = layoutRef.current;\\n      simRef.current.motes = createAmbientMotes(targetMotes, layout.width, layout.height);\\n    }, [particleIntensity, reducedMotion]);\\n\\n    const spawnVfxForResolution = (res: TurnResolution) => {\\n      const sim = simRef.current;\\n      const layout = layoutRef.current;\\n      const rm = reducedMotionRef.current;\\n      const pScale = getIntensityScale();\\n\\n      // Placement subtle sparks\\n      if (!rm && pScale > 0) {\\n        const sparksPerCell = Math.max(2, Math.round(5 * pScale));\\n        for (const pt of res.placedCells) {\\n          const rect = getCellRect(layout, pt.r, pt.c);\\n          const cx = rect.x + rect.w / 2;\\n          const cy = rect.y + rect.h / 2;\\n          for (let i = 0; i < sparksPerCell; i++) {\\n            const ang = (Math.PI * 2 * i) / sparksPerCell + Math.random() * 0.5;\\n            const spd = 45 + Math.random() * 80;\\n            pushParticle({\\n              x: cx,\\n              y: cy,\\n              vx: Math.cos(ang) * spd,\\n              vy: Math.sin(ang) * spd,\\n              size: 1.8 + Math.random() * 1.4,\\n              color: \'#38BDF8\',\\n              alpha: 0.9,\\n              life: 0.32,\\n              maxLife: 0.32,\\n              shape: \'spark\',\\n              gravity: 0,\\n              drag: 0.92,\\n            });\\n          }\\n        }\\n      }\\n\\n      // Merge VFX & Colorful Combo Explosions\\n      const comboColors = [\'#22D3EE\', \'#60A5FA\', \'#A855F7\', \'#E879F9\', \'#F0ABFC\', \'#E0F2FE\'];\\n      for (const merge of res.mergeSteps) {\\n        const targetRect = getCellRect(layout, merge.targetCell.r, merge.targetCell.c);\\n        const tx = targetRect.x + targetRect.w / 2;\\n        const ty = targetRect.y + targetRect.h / 2;\\n        const pal = getTilePalette(merge.newValue);\\n        const isCombo = merge.comboDepth >= 2;\\n\\n        if (!rm) {\\n          for (const fc of merge.fromCells) {\\n            const fromRect = getCellRect(layout, fc.r, fc.c);\\n            sim.mergeGhosts.push({\\n              fromX: fromRect.x,\\n              fromY: fromRect.y,\\n              toX: targetRect.x,\\n              toY: targetRect.y,\\n              size: targetRect.w,\\n              value: merge.oldValue,\\n              progress: 0,\\n              duration: 0.14,\\n            });\\n          }\\n\\n          sim.shockwaves.push({\\n            x: tx,\\n            y: ty,\\n            radius: targetRect.w * 0.25,\\n            maxRadius: targetRect.w * (1.3 + merge.comboDepth * 0.25),\\n            color: pal.border,\\n            alpha: 0.92,\\n            life: 0.36,\\n            maxLife: 0.36,\\n            lineWidth: isCombo ? 3.5 : 2.5,\\n          });\\n\\n          if (isCombo) {\\n            sim.shockwaves.push({\\n              x: tx,\\n              y: ty,\\n              radius: targetRect.w * 0.15,\\n              maxRadius: targetRect.w * (1.85 + merge.comboDepth * 0.35),\\n              color: \'#E879F9\',\\n              alpha: 0.85,\\n              life: 0.44,\\n              maxLife: 0.44,\\n              lineWidth: 2,\\n            });\\n          }\\n\\n          if (pScale > 0) {\\n            const baseBurst = isCombo ? 24 + merge.comboDepth * 8 : 14;\\n            const burstCount = Math.max(5, Math.round(baseBurst * pScale));\\n            for (let i = 0; i < burstCount; i++) {\\n              const ang = Math.random() * Math.PI * 2;\\n              const spd = (isCombo ? 105 : 75) + Math.random() * (isCombo ? 220 : 165);\\n              const life = 0.44 + Math.random() * 0.28;\\n              const color = isCombo\\n                ? comboColors[i % comboColors.length]\\n                : i % 3 === 0\\n                  ? \'#E0F2FE\'\\n                  : pal.border;\\n              const shape: ParticleShape =\\n                i % 3 === 0 ? \'diamond\' : i % 2 === 0 ? \'spark\' : \'circle\';\\n\\n              pushParticle({\\n                x: tx,\\n                y: ty,\\n                vx: Math.cos(ang) * spd,\\n                vy: Math.sin(ang) * spd,\\n                size: 2.2 + Math.random() * (isCombo ? 2.8 : 2.1),\\n                color,\\n                alpha: 1,\\n                life,\\n                maxLife: life,\\n                shape,\\n                gravity: isCombo ? 85 : 0,\\n                drag: 0.93,\\n              });\\n            }\\n          }\\n        }\\n\\n        sim.floatingTexts.push({\\n          x: tx,\\n          y: ty - 8,\\n          vy: -44,\\n          text: `+${merge.points}`,\\n          subtext: merge.comboDepth > 1 ? `CHAIN \303\227${merge.comboDepth}` : `MERGE ${merge.newValue}`,\\n          color: pal.border,\\n          life: 0.98,\\n          maxLife: 0.98,\\n          scale: merge.comboDepth > 1 ? 1.18 : 1,\\n        });\\n      }\\n\\n      // Line Clear VFX (Glowing Shockwaves + Plasma Beams + Sparks)\\n      if (res.lineClearStep) {\\n        const { rows, cols, points } = res.lineClearStep;\\n        const { boardRect, cellSize } = layout;\\n\\n        for (const r of rows) {\\n          const first = getCellRect(layout, r, 0);\\n          sim.beams.push({\\n            x: boardRect.x + 6,\\n            y: first.y + cellSize * 0.18,\\n            w: boardRect.w - 12,\\n            h: cellSize * 0.64,\\n            color: \'rgba(34, 211, 238, 0.88)\',\\n            life: 0.38,\\n            maxLife: 0.38,\\n          });\\n          if (!rm) {\\n            sim.shockwaves.push({\\n              x: boardRect.x + boardRect.w / 2,\\n              y: first.y + cellSize / 2,\\n              radius: cellSize * 0.5,\\n              maxRadius: boardRect.w * 0.68,\\n              color: \'#22D3EE\',\\n              alpha: 0.8,\\n              life: 0.42,\\n              maxLife: 0.42,\\n              lineWidth: 2.5,\\n            });\\n          }\\n        }\\n        for (const c of cols) {\\n          const first = getCellRect(layout, 0, c);\\n          sim.beams.push({\\n            x: first.x + cellSize * 0.18,\\n            y: boardRect.y + 6,\\n            w: cellSize * 0.64,\\n            h: boardRect.h - 12,\\n            color: \'rgba(192, 132, 252, 0.88)\',\\n            life: 0.38,\\n            maxLife: 0.38,\\n          });\\n          if (!rm) {\\n            sim.shockwaves.push({\\n              x: first.x + cellSize / 2,\\n              y: boardRect.y + boardRect.h / 2,\\n              radius: cellSize * 0.5,\\n              maxRadius: boardRect.h * 0.68,\\n              color: \'#C084FC\',\\n              alpha: 0.8,\\n              life: 0.42,\\n              maxLife: 0.42,\\n              lineWidth: 2.5,\\n            });\\n          }\\n        }\\n\\n        if (!rm && pScale > 0) {\\n          const perCell = Math.max(2, Math.round(7 * pScale));\\n          for (const cell of res.lineClearStep.clearedCells) {\\n            const rect = getCellRect(layout, cell.r, cell.c);\\n            const cx = rect.x + rect.w / 2;\\n            const cy = rect.y + rect.h / 2;\\n            const pal = getTilePalette(cell.value);\\n            for (let i = 0; i < perCell; i++) {\\n              const ang = Math.random() * Math.PI * 2;\\n              const spd = 90 + Math.random() * 195;\\n              const life = 0.48 + Math.random() * 0.22;\\n              pushParticle({\\n                x: cx,\\n                y: cy,\\n                vx: Math.cos(ang) * spd,\\n                vy: Math.sin(ang) * spd,\\n                size: 2.3 + Math.random() * 2.1,\\n                color: i % 2 === 0 ? pal.border : \'#67E8F9\',\\n                alpha: 1,\\n                life,\\n                maxLife: life,\\n                shape: i % 2 === 0 ? \'spark\' : \'diamond\',\\n                gravity: 40,\\n                drag: 0.93,\\n              });\\n            }\\n          }\\n        }\\n\\n        const totalLines = rows.length + cols.length;\\n        sim.floatingTexts.push({\\n          x: boardRect.x + boardRect.w / 2,\\n          y: boardRect.y + boardRect.h / 2,\\n          vy: -38,\\n          text: `+${points}`,\\n          subtext: totalLines > 1 ? `MEGA CLEAR \303\227${totalLines}` : \'LINE CLEAR\',\\n          color: \'#67E8F9\',\\n          life: 1.08,\\n          maxLife: 1.08,\\n          scale: 1.22,\\n        });\\n      }\\n\\n      // Subtle screen shake for major combos or multi-line clears\\n      if (!rm && (res.maxComboDepth >= 2 || res.lineClearStep)) {\\n        sim.shakeTimer = 0.22;\\n        sim.shakeIntensity = Math.min(\\n          10,\\n          3 + res.maxComboDepth * 2.1 + (res.lineClearStep ? 2.5 : 0)\\n        );\\n      }\\n    };\\n\\n    const executePlacement = (slotIndex: number, anchorRow: number, anchorCol: number): boolean => {\\n      const sim = simRef.current;\\n      const piece = sim.tray[slotIndex];\\n      if (!piece) return false;\\n\\n      const clampedR = Math.max(0, Math.min(GRID_SIZE - piece.height, anchorRow));\\n      const clampedC = Math.max(0, Math.min(GRID_SIZE - piece.width, anchorCol));\\n\\n      const res = applyPiecePlacement(\\n        sim.grid,\\n        sim.tray,\\n        slotIndex,\\n        clampedR,\\n        clampedC,\\n        sim.rng\\n      );\\n      if (!res) {\\n        neonAudio.playInvalid();\\n        return false;\\n      }\\n\\n      neonAudio.playPlace();\\n\\n      if (res.mergeSteps.length > 0) {\\n        const lastMerge = res.mergeSteps[res.mergeSteps.length - 1];\\n        setTimeout(() => {\\n          neonAudio.playMerge(res.maxComboDepth, lastMerge.newValue);\\n        }, 55);\\n      }\\n\\n      if (res.lineClearStep) {\\n        const totalLines = res.lineClearStep.rows.length + res.lineClearStep.cols.length;\\n        setTimeout(() => {\\n          neonAudio.playLineClear(totalLines);\\n        }, 85);\\n      }\\n\\n      if (res.refilledTray && !res.isGameOver) {\\n        setTimeout(() => {\\n          neonAudio.playNewTray();\\n        }, 150);\\n      }\\n\\n      spawnVfxForResolution(res);\\n\\n      // Update stats & High-Score Fireworks Celebration\\n      const prevBest = sim.stats.bestScore;\\n      const newScore = sim.stats.score + res.totalPointsGained;\\n      const newBestScore = Math.max(prevBest, newScore);\\n      const brokeRecord = newScore > prevBest && prevBest > 0;\\n\\n      if (brokeRecord && !sim.stats.isNewBest) {\\n        neonAudio.playNewBest();\\n        launchFireworks(5);\\n        onComboEvent(\'NEW BEST SCORE\');\\n      }\",\"StartLine\":224,\"TargetContent\":\"    const startNewGame = () => {\\n      const sim = simRef.current;\\n      const freshGrid = createEmptyGrid();\\n      const freshTray = generateTray(freshGrid);\\n\\n      sim.grid = freshGrid;\\n      sim.tray = freshTray;\\n      sim.selectedSlot = 0;\\n      sim.preview = null;\\n      sim.drag = null;\\n      sim.pointerDownPos = null;\\n      sim.particles = [];\\n      sim.shockwaves = [];\\n      sim.beams = [];\\n      sim.floatingTexts = [];\\n      sim.mergeGhosts = [];\\n      sim.shakeTimer = 0;\\n      sim.shakeIntensity = 0;\\n      sim.cursor = {\\n        visible: false,\\n        zone: \'GRID\',\\n        gridRow: 2,\\n        gridCol: 2,\\n        traySlot: 0,\\n      };\\n      sim.stats = {\\n        score: 0,\\n        bestScore: bestScoreRef.current,\\n        maxTile: 0,\\n        mergesCount: 0,\\n        linesCleared: 0,\\n        bestCombo: 0,\\n        turnsPlayed: 0,\\n        isNewBest: false,\\n      };\\n\\n      onStatsChange({ ...sim.stats });\\n      onComboEvent(\'\');\\n    };\\n\\n    useImperativeHandle(ref, () => ({\\n      startNewGame,\\n      focusBoard: () => {\\n        canvasRef.current?.focus();\\n        const sim = simRef.current;\\n        sim.cursor.visible = true;\\n        sim.cursor.zone = \'GRID\';\\n        updateCursorPreview();\\n      },\\n    }));\\n\\n    const spawnVfxForResolution = (res: TurnResolution) => {\\n      const sim = simRef.current;\\n      const layout = layoutRef.current;\\n      const rm = reducedMotionRef.current;\\n\\n      // Placement subtle sparks\\n      if (!rm) {\\n        for (const pt of res.placedCells) {\\n          const rect = getCellRect(layout, pt.r, pt.c);\\n          const cx = rect.x + rect.w / 2;\\n          const cy = rect.y + rect.h / 2;\\n          for (let i = 0; i < 4; i++) {\\n            const ang = (Math.PI * 2 * i) / 4 + Math.random() * 0.6;\\n            const spd = 40 + Math.random() * 70;\\n            sim.particles.push({\\n              x: cx,\\n              y: cy,\\n              vx: Math.cos(ang) * spd,\\n              vy: Math.sin(ang) * spd,\\n              size: 2 + Math.random() * 1.5,\\n              color: \'#38BDF8\',\\n              alpha: 0.9,\\n              life: 0.35,\\n              maxLife: 0.35,\\n            });\\n          }\\n        }\\n      }\\n\\n      // Merge VFX\\n      for (const merge of res.mergeSteps) {\\n        const targetRect = getCellRect(layout, merge.targetCell.r, merge.targetCell.c);\\n        const tx = targetRect.x + targetRect.w / 2;\\n        const ty = targetRect.y + targetRect.h / 2;\\n        const pal = getTilePalette(merge.newValue);\\n\\n        if (!rm) {\\n          for (const fc of merge.fromCells) {\\n            const fromRect = getCellRect(layout, fc.r, fc.c);\\n            sim.mergeGhosts.push({\\n              fromX: fromRect.x,\\n              fromY: fromRect.y,\\n              toX: targetRect.x,\\n              toY: targetRect.y,\\n              size: targetRect.w,\\n              value: merge.oldValue,\\n              progress: 0,\\n              duration: 0.14,\\n            });\\n          }\\n\\n          sim.shockwaves.push({\\n            x: tx,\\n            y: ty,\\n            radius: targetRect.w * 0.25,\\n            maxRadius: targetRect.w * (1.25 + merge.comboDepth * 0.2),\\n            color: pal.border,\\n            alpha: 0.9,\\n            life: 0.34,\\n            maxLife: 0.34,\\n            lineWidth: 3,\\n          });\\n\\n          const burstCount = Math.min(24, 10 + merge.comboDepth * 4);\\n          for (let i = 0; i < burstCount; i++) {\\n            const ang = Math.random() * Math.PI * 2;\\n            const spd = 70 + Math.random() * 170;\\n            sim.particles.push({\\n              x: tx,\\n              y: ty,\\n              vx: Math.cos(ang) * spd,\\n              vy: Math.sin(ang) * spd,\\n              size: 2.2 + Math.random() * 2.5,\\n              color: i % 2 === 0 ? pal.border : \'#E0F2FE\',\\n              alpha: 1,\\n              life: 0.45 + Math.random() * 0.2,\\n              maxLife: 0.65,\\n            });\\n          }\\n        }\\n\\n        sim.floatingTexts.push({\\n          x: tx,\\n          y: ty - 8,\\n          vy: -42,\\n          text: `+${merge.points}`,\\n          subtext: merge.comboDepth > 1 ? `CHAIN \303\227${merge.comboDepth}` : `MERGE ${merge.newValue}`,\\n          color: pal.border,\\n          life: 0.95,\\n          maxLife: 0.95,\\n          scale: merge.comboDepth > 1 ? 1.15 : 1,\\n        });\\n      }\\n\\n      // Line Clear VFX\\n      if (res.lineClearStep) {\\n        const { rows, cols, points } = res.lineClearStep;\\n        const { boardRect, cellSize } = layout;\\n\\n        for (const r of rows) {\\n          const first = getCellRect(layout, r, 0);\\n          sim.beams.push({\\n            x: boardRect.x + 6,\\n            y: first.y + cellSize * 0.18,\\n            w: boardRect.w - 12,\\n            h: cellSize * 0.64,\\n            color: \'rgba(34, 211, 238, 0.85)\',\\n            life: 0.36,\\n            maxLife: 0.36,\\n          });\\n        }\\n        for (const c of cols) {\\n          const first = getCellRect(layout, 0, c);\\n          sim.beams.push({\\n            x: first.x + cellSize * 0.18,\\n            y: boardRect.y + 6,\\n            w: cellSize * 0.64,\\n            h: boardRect.h - 12,\\n            color: \'rgba(192, 132, 252, 0.85)\',\\n            life: 0.36,\\n            maxLife: 0.36,\\n          });\\n        }\\n\\n        if (!rm) {\\n          for (const cell of res.lineClearStep.clearedCells) {\\n            const rect = getCellRect(layout, cell.r, cell.c);\\n            const cx = rect.x + rect.w / 2;\\n            const cy = rect.y + rect.h / 2;\\n            const pal = getTilePalette(cell.value);\\n            for (let i = 0; i < 6; i++) {\\n              const ang = Math.random() * Math.PI * 2;\\n              const spd = 80 + Math.random() * 180;\\n              sim.particles.push({\\n                x: cx,\\n                y: cy,\\n                vx: Math.cos(ang) * spd,\\n                vy: Math.sin(ang) * spd,\\n                size: 2.5 + Math.random() * 2,\\n                color: pal.border,\\n                alpha: 1,\\n                life: 0.5,\\n                maxLife: 0.5,\\n              });\\n            }\\n          }\\n        }\\n\\n        const totalLines = rows.length + cols.length;\\n        sim.floatingTexts.push({\\n          x: boardRect.x + boardRect.w / 2,\\n          y: boardRect.y + boardRect.h / 2,\\n          vy: -36,\\n          text: `+${points}`,\\n          subtext: totalLines > 1 ? `MEGA CLEAR \303\227${totalLines}` : \'LINE CLEAR\',\\n          color: \'#67E8F9\',\\n          life: 1.05,\\n          maxLife: 1.05,\\n          scale: 1.2,\\n        });\\n      }\\n\\n      // Micro camera shake on big combos or line clears\\n      if (!rm && (res.maxComboDepth >= 2 || res.lineClearStep)) {\\n        sim.shakeTimer = 0.2;\\n        sim.shakeIntensity = Math.min(9, 3 + res.maxComboDepth * 2 + (res.lineClearStep ? 2.5 : 0));\\n      }\\n    };\\n\\n    const executePlacement = (slotIndex: number, anchorRow: number, anchorCol: number): boolean => {\\n      const sim = simRef.current;\\n      const piece = sim.tray[slotIndex];\\n      if (!piece) return false;\\n\\n      const clampedR = Math.max(0, Math.min(GRID_SIZE - piece.height, anchorRow));\\n      const clampedC = Math.max(0, Math.min(GRID_SIZE - piece.width, anchorCol));\\n\\n      const res = applyPiecePlacement(sim.grid, sim.tray, slotIndex, clampedR, clampedC);\\n      if (!res) {\\n        neonAudio.playInvalid();\\n        return false;\\n      }\\n\\n      neonAudio.playPlace();\\n\\n      if (res.mergeSteps.length > 0) {\\n        const lastMerge = res.mergeSteps[res.mergeSteps.length - 1];\\n        setTimeout(() => {\\n          neonAudio.playMerge(res.maxComboDepth, lastMerge.newValue);\\n        }, 45);\\n      }\\n\\n      if (res.lineClearStep) {\\n        const totalLines = res.lineClearStep.rows.length + res.lineClearStep.cols.length;\\n        setTimeout(() => {\\n          neonAudio.playLineClear(totalLines);\\n        }, 70);\\n      }\\n\\n      if (res.refilledTray && !res.isGameOver) {\\n        setTimeout(() => {\\n          neonAudio.playNewTray();\\n        }, 140);\\n      }\\n\\n      spawnVfxForResolution(res);\\n\\n      // Update stats\\n      const prevBest = sim.stats.bestScore;\\n      const newScore = sim.stats.score + res.totalPointsGained;\\n      const newBestScore = Math.max(prevBest, newScore);\\n      const brokeRecord = newScore > prevBest && prevBest > 0;\\n\\n      if (brokeRecord && !sim.stats.isNewBest) {\\n        neonAudio.playNewBest();\\n      }\"},{\"AllowMultiple\":false,\"EndLine\":655,\"ReplacementContent\":\"        // Firework Rockets\\n        for (let i = sim.fireworks.length - 1; i >= 0; i--) {\\n          const fw = sim.fireworks[i];\\n          fw.x += fw.vx * dt;\\n          fw.y += fw.vy * dt;\\n          fw.vy += 240 * dt;\\n          fw.trailTimer += dt;\\n          if (fw.trailTimer >= 0.025) {\\n            fw.trailTimer = 0;\\n            pushParticle({\\n              x: fw.x,\\n              y: fw.y,\\n              vx: (Math.random() - 0.5) * 20,\\n              vy: 30 + Math.random() * 25,\\n              size: 1.6,\\n              color: fw.color,\\n              alpha: 0.75,\\n              life: 0.22,\\n              maxLife: 0.22,\\n              shape: \'circle\',\\n              gravity: 0,\\n              drag: 0.94,\\n            });\\n          }\\n          if (fw.y <= fw.targetY || fw.vy >= -40) {\\n            sim.fireworks.splice(i, 1);\\n            detonateFirework(fw);\\n          }\\n        }\\n\\n        // Particles with physics & smooth fade-out\\n        for (let i = sim.particles.length - 1; i >= 0; i--) {\\n          const p = sim.particles[i];\\n          p.life -= dt;\\n          if (p.life <= 0) {\\n            sim.particles.splice(i, 1);\\n            continue;\\n          }\\n          p.x += p.vx * dt;\\n          p.y += p.vy * dt;\\n          p.vy += p.gravity * dt;\\n          const damp = Math.pow(p.drag, dt * 60);\\n          p.vx *= damp;\\n          p.vy *= damp;\\n          const t = p.life / p.maxLife;\\n          p.alpha = t * t;\\n        }\\n\\n        // Shockwaves\\n        for (let i = sim.shockwaves.length - 1; i >= 0; i--) {\\n          const s = sim.shockwaves[i];\\n          s.life -= dt;\\n          if (s.life <= 0) {\\n            sim.shockwaves.splice(i, 1);\\n            continue;\\n          }\\n          const t = 1 - s.life / s.maxLife;\\n          s.radius = s.maxRadius * (0.25 + 0.75 * (1 - Math.pow(1 - t, 2)));\\n          s.alpha = s.life / s.maxLife;\\n        }\\n\\n        // Beams\\n        for (let i = sim.beams.length - 1; i >= 0; i--) {\\n          sim.beams[i].life -= dt;\\n          if (sim.beams[i].life <= 0) {\\n            sim.beams.splice(i, 1);\\n          }\\n        }\\n\\n        // Floating Texts\\n        for (let i = sim.floatingTexts.length - 1; i >= 0; i--) {\\n          const ft = sim.floatingTexts[i];\\n          ft.life -= dt;\\n          if (ft.life <= 0) {\\n            sim.floatingTexts.splice(i, 1);\\n            continue;\\n          }\\n          ft.y += ft.vy * dt;\\n          ft.vy *= 0.95;\\n        }\\n\\n        // Shake\\n        let shakeX = 0;\\n        let shakeY = 0;\\n        if (sim.shakeTimer > 0 && !reducedMotionRef.current) {\\n          sim.shakeTimer = Math.max(0, sim.shakeTimer - dt);\\n          const mag = sim.shakeIntensity * (sim.shakeTimer / 0.22);\\n          shakeX = (Math.random() - 0.5) * 2 * mag;\\n          shakeY = (Math.random() - 0.5) * 2 * mag;\\n        }\\n\\n        const ctx = canvas.getContext(\'2d\');\\n        if (ctx) {\\n          renderNeonCanvas(ctx, layout, {\\n            time: sim.time,\\n            grid: sim.grid,\\n            tray: sim.tray,\\n            selectedSlot: statusRef.current === \'PLAYING\' ? sim.selectedSlot : -1,\\n            preview: statusRef.current === \'PLAYING\' ? sim.preview : null,\\n            drag: statusRef.current === \'PLAYING\' ? sim.drag : null,\\n            cursor:\\n              statusRef.current === \'PLAYING\'\\n                ? sim.cursor\\n                : { ...sim.cursor, visible: false },\\n            particles: sim.particles,\\n            fireworks: sim.fireworks,\\n            shockwaves: sim.shockwaves,\\n            beams: sim.beams,\\n            floatingTexts: sim.floatingTexts,\\n            mergeGhosts: sim.mergeGhosts,\\n            motes: sim.motes,\\n            shakeX,\\n            shakeY,\\n            isDimmed: statusRef.current !== \'PLAYING\',\\n          });\\n        }\",\"StartLine\":568,\"TargetContent\":\"        // Particles\\n        for (let i = sim.particles.length - 1; i >= 0; i--) {\\n          const p = sim.particles[i];\\n          p.life -= dt;\\n          if (p.life <= 0) {\\n            sim.particles.splice(i, 1);\\n            continue;\\n          }\\n          p.x += p.vx * dt;\\n          p.y += p.vy * dt;\\n          p.vx *= 0.94;\\n          p.vy *= 0.94;\\n          p.alpha = p.life / p.maxLife;\\n        }\\n\\n        // Shockwaves\\n        for (let i = sim.shockwaves.length - 1; i >= 0; i--) {\\n          const s = sim.shockwaves[i];\\n          s.life -= dt;\\n          if (s.life <= 0) {\\n            sim.shockwaves.splice(i, 1);\\n            continue;\\n          }\\n          const t = 1 - s.life / s.maxLife;\\n          s.radius = s.maxRadius * (0.25 + 0.75 * (1 - Math.pow(1 - t, 2)));\\n          s.alpha = s.life / s.maxLife;\\n        }\\n\\n        // Beams\\n        for (let i = sim.beams.length - 1; i >= 0; i--) {\\n          sim.beams[i].life -= dt;\\n          if (sim.beams[i].life <= 0) {\\n            sim.beams.splice(i, 1);\\n          }\\n        }\\n\\n        // Floating Texts\\n        for (let i = sim.floatingTexts.length - 1; i >= 0; i--) {\\n          const ft = sim.floatingTexts[i];\\n          ft.life -= dt;\\n          if (ft.life <= 0) {\\n            sim.floatingTexts.splice(i, 1);\\n            continue;\\n          }\\n          ft.y += ft.vy * dt;\\n          ft.vy *= 0.95;\\n        }\\n\\n        // Shake\\n        let shakeX = 0;\\n        let shakeY = 0;\\n        if (sim.shakeTimer > 0) {\\n          sim.shakeTimer = Math.max(0, sim.shakeTimer - dt);\\n          const mag = sim.shakeIntensity * (sim.shakeTimer / 0.2);\\n          shakeX = (Math.random() - 0.5) * 2 * mag;\\n          shakeY = (Math.random() - 0.5) * 2 * mag;\\n        }\\n\\n        const ctx = canvas.getContext(\'2d\');\\n        if (ctx) {\\n          renderNeonCanvas(ctx, layout, {\\n            time: sim.time,\\n            grid: sim.grid,\\n            tray: sim.tray,\\n            selectedSlot: statusRef.current === \'PLAYING\' ? sim.selectedSlot : -1,\\n            preview: statusRef.current === \'PLAYING\' ? sim.preview : null,\\n            drag: statusRef.current === \'PLAYING\' ? sim.drag : null,\\n            cursor:\\n              statusRef.current === \'PLAYING\'\\n                ? sim.cursor\\n                : { ...sim.cursor, visible: false },\\n            particles: sim.particles,\\n            shockwaves: sim.shockwaves,\\n            beams: sim.beams,\\n            floatingTexts: sim.floatingTexts,\\n            mergeGhosts: sim.mergeGhosts,\\n            motes: sim.motes,\\n            shakeX,\\n            shakeY,\\n            isDimmed: statusRef.current !== \'PLAYING\',\\n          });\\n        }\"}],\"TargetFile\":\"/src/components/NeonCanvas.tsx\",\"toolAction\":\"Upgrading NeonCanvas VFX and Daily mode\",\"toolSummary\":\"Upgrade NeonCanvas VFX and Daily mode\"}"
