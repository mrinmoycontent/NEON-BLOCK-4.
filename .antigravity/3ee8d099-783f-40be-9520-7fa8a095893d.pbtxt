            }
            lines {
              text: "  let working = profile;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const unlockedSet = new Set<AchievementId>(working.unlockedAchievements);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
