    command_line: "npx tsx -e \"\nimport assert from \'node:assert/strict\';\nimport { buildSevenDayStreakHistory, generateDailyChallenge } from \'./src/game/daily.ts\';\n\n// 1. Empty state across month boundary (2026-11-02 -> 2026-10-27..2026-11-02)\nconst emptyState = { currentStreak: 0, longestStreak: 0, lastCompletedDate: null, totalShards: 0, records: {} };\nconst emptyHist = buildSevenDayStreakHistory(emptyState, \'2026-11-02\');\nassert.equal(emptyHist.days.length, 7);\nassert.equal(emptyHist.days[0].dateKey, \'2026-10-27\');\nassert.equal(emptyHist.days[6].dateKey, \'2026-11-02\');\nassert.equal(emptyHist.days[6].isToday, true);\nassert.equal(emptyHist.completedCount, 0);\nassert.equal(emptyHist.consistencyPct, 0);\nassert.ok(emptyHist.days.every((d) => d.progressPct === 0 && !d.completed && !d.attempted));\n\n// 2. Mixed completion, partial progress, and missed days\nconst chNov20 = generateDailyChallenge(\'2026-11-20\');\nconst partialProg = Math.floor(chNov20.targetValue * 0.5);\nconst expectedPct = Math.round((partialProg / chNov20.targetValue) * 100);\nconst mixedState = {\n  currentStreak: 2,\n  longestStreak: 3,\n  lastCompletedDate: \'2026-11-23\',\n  totalShards: 600,\n  records: {\n    \'2026-11-18\': { dateKey: \'2026-11-18\', completed: true, rewardClaimed: true, bestProgress: 9999, bestScore: 2400, attempts: 1 },\n    \'2026-11-20\': { dateKey: \'2026-11-20\', completed: false, rewardClaimed: false, bestProgress: partialProg, bestScore: 800, attempts: 2 },\n    \'2026-11-22\': { dateKey: \'2026-11-22\', completed: true, rewardClaimed: true, bestProgress: 9999, bestScore: 3100, attempts: 1 },\n    \'2026-11-23\': { dateKey: \'2026-11-23\', completed: true, rewardClaimed: true, bestProgress: 9999, bestScore: 1950, attempts: 1 },\n  },\n};\nconst mixedHist = buildSevenDayStreakHistory(mixedState, \'2026-11-23\');\nassert.equal(mixedHist.completedCount, 3);\nassert.equal(mixedHist.consistencyPct, 43);\nassert.equal(mixedHist.days[0].dateKey, \'2026-11-17\');\nassert.equal(mixedHist.days[0].completed, false);\nassert.equal(mixedHist.days[1].completed, true);\nassert.equal(mixedHist.days[1].progressPct, 100);\nassert.equal(mixedHist.days[3].dateKey, \'2026-11-20\');\nassert.equal(mixedHist.days[3].completed, false);\nassert.equal(mixedHist.days[3].attempted, true);\nassert.equal(mixedHist.days[3].progressPct, expectedPct);\nassert.equal(mixedHist.days[5].completed, true);\nassert.equal(mixedHist.days[6].completed, true);\nassert.equal(mixedHist.days[6].isToday, true);\n\nconsole.log(\'ALL 7-DAY STREAK HISTORY TESTS PASSED\');\n\""
