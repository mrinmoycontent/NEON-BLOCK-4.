          target_content: "import {\n  applyPiecePlacement,\n  computePlacementPreview,\n  createEmptyGrid,\n  createShowcaseGrid,\n  findAllValidPlacements,\n  generateTray,\n  getMaxTileOnGrid,\n} from \'../game/engine\';\nimport { getTilePalette } from \'../game/palette\';\nimport {\n  AmbientMote,\n  CanvasLayout,\n  CursorVisualState,\n  DragVisualState,\n  computeCanvasLayout,\n  createAmbientMotes,\n  getCellRect,\n  hitTestTraySlot,\n  renderNeonCanvas,\n  screenToGridAnchor,\n  screenToSingleCell,\n} from \'../game/renderer\';\nimport {\n  BlockPiece,\n  FloatingText,\n  GRID_SIZE,\n  GameStats,\n  GameStatus,\n  GridMatrix,\n  LineBeam,\n  MergeGhostTile,\n  Particle,\n  PlacementPreview,\n  ShockwaveRing,\n  TRAY_SIZE,\n  TurnResolution,\n} from \'../game/types\';\n\nexport interface NeonCanvasHandle {\n  startNewGame: () => void;\n  focusBoard: () => void;\n}\n\ninterface NeonCanvasProps {\n  status: GameStatus;\n  bestScore: number;\n  reducedMotion: boolean;\n  onStatsChange: (stats: GameStats) => void;\n  onComboEvent: (label: string) => void;\n  onGameOver: (finalStats: GameStats) => void;\n  onRequestPause: () => void;\n  onRequestToggleMute: () => void;\n  onRequestHudFocus: () => void;\n}\n\ninterface SimState {\n  grid: GridMatrix;\n  tray: (BlockPiece | null)[];\n  selectedSlot: number;\n  stats: GameStats;\n  preview: PlacementPreview | null;\n  drag: DragVisualState | null;\n  pointerDownPos: { x: number; y: number; slot: number; pointerType: string } | null;\n  cursor: CursorVisualState;\n  particles: Particle[];\n  shockwaves: ShockwaveRing[];\n  beams: LineBeam[];\n  floatingTexts: FloatingText[];\n  mergeGhosts: MergeGhostTile[];\n  motes: AmbientMote[];\n  shakeTimer: number;\n  shakeIntensity: number;\n  time: number;\n}"
          replacement_content: "import { createSeededRng } from \'../game/daily\';\nimport {\n  applyPiecePlacement,\n  computePlacementPreview,\n  createDailyStarterGrid,\n  createEmptyGrid,\n  createShowcaseGrid,\n  findAllValidPlacements,\n  generateTray,\n  getMaxTileOnGrid,\n} from \'../game/engine\';\nimport { getTilePalette } from \'../game/palette\';\nimport {\n  AmbientMote,\n  CanvasLayout,\n  CursorVisualState,\n  DragVisualState,\n  computeCanvasLayout,\n  createAmbientMotes,\n  getCellRect,\n  hitTestTraySlot,\n  renderNeonCanvas,\n  screenToGridAnchor,\n  screenToSingleCell,\n} from \'../game/renderer\';\nimport {\n  BlockPiece,\n  DailyChallengeConfig,\n  FireworkRocket,\n  FloatingText,\n  GRID_SIZE,\n  GameStats,\n  GameStatus,\n  GridMatrix,\n  LineBeam,\n  MergeGhostTile,\n  Particle,\n  ParticleIntensity,\n  ParticleShape,\n  PlacementPreview,\n  ShockwaveRing,\n  TRAY_SIZE,\n  TurnResolution,\n} from \'../game/types\';\n\nexport interface StartGameOptions {\n  dailyChallenge?: DailyChallengeConfig;\n}\n\nexport interface NeonCanvasHandle {\n  startNewGame: (options?: StartGameOptions) => void;\n  focusBoard: () => void;\n  triggerFireworks: (count?: number) => void;\n}\n\ninterface NeonCanvasProps {\n  status: GameStatus;\n  bestScore: number;\n  reducedMotion: boolean;\n  particleIntensity: ParticleIntensity;\n  onStatsChange: (stats: GameStats) => void;\n  onComboEvent: (label: string) => void;\n  onGameOver: (finalStats: GameStats) => void;\n  onRequestPause: () => void;\n  onRequestToggleMute: () => void;\n  onRequestHudFocus: () => void;\n}\n\ninterface SimState {\n  grid: GridMatrix;\n  tray: (BlockPiece | null)[];\n  selectedSlot: number;\n  stats: GameStats;\n  preview: PlacementPreview | null;\n  drag: DragVisualState | null;\n  pointerDownPos: { x: number; y: number; slot: number; pointerType: string } | null;\n  cursor: CursorVisualState;\n  particles: Particle[];\n  fireworks: FireworkRocket[];\n  shockwaves: ShockwaveRing[];\n  beams: LineBeam[];\n  floatingTexts: FloatingText[];\n  mergeGhosts: MergeGhostTile[];\n  motes: AmbientMote[];\n  shakeTimer: number;\n  shakeIntensity: number;\n  time: number;\n  rng: () => number;\n}"
          start_line: 3
