      name: "run_command"
      arguments_json: "{\"CommandLine\":\"npx tsx -e \\\"\\nimport assert from \'node:assert/strict\';\\n\\n(async () => {\\n  const store = new Map<string, string>();\\n  const mockStorage = {\\n    getItem: (k: string) => (store.has(k) ? store.get(k)! : null),\\n    setItem: (k: string, v: string) => { store.set(k, String(v)); },\\n    removeItem: (k: string) => { store.delete(k); },\\n    clear: () => { store.clear(); },\\n  };\\n\\n  let sharedSfxBusConnections = 0;\\n  let smoothRampsCalled = 0;\\n  let oscillatorsStarted = 0;\\n  const destinationNode = { _isDest: true };\\n  let sharedBusNode: any = null;\\n\\n  class MockAudioParam {\\n    value = 1;\\n    setValueAtTime(v: number) { this.value = v; }\\n    linearRampToValueAtTime(v: number) { this.value = v; }\\n    exponentialRampToValueAtTime(v: number) { this.value = v; }\\n    cancelScheduledValues() {}\\n    cancelAndHoldAtTime() {}\\n    setTargetAtTime(v: number) { this.value = v; smoothRampsCalled++; }\\n  }\\n\\n  class MockGainNode {\\n    gain = new MockAudioParam();\\n    isBus = false;\\n    connect(dest: any) {\\n      if (dest === destinationNode) {\\n        this.isBus = true;\\n        sharedBusNode = this;\\n      } else if (dest === sharedBusNode) {\\n        sharedSfxBusConnections++;\\n      }\\n    }\\n  }\\n\\n  class MockOscillatorNode {\\n    type = \'sine\';\\n    frequency = new MockAudioParam();\\n    connect() {}\\n    start() { oscillatorsStarted++; }\\n    stop() {}\\n  }\\n\\n  class MockFilterNode {\\n    type = \'lowpass\';\\n    frequency = new MockAudioParam();\\n    connect() {}\\n  }\\n\\n  class MockAudioContext {\\n    currentTime = 1.0;\\n    state = \'running\';\\n    destination = destinationNode;\\n    createGain() { return new MockGainNode(); }\\n    createOscillator() { return new MockOscillatorNode(); }\\n    createBiquadFilter() { return new MockFilterNode(); }\\n    resume() { return Promise.resolve(); }\\n  }\\n\\n  (globalThis as any).window = {\\n    localStorage: mockStorage,\\n    AudioContext: MockAudioContext,\\n  };\\n\\n  const streaks = await import(\'./src/game/streaks.ts\');\\n  const audioMod = await import(\'./src/game/audio.ts\');\\n  const dailyMod = await import(\'./src/game/daily.ts\');\\n  const progMod = await import(\'./src/game/progression.ts\');\\n  const engineMod = await import(\'./src/game/engine.ts\');\\n  const navMod = await import(\'./src/game/navigation.ts\');\\n\\n  // 1. STREAK CALCULATIONS, DUPLICATE CLAIMS & RESET BEHAVIOR\\n  let s = streaks.createDefaultStreakState();\\n  assert.equal(streaks.computeCurrentStreak(s.completedDates, \'2026-11-23\'), 0);\\n\\n  let out = streaks.recordQualifyingStreakDay(s, \'2026-11-23\', \'DAILY_CHALLENGE\', \'2026-11-23\');\\n  assert.equal(out.currentStreak, 1);\\n  assert.equal(out.bestStreak, 1);\\n  assert.equal(out.isNewRecord, true);\\n  assert.equal(out.alreadyCountedToday, false);\\n  s = out.state;\\n\\n  // Same day via Daily Reward -> must NOT increment again!\\n  out = streaks.recordQualifyingStreakDay(s, \'2026-11-23\', \'DAILY_REWARD\', \'2026-11-23\');\\n  assert.equal(out.currentStreak, 1);\\n  assert.equal(out.bestStreak, 1);\\n  assert.equal(out.isNewRecord, false);\\n  assert.equal(out.alreadyCountedToday, true);\\n  assert.equal(out.state.dateSources[\'2026-11-23\'], \'BOTH\');\\n  s = out.state;\\n\\n  // App open on next day BEFORE playing -> must NOT reset streak!\\n  assert.equal(streaks.computeCurrentStreak(s.completedDates, \'2026-11-24\'), 1);\\n\\n  out = streaks.recordQualifyingStreakDay(s, \'2026-11-24\', \'DAILY_REWARD\', \'2026-11-24\');\\n  assert.equal(out.currentStreak, 2);\\n  assert.equal(out.isNewRecord, true);\\n  s = out.state;\\n\\n  out = streaks.recordQualifyingStreakDay(s, \'2026-11-25\', \'DAILY_CHALLENGE\', \'2026-11-25\');\\n  assert.equal(out.currentStreak, 3);\\n  assert.equal(out.bestStreak, 3);\\n  assert.equal(out.milestoneHit, 3);\\n  assert.equal(out.isNewRecord, true);\\n  s = out.state;\\n\\n  // Persist & simulate app restart -> streak preserved\\n  streaks.saveStreakState(s);\\n  const reloadedStreak = streaks.loadStreakState();\\n  assert.equal(reloadedStreak.bestStreak, 3);\\n  assert.equal(streaks.computeCurrentStreak(reloadedStreak.completedDates, \'2026-11-25\'), 3);\\n  assert.equal(streaks.computeCurrentStreak(reloadedStreak.completedDates, \'2026-11-26\'), 3);\\n\\n  // Miss 2026-11-26 -> resets to 0 on 2026-11-27 while bestStreak=3 is preserved\\n  assert.equal(streaks.computeCurrentStreak(reloadedStreak.completedDates, \'2026-11-27\'), 0);\\n  assert.equal(reloadedStreak.bestStreak, 3);\\n  const msAfterReset = streaks.getStreakMilestonesStatus(0, reloadedStreak.bestStreak);\\n  assert.equal(msAfterReset[0].days, 3);\\n  assert.equal(msAfterReset[0].reachedCurrent, false);\\n  assert.equal(msAfterReset[0].reachedEver, true);\\n\\n  out = streaks.recordQualifyingStreakDay(reloadedStreak, \'2026-11-27\', \'DAILY_CHALLENGE\', \'2026-11-27\');\\n  assert.equal(out.currentStreak, 1);\\n  assert.equal(out.bestStreak, 3);\\n  assert.equal(out.isNewRecord, false);\\n\\n  // 2. MONTH CHANGES, LEAP YEARS & YEAR CHANGES\\n  let monthState = streaks.createDefaultStreakState();\\n  for (const d of [\'2026-01-30\', \'2026-01-31\', \'2026-02-01\', \'2026-02-02\']) {\\n    monthState = streaks.recordQualifyingStreakDay(monthState, d, \'DAILY_CHALLENGE\', d).state;\\n  }\\n  assert.equal(streaks.computeCurrentStreak(monthState.completedDates, \'2026-02-02\'), 4);\\n\\n  let nonLeap = streaks.createDefaultStreakState();\\n  for (const d of [\'2026-02-28\', \'2026-03-01\']) {\\n    nonLeap = streaks.recordQualifyingStreakDay(nonLeap, d, \'DAILY_REWARD\', d).state;\\n  }\\n  assert.equal(streaks.computeCurrentStreak(nonLeap.completedDates, \'2026-03-01\'), 2);\\n\\n  let leap = streaks.createDefaultStreakState();\\n  for (const d of [\'2028-02-28\', \'2028-02-29\', \'2028-03-01\']) {\\n    leap = streaks.recordQualifyingStreakDay(leap, d, \'DAILY_CHALLENGE\', d).state;\\n  }\\n  assert.equal(streaks.computeCurrentStreak(leap.completedDates, \'2028-03-01\'), 3);\\n\\n  let yearState = streaks.createDefaultStreakState();\\n  for (const d of [\'2026-12-30\', \'2026-12-31\', \'2027-01-01\', \'2027-01-02\']) {\\n    yearState = streaks.recordQualifyingStreakDay(yearState, d, \'DAILY_CHALLENGE\', d).state;\\n  }\\n  assert.equal(streaks.computeCurrentStreak(yearState.completedDates, \'2027-01-02\'), 4);\\n  assert.equal(yearState.bestStreak, 4);\\n\\n  const emptyDaily = dailyMod.loadDailySaveState();\\n  const calYear = streaks.buildThirtyDayActivityCalendar(yearState, emptyDaily, \'2026-12-28\');\\n  assert.equal(calYear.days.length, 30);\\n  assert.equal(calYear.todayIndex, 22);\\n  assert.equal(calYear.days[22].dateKey, \'2026-12-28\');\\n  assert.equal(calYear.days[22].status, \'TODAY_PENDING\');\\n  assert.equal(calYear.upcomingCount, 7);\\n  const jan1Cell = calYear.days.find((d) => d.dateKey === \'2027-01-01\');\\n  assert.ok(jan1Cell && jan1Cell.isMonthStart && jan1Cell.year === 2027 && jan1Cell.status === \'UPCOMING\');\\n\\n  // 30-day consecutive milestone hits at 3, 7, 14, 30\\n  let run30 = streaks.createDefaultStreakState();\\n  const hitMilestones: number[] = [];\\n  for (let i = 0; i < 30; i++) {\\n    const dk = dailyMod.offsetLocalDateKey(\'2026-12-15\', i);\\n    const res = streaks.recordQualifyingStreakDay(run30, dk, i % 2 === 0 ? \'DAILY_CHALLENGE\' : \'DAILY_REWARD\', dk);\\n    run30 = res.state;\\n    if (res.milestoneHit) hitMilestones.push(res.milestoneHit);\\n  }\\n  assert.deepEqual(hitMilestones, [3, 7, 14, 30]);\\n  assert.equal(streaks.computeCurrentStreak(run30.completedDates, \'2027-01-13\'), 30);\\n\\n  // 3. REWARD SYNCHRONIZATION & CORRUPTION RECOVERY\\n  mockStorage.clear();\\n  let profile = progMod.createDefaultProfile();\\n  const claim1 = progMod.claimDailyMilestoneReward(profile, \'2026-11-20\', 0);\\n  assert.equal(claim1.claimed, true);\\n  profile = claim1.profile;\\n  const claimDup = progMod.claimDailyMilestoneReward(profile, \'2026-11-20\', 0);\\n  assert.equal(claimDup.claimed, false);\\n\\n  mockStorage.setItem(streaks.STREAK_STORAGE_KEY, \'{corrupted_json!!!\');\\n  const dailyWithWin = {\\n    currentStreak: 1,\\n    longestStreak: 5,\\n    lastCompletedDate: \'2026-11-21\',\\n    totalShards: 150,\\n    records: {\\n      \'2026-11-21\': {\\n        dateKey: \'2026-11-21\',\\n        completed: true,\\n        rewardClaimed: true,\\n        bestProgress: 1200,\\n        bestScore: 1500,\\n        attempts: 1,\\n      },\\n    },\\n  };\\n  const hydrated = streaks.loadStreakState(dailyWithWin, profile);\\n  assert.equal(hydrated.completedDates.includes(\'2026-11-20\'), true);\\n  assert.equal(hydrated.completedDates.includes(\'2026-11-21\'), true);\\n  assert.equal(streaks.computeCurrentStreak(hydrated.completedDates, \'2026-11-21\'), 2);\\n  assert.equal(hydrated.bestStreak, 5);\\n\\n  // 4. AUDIO VOLUME CONTROL, SHARED GAIN NODE & RESTART\\n  mockStorage.clear();\\n  const defAudio = audioMod.loadAudioSettings();\\n  assert.equal(defAudio.sfxVolume, 70);\\n  assert.equal(defAudio.muted, false);\\n\\n  mockStorage.setItem(audioMod.AUDIO_STORAGE_KEY, \'not-json\');\\n  const recoveredAudio = audioMod.loadAudioSettings();\\n  assert.equal(recoveredAudio.sfxVolume, 70);\\n  assert.equal(recoveredAudio.muted, false);\\n\\n  audioMod.saveAudioSettings({ version: 1, sfxVolume: 45, muted: false });\\n  const restoredAudio = audioMod.loadAudioSettings();\\n  assert.equal(restoredAudio.sfxVolume, 45);\\n  assert.equal(restoredAudio.muted, false);\\n\\n  audioMod.neonAudio.configure(restoredAudio);\\n  audioMod.neonAudio.unlock();\\n  assert.ok(sharedBusNode && sharedBusNode.isBus, \'Shared sfxGain bus must connect to destination\');\\n\\n  const gainAt45 = audioMod.neonAudio.getEffectiveGain();\\n  audioMod.neonAudio.setSfxVolume(90);\\n  const gainAt90 = audioMod.neonAudio.getEffectiveGain();\\n  assert.ok(gainAt90 > gainAt45 && gainAt90 <= 1);\\n  assert.ok(smoothRampsCalled > 0, \'Volume changes must use smooth setTargetAtTime ramps\');\\n\\n  const prevConn = sharedSfxBusConnections;\\n  const prevOsc = oscillatorsStarted;\\n  audioMod.neonAudio.playVolumePreview(true);\\n  audioMod.neonAudio.playMove();\\n  audioMod.neonAudio.playSelect();\\n  audioMod.neonAudio.playPlace();\\n  audioMod.neonAudio.playInvalid();\\n  audioMod.neonAudio.playMerge(2, 16);\\n  audioMod.neonAudio.playLineClear(2);\\n  audioMod.neonAudio.playNewTray();\\n  audioMod.neonAudio.playNewBest();\\n  audioMod.neonAudio.playGameOver();\\n  audioMod.neonAudio.playFireworkBurst();\\n  audioMod.neonAudio.playDailyComplete();\\n  audioMod.neonAudio.playRewardClaim();\\n  audioMod.neonAudio.playLevelUp();\\n  audioMod.neonAudio.playStreakRecord();\\n  assert.ok(sharedSfxBusConnections > prevConn + 14, \'All SFX must route into shared sfxGain node\');\\n  assert.ok(oscillatorsStarted > prevOsc + 14);\\n\\n  audioMod.neonAudio.setMuted(true);\\n  assert.equal(audioMod.neonAudio.getEffectiveGain(), 0);\\n  assert.equal(audioMod.neonAudio.getSfxVolume(), 90);\\n  const oscWhileMuted = oscillatorsStarted;\\n  audioMod.neonAudio.playPlace();\\n  audioMod.neonAudio.playStreakRecord();\\n  assert.equal(oscillatorsStarted, oscWhileMuted, \'Muted engine must not emit sound\');\\n\\n  audioMod.neonAudio.setMuted(false);\\n  assert.equal(audioMod.neonAudio.getSfxVolume(), 90);\\n  assert.equal(audioMod.neonAudio.getEffectiveGain(), gainAt90);\\n  audioMod.neonAudio.playPlace();\\n  assert.ok(oscillatorsStarted > oscWhileMuted, \'Unmuted engine must emit sound\');\\n\\n  // 5. CORE GAMEPLAY & NAVIGATION REGRESSION\\n  const grid = engineMod.createEmptyGrid();\\n  const tray = engineMod.generateTray(grid);\\n  assert.equal(tray.length, 3);\\n  assert.equal(engineMod.hasAnyValidMove(grid, tray), true);\\n\\n  let nav = navMod.INITIAL_NAV_STATE;\\n  nav = navMod.navigateToView(nav, \'DASHBOARD\');\\n  nav = navMod.navigateToView(nav, \'DAILY_SCREEN\');\\n  nav = navMod.navigateBack(nav);\\n  assert.equal(nav.status, \'DASHBOARD\');\\n  nav = navMod.navigateBack(nav);\\n  assert.equal(nav.status, \'TITLE_MENU\');\\n\\n  console.log(\'ALL REGRESSION TESTS PASSED SUCCESSFULLY!\');\\n})();\\n\\\"\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Running automated regression test suite\", \"toolSummary\":\"Run automated regression tests\"}"
