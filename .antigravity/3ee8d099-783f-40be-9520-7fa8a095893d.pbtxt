  view_file {
    absolute_path_uri: "file:///src/game/types.ts"
    end_line: 379
    content: "export const GRID_SIZE = 6;\nexport const TRAY_SIZE = 3;\n\nexport type GameMode = \'CLASSIC\' | \'DAILY\';\n\nexport type GameStatus =\n  | \'TITLE_MENU\'\n  | \'DAILY_SCREEN\'\n  | \'DASHBOARD\'\n  | \'PLAYING\'\n  | \'PAUSED\'\n  | \'GAME_OVER\';\n\nexport type DashboardTab =\n  | \'OVERVIEW\'\n  | \'STREAKS\'\n  | \'MILESTONES\'\n  | \'COMBOS\'\n  | \'ACHIEVEMENTS\';\n\nexport interface AudioSettingsState {\n  version: number;\n  sfxVolume: number; // 0..100 integer percentage, default 70\n  muted: boolean;\n}\n\nexport type StreakSource = \'DAILY_CHALLENGE\' | \'DAILY_REWARD\' | \'BOTH\';\n\nexport interface StreakSaveState {\n  version: number;\n  completedDates: string[]; // deduplicated sorted local YYYY-MM-DD dates\n  dateSources: Record<string, StreakSource>;\n  bestStreak: number;\n  lastRecordStreak: number;\n  lastRecordDate: string | null;\n}\n\nexport type CalendarDayStatus =\n  | \'COMPLETED\'\n  | \'MISSED\'\n  | \'TODAY_PENDING\'\n  | \'UPCOMING\';\n\nexport interface StreakCalendarDay {\n  dateKey: string;\n  dayNum: number;\n  dayShort: string;\n  monthShort: string;\n  year: number;\n  isMonthStart: boolean;\n  isToday: boolean;\n  status: CalendarDayStatus;\n  source?: StreakSource;\n  challengeCompleted: boolean;\n  rewardClaimed: boolean;\n  challengeAttempted: boolean;\n  progressPct: number;\n  bestScore: number;\n  challengeTitle: string;\n  readableDate: string;\n  projectedMilestone?: 3 | 7 | 14 | 30;\n}\n\nexport interface StreakMilestoneTier {\n  days: 3 | 7 | 14 | 30;\n  label: string;\n  subtitle: string;\n  reachedCurrent: boolean;\n  reachedEver: boolean;\n  progressPct: number;\n  daysRemaining: number;\n}\n\nexport type FocusZone = \'GRID\' | \'TRAY\';\n\nexport type ParticleIntensity = \'LOW\' | \'MEDIUM\' | \'HIGH\';\n\nexport type ThemeId =\n  | \'NEON_CYBER\'\n  | \'EMERALD_FLUX\'\n  | \'SOLAR_PULSE\'\n  | \'SYNTH_NOVA\'\n  | \'ASTRAL_GOLD\';\n\nexport type ParticleStyleId =\n  | \'CLASSIC_NEON\'\n  | \'PRISM_BURST\'\n  | \'SUPERNOVA_TRAIL\';\n\nexport type DailyDifficulty = \'STANDARD\' | \'HARD\' | \'EXPERT\';\n\nexport type DailyObjectiveType = \'SCORE\' | \'MAX_TILE\' | \'LINES\' | \'MERGES\';\n\nexport interface DailyChallengeConfig {\n  dateKey: string; // Local YYYY-MM-DD\n  seed: number;\n  title: string;\n  difficulty: DailyDifficulty;\n  objectiveType: DailyObjectiveType;\n  targetValue: number;\n  description: string;\n  rewardShards: number;\n  starterCells: { r: number; c: number; value: number }[];\n}\n\nexport interface DailyDayRecord {\n  dateKey: string;\n  completed: boolean;\n  rewardClaimed: boolean;\n  bestProgress: number;\n  bestScore: number;\n  attempts: number;\n  completedAt?: string;\n}\n\nexport interface DailySaveState {\n  currentStreak: number;\n  longestStreak: number;\n  lastCompletedDate: string | null;\n  totalShards: number;\n  records: Record<string, DailyDayRecord>;\n}\n\nexport interface ComboEvent {\n  id: string;\n  timestamp: string;\n  dateKey: string;\n  mode: GameMode;\n  multiplier: number;\n  score: number;\n  merges: number;\n  linesCleared: number;\n  topTile: number;\n  label: string;\n}\n\nexport interface ComboHistoryState {\n  highestMultiplier: number;\n  totalCombos: number;\n  highestComboScore: number;\n  events: ComboEvent[];\n}\n\nexport type RewardKind = \'BONUS_POINTS\' | \'THEME\' | \'PARTICLE_FX\' | \'BUNDLE\';\n\nexport interface DailyMilestoneDef {\n  day: 1 | 3 | 5 | 7 | 14 | 30;\n  title: string;\n  subtitle: string;\n  kind: RewardKind;\n  bonusPoints: number;\n  xpBonus: number;\n  themeUnlock?: ThemeId;\n  particleUnlock?: ParticleStyleId;\n}\n\nexport interface RecentRewardItem {\n  id: string;\n  title: string;\n  detail: string;\n  dateKey: string;\n  kind: \'MILESTONE\' | \'ACHIEVEMENT\' | \'LEVEL\' | \'DAILY_CHALLENGE\';\n}\n\nexport interface DailyRewardMilestoneState {\n  rewardStreak: number;\n  longestRewardStreak: number;\n  cycleDay: number; // 0..30 (current day reached in the 30-day cycle)\n  cycleCount: number; // number of completed 30-day cycles\n  lastClaimDate: string | null;\n  claimedMilestoneDays: number[]; // milestone days claimed in current cycle\n  pendingBonusPoints: number;\n  totalBonusPointsEarned: number;\n}\n\nexport type AchievementId =\n  | \'FIRST_GAME\'\n  | \'COMBO_STARTER\'\n  | \'COMBO_MASTER\'\n  | \'COMBO_COLLECTOR\'\n  | \'TILE_256\'\n  | \'TILE_1024\'\n  | \'LINE_SWEEPER\'\n  | \'DAILY_CHAMPION\'\n  | \'STREAK_WEEK\'\n  | \'LEVEL_FIVE\';\n\nexport interface AchievementDef {\n  id: AchievementId;\n  title: string;\n  description: string;\n  xpReward: number;\n  target: number;\n  metric:\n    | \'gamesCompleted\'\n    | \'highestMultiplier\'\n    | \'totalCombos\'\n    | \'highestTile\'\n    | \'totalLinesCleared\'\n    | \'dailyChallengesCompleted\'\n    | \'bestStreak\'\n    | \'level\';\n}\n\nexport interface PlayerLifetimeStats {\n  gamesCompleted: number;\n  totalScoreEarned: number;\n  highestTile: number;\n  totalMerges: number;\n  totalLinesCleared: number;\n  dailyChallengesCompleted: number;\n}\n\nexport interface PlayerProfileState {\n  version: number;\n  xp: number;\n  level: number;\n  selectedTheme: ThemeId;\n  selectedParticleStyle: ParticleStyleId;\n  unlockedThemes: ThemeId[];\n  unlockedParticleStyles: ParticleStyleId[];\n  unlockedAchievements: AchievementId[];\n  milestones: DailyRewardMilestoneState;\n  comboHistory: ComboHistoryState;\n  lifetime: PlayerLifetimeStats;\n  recentRewards: RecentRewardItem[];\n}\n\nexport interface GridCoord {\n  r: number;\n  c: number;\n}\n\nexport interface CellOffset {\n  dr: number;\n  dc: number;\n  value: number;\n}\n\nexport interface BlockPiece {\n  id: string;\n  shapeName: string;\n  cells: CellOffset[];\n  width: number;\n  height: number;\n}\n\nexport interface BoardTile {\n  id: number;\n  value: number;\n  scale: number;\n  targetScale: number;\n  offsetX: number;\n  offsetY: number;\n  flash: number;\n}\n\nexport type GridMatrix = (BoardTile | null)[][];\n\nexport interface MergeStep {\n  fromCells: GridCoord[];\n  targetCell: GridCoord;\n  oldValue: number;\n  newValue: number;\n  comboDepth: number;\n  points: number;\n}\n\nexport interface LineClearStep {\n  rows: number[];\n  cols: number[];\n  clearedCells: { r: number; c: number; value: number }[];\n  points: number;\n}\n\nexport interface PlacementPreview {\n  valid: boolean;\n  anchorRow: number;\n  anchorCol: number;\n  targetCells: GridCoord[];\n  willMergeCells: GridCoord[];\n  willClearRows: number[];\n  willClearCols: number[];\n}\n\nexport interface TurnResolution {\n  placedCells: GridCoord[];\n  placementPoints: number;\n  mergeSteps: MergeStep[];\n  lineClearStep: LineClearStep | null;\n  totalPointsGained: number;\n  maxComboDepth: number;\n  newMaxTile: number;\n  refilledTray: boolean;\n  isGameOver: boolean;\n}\n\nexport interface GameStats {\n  score: number;\n  bestScore: number;\n  maxTile: number;\n  mergesCount: number;\n  linesCleared: number;\n  bestCombo: number;\n  turnsPlayed: number;\n  isNewBest: boolean;\n}\n\nexport type ParticleShape = \'circle\' | \'spark\' | \'diamond\';\n\nexport interface Particle {\n  x: number;\n  y: number;\n  vx: number;\n  vy: number;\n  size: number;\n  color: string;\n  alpha: number;\n  life: number;\n  maxLife: number;\n  shape: ParticleShape;\n  gravity: number;\n  drag: number;\n}\n\nexport interface FireworkRocket {\n  x: number;\n  y: number;\n  vx: number;\n  vy: number;\n  targetY: number;\n  color: string;\n  trailTimer: number;\n}\n\nexport interface ShockwaveRing {\n  x: number;\n  y: number;\n  radius: number;\n  maxRadius: number;\n  color: string;\n  alpha: number;\n  life: number;\n  maxLife: number;\n  lineWidth: number;\n}\n\nexport interface LineBeam {\n  x: number;\n  y: number;\n  w: number;\n  h: number;\n  color: string;\n  life: number;\n  maxLife: number;\n}\n\nexport interface FloatingText {\n  x: number;\n  y: number;\n  vy: number;\n  text: string;\n  subtext?: string;\n  color: string;\n  life: number;\n  maxLife: number;\n  scale: number;\n}\n\nexport interface MergeGhostTile {\n  fromX: number;\n  fromY: number;\n  toX: number;\n  toY: number;\n  size: number;\n  value: number;\n  progress: number;\n  duration: number;\n}\n"
    num_lines: 380
