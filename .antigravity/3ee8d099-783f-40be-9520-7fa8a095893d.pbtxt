    content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    color-scheme: dark;\n    --font-display: \'Bahnschrift\', \'DIN Alternate\', \'SF Pro Display\', \'Segoe UI\', system-ui, -apple-system, sans-serif;\n    --font-sans: \'SF Pro Text\', \'Segoe UI\', system-ui, -apple-system, sans-serif;\n    --font-mono: \'JetBrains Mono\', \'SF Mono\', \'Consolas\', ui-monospace, monospace;\n  }\n\n  html,\n  body,\n  #root {\n    height: 100%;\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    overflow: hidden;\n    background-color: #050711;\n    color: #f1f5f9;\n    font-family: var(--font-sans);\n    -webkit-tap-highlight-color: transparent;\n    user-select: none;\n    -webkit-user-select: none;\n  }\n}\n\n.font-display {\n  font-family: var(--font-display);\n}\n\n.font-mono-nums {\n  font-family: var(--font-mono);\n  font-variant-numeric: tabular-nums;\n}\n\n.tabular-nums {\n  font-variant-numeric: tabular-nums;\n}\n\n/* Crisp D-Pad & Keyboard Focus Ring */\n.neon-focus:focus-visible {\n  outline: 2px solid #22d3ee;\n  outline-offset: 2px;\n  box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.25), 0 0 18px rgba(34, 211, 238, 0.45);\n}\n\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(6px) scale(0.985);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n@keyframes rewardPop {\n  0% {\n    opacity: 0;\n    transform: scale(0.88) translateY(10px);\n  }\n  70% {\n    opacity: 1;\n    transform: scale(1.03) translateY(-2px);\n  }\n  100% {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n\n@keyframes flameFlicker {\n  0%,\n  100% {\n    transform: scaleY(1) scaleX(1) translateY(0);\n    opacity: 0.96;\n  }\n  35% {\n    transform: scaleY(1.06) scaleX(0.96) translateY(-1.5px);\n    opacity: 1;\n  }\n  65% {\n    transform: scaleY(0.95) scaleX(1.03) translateY(0.5px);\n    opacity: 0.9;\n  }\n}\n\n@keyframes flameHalo {\n  0%,\n  100% {\n    transform: scale(0.96);\n    opacity: 0.45;\n  }\n  50% {\n    transform: scale(1.08);\n    opacity: 0.85;\n  }\n}\n\n/* Accessible large-target neon range slider for touch & Fire TV */\n.neon-slider {\n  -webkit-appearance: none;\n  appearance: none;\n  background: transparent;\n  cursor: pointer;\n  height: 44px;\n}\n\n.neon-slider::-webkit-slider-runnable-track {\n  height: 8px;\n  border-radius: 9999px;\n}\n\n.neon-slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  appearance: none;\n  width: 26px;\n  height: 26px;\n  margin-top: -9px;\n  border-radius: 9999px;\n  background: #ecfeff;\n  border: 3px solid #22d3ee;\n  box-shadow: 0 0 14px rgba(34, 211, 238, 0.75);\n  transition: transform 140ms ease, box-shadow 140ms ease;\n}\n\n.neon-slider:hover::-webkit-slider-thumb,\n.neon-slider:focus-visible::-webkit-slider-thumb {\n  transform: scale(1.1);\n  box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.25), 0 0 18px rgba(34, 211, 238, 0.9);\n}\n\n.neon-slider::-moz-range-track {\n  height: 8px;\n  border-radius: 9999px;\n}\n\n.neon-slider::-moz-range-thumb {\n  width: 26px;\n  height: 26px;\n  border-radius: 9999px;\n  background: #ecfeff;\n  border: 3px solid #22d3ee;\n  box-shadow: 0 0 14px rgba(34, 211, 238, 0.75);\n  transition: transform 140ms ease, box-shadow 140ms ease;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n"
    num_lines: 159
