        replacement_content: "export type DashboardTab =\n  | \'OVERVIEW\'\n  | \'STREAKS\'\n  | \'MILESTONES\'\n  | \'COMBOS\'\n  | \'ACHIEVEMENTS\';\n\nexport interface AudioSettingsState {\n  version: number;\n  sfxVolume: number; // 0..100 integer percentage, default 70\n  muted: boolean;\n}\n\nexport type StreakSource = \'DAILY_CHALLENGE\' | \'DAILY_REWARD\' | \'BOTH\';\n\nexport interface StreakSaveState {\n  version: number;\n  completedDates: string[]; // deduplicated sorted local YYYY-MM-DD dates\n  dateSources: Record<string, StreakSource>;\n  bestStreak: number;\n  lastRecordStreak: number;\n  lastRecordDate: string | null;\n}\n\nexport type CalendarDayStatus =\n  | \'COMPLETED\'\n  | \'MISSED\'\n  | \'TODAY_PENDING\'\n  | \'UPCOMING\';\n\nexport interface StreakCalendarDay {\n  dateKey: string;\n  dayNum: number;\n  dayShort: string;\n  monthShort: string;\n  year: number;\n  isMonthStart: boolean;\n  isToday: boolean;\n  status: CalendarDayStatus;\n  source?: StreakSource;\n  challengeCompleted: boolean;\n  rewardClaimed: boolean;\n  challengeAttempted: boolean;\n  progressPct: number;\n  bestScore: number;\n  challengeTitle: string;\n  readableDate: string;\n  projectedMilestone?: 3 | 7 | 14 | 30;\n}\n\nexport interface StreakMilestoneTier {\n  days: 3 | 7 | 14 | 30;\n  label: string;\n  subtitle: string;\n  reachedCurrent: boolean;\n  reachedEver: boolean;\n  progressPct: number;\n  daysRemaining: number;\n}\n\nexport type FocusZone = \'GRID\' | \'TRAY\';"
        start_line: 14
