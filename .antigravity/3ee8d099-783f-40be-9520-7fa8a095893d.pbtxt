            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Iterate twice so unlocking an achievement that grants Level 5 also unlocks LEVEL_FIVE"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  for (let pass = 0; pass < 2; pass++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let addedXp = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
