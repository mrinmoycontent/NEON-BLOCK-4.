            lines {
              text: "                <div className=\"space-y-1\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <h3 className=\"font-semibold text-cyan-300\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    1. Place Polyomino Blocks"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  </h3>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <p className=\"text-slate-400 leading-relaxed\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    Drag any of the 3 blocks from the tray onto empty spaces on the 6\303\2276 grid, or tap a block then tap the grid. Placing all 3 blocks deals a fresh tray."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <div className=\"space-y-1\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <h3 className=\"font-semibold text-blue-300\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    2. Connect 3+ Tiles to Merge"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  </h3>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <p className=\"text-slate-400 leading-relaxed\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    When 3 or more orthogonally connected tiles share the same number, they fuse into one doubled tile (<span className=\"font-mono-nums text-slate-200\">2 \342\206\222 4 \342\206\222 8 \342\206\222 16 \342\206\222 32...</span>). Cascading chain merges multiply your score!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <div className=\"space-y-1\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <h3 className=\"font-semibold text-purple-300\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    3. Fill Rows or Columns to Clear"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  </h3>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <p className=\"text-slate-400 leading-relaxed\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    Complete any full 6-tile row or column to trigger a plasma beam clear, awarding bonus points and freeing space on the board."
