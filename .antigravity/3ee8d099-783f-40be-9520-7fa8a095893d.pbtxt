      original_chunk {
        target_content: "    const startNewGame = () => {\n      const sim = simRef.current;\n      const freshGrid = createEmptyGrid();\n      const freshTray = generateTray(freshGrid);\n\n      sim.grid = freshGrid;\n      sim.tray = freshTray;\n      sim.selectedSlot = 0;\n      sim.preview = null;\n      sim.drag = null;\n      sim.pointerDownPos = null;\n      sim.particles = [];\n      sim.shockwaves = [];\n      sim.beams = [];\n      sim.floatingTexts = [];\n      sim.mergeGhosts = [];\n      sim.shakeTimer = 0;\n      sim.shakeIntensity = 0;\n      sim.cursor = {\n        visible: false,\n        zone: \'GRID\',\n        gridRow: 2,\n        gridCol: 2,\n        traySlot: 0,\n      };\n      sim.stats = {\n        score: 0,\n        bestScore: bestScoreRef.current,\n        maxTile: 0,\n        mergesCount: 0,\n        linesCleared: 0,\n        bestCombo: 0,\n        turnsPlayed: 0,\n        isNewBest: false,\n      };\n\n      onStatsChange({ ...sim.stats });\n      onComboEvent(\'\');\n    };\n\n    useImperativeHandle(ref, () => ({\n      startNewGame,\n      focusBoard: () => {\n        canvasRef.current?.focus();\n        const sim = simRef.current;\n        sim.cursor.visible = true;\n        sim.cursor.zone = \'GRID\';\n        updateCursorPreview();\n      },\n    }));\n\n    const spawnVfxForResolution = (res: TurnResolution) => {\n      const sim = simRef.current;\n      const layout = layoutRef.current;\n      const rm = reducedMotionRef.current;\n\n      // Placement subtle sparks\n      if (!rm) {\n        for (const pt of res.placedCells) {\n          const rect = getCellRect(layout, pt.r, pt.c);\n          const cx = rect.x + rect.w / 2;\n          const cy = rect.y + rect.h / 2;\n          for (let i = 0; i < 4; i++) {\n            const ang = (Math.PI * 2 * i) / 4 + Math.random() * 0.6;\n            const spd = 40 + Math.random() * 70;\n            sim.particles.push({\n              x: cx,\n              y: cy,\n              vx: Math.cos(ang) * spd,\n              vy: Math.sin(ang) * spd,\n              size: 2 + Math.random() * 1.5,\n              color: \'#38BDF8\',\n              alpha: 0.9,\n              life: 0.35,\n              maxLife: 0.35,\n            });\n          }\n        }\n      }\n\n      // Merge VFX\n      for (const merge of res.mergeSteps) {\n        const targetRect = getCellRect(layout, merge.targetCell.r, merge.targetCell.c);\n        const tx = targetRect.x + targetRect.w / 2;\n        const ty = targetRect.y + targetRect.h / 2;\n        const pal = getTilePalette(merge.newValue);\n\n        if (!rm) {\n          for (const fc of merge.fromCells) {\n            const fromRect = getCellRect(layout, fc.r, fc.c);\n            sim.mergeGhosts.push({\n              fromX: fromRect.x,\n              fromY: fromRect.y,\n              toX: targetRect.x,\n              toY: targetRect.y,\n              size: targetRect.w,\n              value: merge.oldValue,\n              progress: 0,\n              duration: 0.14,\n            });\n          }\n\n          sim.shockwaves.push({\n            x: tx,\n            y: ty,\n            radius: targetRect.w * 0.25,\n            maxRadius: targetRect.w * (1.25 + merge.comboDepth * 0.2),\n            color: pal.border,\n            alpha: 0.9,\n            life: 0.34,\n            maxLife: 0.34,\n            lineWidth: 3,\n          });\n\n          const burstCount = Math.min(24, 10 + merge.comboDepth * 4);\n          for (let i = 0; i < burstCount; i++) {\n            const ang = Math.random() * Math.PI * 2;\n            const spd = 70 + Math.random() * 170;\n            sim.particles.push({\n              x: tx,\n              y: ty,\n              vx: Math.cos(ang) * spd,\n              vy: Math.sin(ang) * spd,\n              size: 2.2 + Math.random() * 2.5,\n              color: i % 2 === 0 ? pal.border : \'#E0F2FE\',\n              alpha: 1,\n              life: 0.45 + Math.random() * 0.2,\n              maxLife: 0.65,\n            });\n          }\n        }\n\n        sim.floatingTexts.push({\n          x: tx,\n          y: ty - 8,\n          vy: -42,\n          text: `+${merge.points}`,\n          subtext: merge.comboDepth > 1 ? `CHAIN \303\227${merge.comboDepth}` : `MERGE ${merge.newValue}`,\n          color: pal.border,\n          life: 0.95,\n          maxLife: 0.95,\n          scale: merge.comboDepth > 1 ? 1.15 : 1,\n        });\n      }\n\n      // Line Clear VFX\n      if (res.lineClearStep) {\n        const { rows, cols, points } = res.lineClearStep;\n        const { boardRect, cellSize } = layout;\n\n        for (const r of rows) {\n          const first = getCellRect(layout, r, 0);\n          sim.beams.push({\n            x: boardRect.x + 6,\n            y: first.y + cellSize * 0.18,\n            w: boardRect.w - 12,\n            h: cellSize * 0.64,\n            color: \'rgba(34, 211, 238, 0.85)\',\n            life: 0.36,\n            maxLife: 0.36,\n          });\n        }\n        for (const c of cols) {\n          const first = getCellRect(layout, 0, c);\n          sim.beams.push({\n            x: first.x + cellSize * 0.18,\n            y: boardRect.y + 6,\n            w: cellSize * 0.64,\n            h: boardRect.h - 12,\n            color: \'rgba(192, 132, 252, 0.85)\',\n            life: 0.36,\n            maxLife: 0.36,\n          });\n        }\n\n        if (!rm) {\n          for (const cell of res.lineClearStep.clearedCells) {\n            const rect = getCellRect(layout, cell.r, cell.c);\n            const cx = rect.x + rect.w / 2;\n            const cy = rect.y + rect.h / 2;\n            const pal = getTilePalette(cell.value);\n            for (let i = 0; i < 6; i++) {\n              const ang = Math.random() * Math.PI * 2;\n              const spd = 80 + Math.random() * 180;\n              sim.particles.push({\n                x: cx,\n                y: cy,\n                vx: Math.cos(ang) * spd,\n                vy: Math.sin(ang) * spd,\n                size: 2.5 + Math.random() * 2,\n                color: pal.border,\n                alpha: 1,\n                life: 0.5,\n                maxLife: 0.5,\n              });\n            }\n          }\n        }\n\n        const totalLines = rows.length + cols.length;\n        sim.floatingTexts.push({\n          x: boardRect.x + boardRect.w / 2,\n          y: boardRect.y + boardRect.h / 2,\n          vy: -36,\n          text: `+${points}`,\n          subtext: totalLines > 1 ? `MEGA CLEAR \303\227${totalLines}` : \'LINE CLEAR\',\n          color: \'#67E8F9\',\n          life: 1.05,\n          maxLife: 1.05,\n          scale: 1.2,\n        });\n      }\n\n      // Micro camera shake on big combos or line clears\n      if (!rm && (res.maxComboDepth >= 2 || res.lineClearStep)) {\n        sim.shakeTimer = 0.2;\n        sim.shakeIntensity = Math.min(9, 3 + res.maxComboDepth * 2 + (res.lineClearStep ? 2.5 : 0));\n      }\n    };\n\n    const executePlacement = (slotIndex: number, anchorRow: number, anchorCol: number): boolean => {\n      const sim = simRef.current;\n      const piece = sim.tray[slotIndex];\n      if (!piece) return false;\n\n      const clampedR = Math.max(0, Math.min(GRID_SIZE - piece.height, anchorRow));\n      const clampedC = Math.max(0, Math.min(GRID_SIZE - piece.width, anchorCol));\n\n      const res = applyPiecePlacement(sim.grid, sim.tray, slotIndex, clampedR, clampedC);\n      if (!res) {\n        neonAudio.playInvalid();\n        return false;\n      }\n\n      neonAudio.playPlace();\n\n      if (res.mergeSteps.length > 0) {\n        const lastMerge = res.mergeSteps[res.mergeSteps.length - 1];\n        setTimeout(() => {\n          neonAudio.playMerge(res.maxComboDepth, lastMerge.newValue);\n        }, 45);\n      }\n\n      if (res.lineClearStep) {\n        const totalLines = res.lineClearStep.rows.length + res.lineClearStep.cols.length;\n        setTimeout(() => {\n          neonAudio.playLineClear(totalLines);\n        }, 70);\n      }\n\n      if (res.refilledTray && !res.isGameOver) {\n        setTimeout(() => {\n          neonAudio.playNewTray();\n        }, 140);\n      }\n\n      spawnVfxForResolution(res);\n\n      // Update stats\n      const prevBest = sim.stats.bestScore;\n      const newScore = sim.stats.score + res.totalPointsGained;\n      const newBestScore = Math.max(prevBest, newScore);\n      const brokeRecord = newScore > prevBest && prevBest > 0;\n\n      if (brokeRecord && !sim.stats.isNewBest) {\n        neonAudio.playNewBest();\n      }"
        replacement_content: "    const getIntensityScale = (): number => {\n      if (reducedMotionRef.current) return 0;\n      switch (intensityRef.current) {\n        case \'LOW\':\n          return 0.42;\n        case \'MEDIUM\':\n          return 0.72;\n        case \'HIGH\':\n        default:\n          return 1.0;\n      }\n    };\n\n    const getMaxParticleBudget = (): number => {\n      if (reducedMotionRef.current) return 0;\n      switch (intensityRef.current) {\n        case \'LOW\':\n          return 90;\n        case \'MEDIUM\':\n          return 185;\n        case \'HIGH\':\n        default:\n          return 360;\n      }\n    };\n\n    const pushParticle = (p: Particle): void => {\n      const budget = getMaxParticleBudget();\n      if (budget <= 0) return;\n      const particles = simRef.current.particles;\n      if (particles.length >= budget) {\n        particles.shift();\n      }\n      particles.push(p);\n    };\n\n    const launchFireworks = (count = 4): void => {\n      if (reducedMotionRef.current) return;\n      const sim = simRef.current;\n      const layout = layoutRef.current;\n      const colors = [\'#22D3EE\', \'#60A5FA\', \'#C084FC\', \'#E879F9\', \'#67E8F9\'];\n      const actualCount = Math.max(2, Math.round(count * getIntensityScale()));\n\n      for (let i = 0; i < actualCount; i++) {\n        const delayMs = i * 150;\n        window.setTimeout(() => {\n          const w = layoutRef.current.width;\n          const h = layoutRef.current.height;\n          const startX = w * (0.18 + Math.random() * 0.64);\n          const targetY = h * (0.14 + Math.random() * 0.28);\n          sim.fireworks.push({\n            x: startX,\n            y: h + 12,\n            vx: (Math.random() - 0.5) * 65,\n            vy: -(480 + Math.random() * 140),\n            targetY,\n            color: colors[i % colors.length],\n            trailTimer: 0,\n          });\n        }, delayMs);\n      }\n    };\n\n    const detonateFirework = (fw: FireworkRocket): void => {\n      const sim = simRef.current;\n      const scale = getIntensityScale();\n      if (scale <= 0) return;\n\n      neonAudio.playFireworkBurst();\n\n      const palette = [fw.color, \'#E0F2FE\', \'#A855F7\', \'#38BDF8\'];\n      const count = Math.max(14, Math.round(34 * scale));\n      const shapes: ParticleShape[] = [\'spark\', \'diamond\', \'circle\'];\n\n      sim.shockwaves.push({\n        x: fw.x,\n        y: fw.y,\n        radius: 6,\n        maxRadius: 95,\n        color: fw.color,\n        alpha: 0.85,\n        life: 0.36,\n        maxLife: 0.36,\n        lineWidth: 2.5,\n      });\n\n      for (let i = 0; i < count; i++) {\n        const ang = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.18;\n        const spd = 95 + Math.random() * 210;\n        const life = 0.65 + Math.random() * 0.45;\n        pushParticle({\n          x: fw.x,\n          y: fw.y,\n          vx: Math.cos(ang) * spd,\n          vy: Math.sin(ang) * spd - 20,\n          size: 2.2 + Math.random() * 2.2,\n          color: palette[i % palette.length],\n          alpha: 1,\n          life,\n          maxLife: life,\n          shape: shapes[i % shapes.length],\n          gravity: 165,\n          drag: 0.96,\n        });\n      }\n    };\n\n    const startNewGame = (options?: StartGameOptions) => {\n      const sim = simRef.current;\n      const daily = options?.dailyChallenge;\n      const rng = daily ? createSeededRng(daily.seed + 101) : Math.random;\n      const freshGrid = daily\n        ? createDailyStarterGrid(daily.starterCells)\n        : createEmptyGrid();\n      const freshTray = generateTray(freshGrid, rng);\n\n      sim.rng = rng;\n      sim.grid = freshGrid;\n      sim.tray = freshTray;\n      sim.selectedSlot = 0;\n      sim.preview = null;\n      sim.drag = null;\n      sim.pointerDownPos = null;\n      sim.particles = [];\n      sim.fireworks = [];\n      sim.shockwaves = [];\n      sim.beams = [];\n      sim.floatingTexts = [];\n      sim.mergeGhosts = [];\n      sim.shakeTimer = 0;\n      sim.shakeIntensity = 0;\n      sim.cursor = {\n        visible: false,\n        zone: \'GRID\',\n        gridRow: 2,\n        gridCol: 2,\n        traySlot: 0,\n      };\n      sim.stats = {\n        score: 0,\n        bestScore: bestScoreRef.current,\n        maxTile: getMaxTileOnGrid(freshGrid),\n        mergesCount: 0,\n        linesCleared: 0,\n        bestCombo: 0,\n        turnsPlayed: 0,\n        isNewBest: false,\n      };\n\n      onStatsChange({ ...sim.stats });\n      onComboEvent(\'\');\n    };\n\n    useImperativeHandle(ref, () => ({\n      startNewGame,\n      focusBoard: () => {\n        canvasRef.current?.focus();\n        const sim = simRef.current;\n        sim.cursor.visible = true;\n        sim.cursor.zone = \'GRID\';\n        updateCursorPreview();\n      },\n      triggerFireworks: (count = 5) => {\n        launchFireworks(count);\n      },\n    }));\n\n    // Keep ambient floating motes count responsive to ParticleIntensity setting\n    useEffect(() => {\n      const targetMotes = reducedMotion\n        ? 6\n        : particleIntensity === \'LOW\'\n          ? 10\n          : particleIntensity === \'MEDIUM\'\n            ? 20\n            : 34;\n      const layout = layoutRef.current;\n      simRef.current.motes = createAmbientMotes(targetMotes, layout.width, layout.height);\n    }, [particleIntensity, reducedMotion]);\n\n    const spawnVfxForResolution = (res: TurnResolution) => {\n      const sim = simRef.current;\n      const layout = layoutRef.current;\n      const rm = reducedMotionRef.current;\n      const pScale = getIntensityScale();\n\n      // Placement subtle sparks\n      if (!rm && pScale > 0) {\n        const sparksPerCell = Math.max(2, Math.round(5 * pScale));\n        for (const pt of res.placedCells) {\n          const rect = getCellRect(layout, pt.r, pt.c);\n          const cx = rect.x + rect.w / 2;\n          const cy = rect.y + rect.h / 2;\n          for (let i = 0; i < sparksPerCell; i++) {\n            const ang = (Math.PI * 2 * i) / sparksPerCell + Math.random() * 0.5;\n            const spd = 45 + Math.random() * 80;\n            pushParticle({\n              x: cx,\n              y: cy,\n              vx: Math.cos(ang) * spd,\n              vy: Math.sin(ang) * spd,\n              size: 1.8 + Math.random() * 1.4,\n              color: \'#38BDF8\',\n              alpha: 0.9,\n              life: 0.32,\n              maxLife: 0.32,\n              shape: \'spark\',\n              gravity: 0,\n              drag: 0.92,\n            });\n          }\n        }\n      }\n\n      // Merge VFX & Colorful Combo Explosions\n      const comboColors = [\'#22D3EE\', \'#60A5FA\', \'#A855F7\', \'#E879F9\', \'#F0ABFC\', \'#E0F2FE\'];\n      for (const merge of res.mergeSteps) {\n        const targetRect = getCellRect(layout, merge.targetCell.r, merge.targetCell.c);\n        const tx = targetRect.x + targetRect.w / 2;\n        const ty = targetRect.y + targetRect.h / 2;\n        const pal = getTilePalette(merge.newValue);\n        const isCombo = merge.comboDepth >= 2;\n\n        if (!rm) {\n          for (const fc of merge.fromCells) {\n            const fromRect = getCellRect(layout, fc.r, fc.c);\n            sim.mergeGhosts.push({\n              fromX: fromRect.x,\n              fromY: fromRect.y,\n              toX: targetRect.x,\n              toY: targetRect.y,\n              size: targetRect.w,\n              value: merge.oldValue,\n              progress: 0,\n              duration: 0.14,\n            });\n          }\n\n          sim.shockwaves.push({\n            x: tx,\n            y: ty,\n            radius: targetRect.w * 0.25,\n            maxRadius: targetRect.w * (1.3 + merge.comboDepth * 0.25),\n            color: pal.border,\n            alpha: 0.92,\n            life: 0.36,\n            maxLife: 0.36,\n            lineWidth: isCombo ? 3.5 : 2.5,\n          });\n\n          if (isCombo) {\n            sim.shockwaves.push({\n              x: tx,\n              y: ty,\n              radius: targetRect.w * 0.15,\n              maxRadius: targetRect.w * (1.85 + merge.comboDepth * 0.35),\n              color: \'#E879F9\',\n              alpha: 0.85,\n              life: 0.44,\n              maxLife: 0.44,\n              lineWidth: 2,\n            });\n          }\n\n          if (pScale > 0) {\n            const baseBurst = isCombo ? 24 + merge.comboDepth * 8 : 14;\n            const burstCount = Math.max(5, Math.round(baseBurst * pScale));\n            for (let i = 0; i < burstCount; i++) {\n              const ang = Math.random() * Math.PI * 2;\n              const spd = (isCombo ? 105 : 75) + Math.random() * (isCombo ? 220 : 165);\n              const life = 0.44 + Math.random() * 0.28;\n              const color = isCombo\n                ? comboColors[i % comboColors.length]\n                : i % 3 === 0\n                  ? \'#E0F2FE\'\n                  : pal.border;\n              const shape: ParticleShape =\n                i % 3 === 0 ? \'diamond\' : i % 2 === 0 ? \'spark\' : \'circle\';\n\n              pushParticle({\n                x: tx,\n                y: ty,\n                vx: Math.cos(ang) * spd,\n                vy: Math.sin(ang) * spd,\n                size: 2.2 + Math.random() * (isCombo ? 2.8 : 2.1),\n                color,\n                alpha: 1,\n                life,\n                maxLife: life,\n                shape,\n                gravity: isCombo ? 85 : 0,\n                drag: 0.93,\n              });\n            }\n          }\n        }\n\n        sim.floatingTexts.push({\n          x: tx,\n          y: ty - 8,\n          vy: -44,\n          text: `+${merge.points}`,\n          subtext: merge.comboDepth > 1 ? `CHAIN \303\227${merge.comboDepth}` : `MERGE ${merge.newValue}`,\n          color: pal.border,\n          life: 0.98,\n          maxLife: 0.98,\n          scale: merge.comboDepth > 1 ? 1.18 : 1,\n        });\n      }\n\n      // Line Clear VFX (Glowing Shockwaves + Plasma Beams + Sparks)\n      if (res.lineClearStep) {\n        const { rows, cols, points } = res.lineClearStep;\n        const { boardRect, cellSize } = layout;\n\n        for (const r of rows) {\n          const first = getCellRect(layout, r, 0);\n          sim.beams.push({\n            x: boardRect.x + 6,\n            y: first.y + cellSize * 0.18,\n            w: boardRect.w - 12,\n            h: cellSize * 0.64,\n            color: \'rgba(34, 211, 238, 0.88)\',\n            life: 0.38,\n            maxLife: 0.38,\n          });\n          if (!rm) {\n            sim.shockwaves.push({\n              x: boardRect.x + boardRect.w / 2,\n              y: first.y + cellSize / 2,\n              radius: cellSize * 0.5,\n              maxRadius: boardRect.w * 0.68,\n              color: \'#22D3EE\',\n              alpha: 0.8,\n              life: 0.42,\n              maxLife: 0.42,\n              lineWidth: 2.5,\n            });\n          }\n        }\n        for (const c of cols) {\n          const first = getCellRect(layout, 0, c);\n          sim.beams.push({\n            x: first.x + cellSize * 0.18,\n            y: boardRect.y + 6,\n            w: cellSize * 0.64,\n            h: boardRect.h - 12,\n            color: \'rgba(192, 132, 252, 0.88)\',\n            life: 0.38,\n            maxLife: 0.38,\n          });\n          if (!rm) {\n            sim.shockwaves.push({\n              x: first.x + cellSize / 2,\n              y: boardRect.y + boardRect.h / 2,\n              radius: cellSize * 0.5,\n              maxRadius: boardRect.h * 0.68,\n              color: \'#C084FC\',\n              alpha: 0.8,\n              life: 0.42,\n              maxLife: 0.42,\n              lineWidth: 2.5,\n            });\n          }\n        }\n\n        if (!rm && pScale > 0) {\n          const perCell = Math.max(2, Math.round(7 * pScale));\n          for (const cell of res.lineClearStep.clearedCells) {\n            const rect = getCellRect(layout, cell.r, cell.c);\n            const cx = rect.x + rect.w / 2;\n            const cy = rect.y + rect.h / 2;\n            const pal = getTilePalette(cell.value);\n            for (let i = 0; i < perCell; i++) {\n              const ang = Math.random() * Math.PI * 2;\n              const spd = 90 + Math.random() * 195;\n              const life = 0.48 + Math.random() * 0.22;\n              pushParticle({\n                x: cx,\n                y: cy,\n                vx: Math.cos(ang) * spd,\n                vy: Math.sin(ang) * spd,\n                size: 2.3 + Math.random() * 2.1,\n                color: i % 2 === 0 ? pal.border : \'#67E8F9\',\n                alpha: 1,\n                life,\n                maxLife: life,\n                shape: i % 2 === 0 ? \'spark\' : \'diamond\',\n                gravity: 40,\n                drag: 0.93,\n              });\n            }\n          }\n        }\n\n        const totalLines = rows.length + cols.length;\n        sim.floatingTexts.push({\n          x: boardRect.x + boardRect.w / 2,\n          y: boardRect.y + boardRect.h / 2,\n          vy: -38,\n          text: `+${points}`,\n          subtext: totalLines > 1 ? `MEGA CLEAR \303\227${totalLines}` : \'LINE CLEAR\',\n          color: \'#67E8F9\',\n          life: 1.08,\n          maxLife: 1.08,\n          scale: 1.22,\n        });\n      }\n\n      // Subtle screen shake for major combos or multi-line clears\n      if (!rm && (res.maxComboDepth >= 2 || res.lineClearStep)) {\n        sim.shakeTimer = 0.22;\n        sim.shakeIntensity = Math.min(\n          10,\n          3 + res.maxComboDepth * 2.1 + (res.lineClearStep ? 2.5 : 0)\n        );\n      }\n    };\n\n    const executePlacement = (slotIndex: number, anchorRow: number, anchorCol: number): boolean => {\n      const sim = simRef.current;\n      const piece = sim.tray[slotIndex];\n      if (!piece) return false;\n\n      const clampedR = Math.max(0, Math.min(GRID_SIZE - piece.height, anchorRow));\n      const clampedC = Math.max(0, Math.min(GRID_SIZE - piece.width, anchorCol));\n\n      const res = applyPiecePlacement(\n        sim.grid,\n        sim.tray,\n        slotIndex,\n        clampedR,\n        clampedC,\n        sim.rng\n      );\n      if (!res) {\n        neonAudio.playInvalid();\n        return false;\n      }\n\n      neonAudio.playPlace();\n\n      if (res.mergeSteps.length > 0) {\n        const lastMerge = res.mergeSteps[res.mergeSteps.length - 1];\n        setTimeout(() => {\n          neonAudio.playMerge(res.maxComboDepth, lastMerge.newValue);\n        }, 55);\n      }\n\n      if (res.lineClearStep) {\n        const totalLines = res.lineClearStep.rows.length + res.lineClearStep.cols.length;\n        setTimeout(() => {\n          neonAudio.playLineClear(totalLines);\n        }, 85);\n      }\n\n      if (res.refilledTray && !res.isGameOver) {\n        setTimeout(() => {\n          neonAudio.playNewTray();\n        }, 150);\n      }\n\n      spawnVfxForResolution(res);\n\n      // Update stats & High-Score Fireworks Celebration\n      const prevBest = sim.stats.bestScore;\n      const newScore = sim.stats.score + res.totalPointsGained;\n      const newBestScore = Math.max(prevBest, newScore);\n      const brokeRecord = newScore > prevBest && prevBest > 0;\n\n      if (brokeRecord && !sim.stats.isNewBest) {\n        neonAudio.playNewBest();\n        launchFireworks(5);\n        onComboEvent(\'NEW BEST SCORE\');\n      }"
