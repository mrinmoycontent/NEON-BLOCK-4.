Ref = useRef(gameMode);\n  gameModeRef.current = gameMode;\n  const dailyChallengeRef = useRef(dailyChallenge);\n  dailyChallengeRef.current = dailyChallenge;\n  const todayKeyRef = useRef(todayKey);\n  todayKeyRef.current = todayKey;"
