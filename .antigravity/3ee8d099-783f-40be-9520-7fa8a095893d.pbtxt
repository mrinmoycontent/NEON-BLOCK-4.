            lines {
              text: "): { r: number; c: number } | null {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const originX = layout.boardRect.x + layout.boardInnerPad;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const originY = layout.boardRect.y + layout.boardInnerPad;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const step = layout.cellSize + layout.cellGap;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
