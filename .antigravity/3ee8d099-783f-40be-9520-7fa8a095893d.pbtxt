  planner_response {
    thinking: "**Integrating Daily Challenge**\n\nI\'m currently focused on integrating the daily challenge functionality within `/src/App.tsx`. Specifically, I\'m working on computing and handling `dailyChallenge` using `generateDailyChallenge()`. I\'m also addressing the date key refresh to ensure the challenge is updated correctly, especially for users who keep the app open across midnight or open the Daily Screen. Storing is the next step.\n\n\n**Refining Daily Functionality**\n\nI\'m now diving deeper into daily challenge rewards and UI integration. My main focus is on implementing the `updateDailyProgressAndReward()` function to manage daily progress and rewards within `handleStatsChange()`. This includes seamlessly integrating the celebratory fireworks and audio cues (`neonAudio.playDailyComplete()`) and non-blocking toast banner upon completion. I\'m also adding a dedicated \"Daily Challenge\" button to the title screen, sidebar, and pause modal for easy access and streak display.\n\n\n**Implementing Game Over Updates**\n\nI\'m now focusing on the Game Over modal updates, especially when a Daily Challenge is in play. I\'ll display the daily objective status, streak, shards earned, and options to replay, go to the Daily Hub, or return to Classic Mode. I\'m also adding particle intensity settings using a clean segmented control in both the landscape sidebar and the pause modal. I\'m persisting the selected particle intensity using local storage. Lastly, I\'ll add smooth screen transitions to improve the user experience.\n\n\n"
    tool_calls {
      id: "call_11355064725854785888"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\\nimport {\\n  Calendar,\\n  CheckCircle2,\\n  Flame,\\n  HelpCircle,\\n  Pause,\\n  Play,\\n  RotateCcw,\\n  Sparkles,\\n  Volume2,\\n  VolumeX,\\n  X,\\n} from \'lucide-react\';\\nimport { DailyChallengeScreen } from \'./components/DailyChallengeScreen\';\\nimport { NeonCanvas, NeonCanvasHandle } from \'./components/NeonCanvas\';\\nimport { NeonLogo } from \'./components/NeonLogo\';\\nimport { neonAudio } from \'./game/audio\';\\nimport {\\n  evaluateDailyProgress,\\n  generateDailyChallenge,\\n  getEffectiveStreak,\\n  getLocalDateKey,\\n  loadDailySaveState,\\n  loadParticleIntensity,\\n  recordDailyAttempt,\\n  saveParticleIntensity,\\n  updateDailyProgressAndReward,\\n} from \'./game/daily\';\\nimport {\\n  loadBestScore,\\n  loadMutedPref,\\n  saveBestScore,\\n  saveMutedPref,\\n} from \'./game/engine\';\\nimport {\\n  DailySaveState,\\n  GameMode,\\n  GameStats,\\n  GameStatus,\\n  ParticleIntensity,\\n} from \'./game/types\';\\n\\nexport default function App() {\\n  const canvasHandleRef = useRef<NeonCanvasHandle>(null);\\n  const hudFirstBtnRef = useRef<HTMLButtonElement>(null);\\n  const hudButtonRefs = useRef<(HTMLButtonElement | null)[]>([]);\\n  const startBtnRef = useRef<HTMLButtonElement>(null);\\n  const playAgainBtnRef = useRef<HTMLButtonElement>(null);\\n  const resumeBtnRef = useRef<HTMLButtonElement>(null);\\n  const closeHelpBtnRef = useRef<HTMLButtonElement>(null);\\n\\n  const [status, setStatus] = useState<GameStatus>(\'TITLE_MENU\');\\n  const [gameMode, setGameMode] = useState<GameMode>(\'CLASSIC\');\\n  const [showHelp, setShowHelp] = useState(false);\\n\\n  const [muted, setMuted] = useState<boolean>(() => {\\n    const pref = loadMutedPref();\\n    neonAudio.setMuted(pref);\\n    return pref;\\n  });\\n\\n  const [particleIntensity, setParticleIntensity] = useState<ParticleIntensity>(\\n    () => loadParticleIntensity()\\n  );\\n\\n  const [bestScore, setBestScore] = useState<number>(() => loadBestScore());\\n  const [comboLabel, setComboLabel] = useState<string>(\'\');\\n  const comboTimerRef = useRef<number | null>(null);\\n\\n  const [todayKey, setTodayKey] = useState<string>(() => getLocalDateKey());\\n  const dailyChallenge = useMemo(\\n    () => generateDailyChallenge(todayKey),\\n    [todayKey]\\n  );\\n  const [dailyState, setDailyState] = useState<DailySaveState>(() =>\\n    loadDailySaveState()\\n  );\\n  const [dailyBanner, setDailyBanner] = useState<string>(\'\');\\n  const dailyBannerTimerRef = useRef<number | null>(null);\\n  const [dailyRunCompleted, setDailyRunCompleted] = useState(false);\\n  const [dailyRunShards, setDailyRunShards] = useState(0);\\n\\n  const dailyStateRef = useRef(dailyState);\\n  dailyStateRef.current = dailyState;\\n  const gameModeRef = useRef(gameMode);\\n  gameModeRef.current = gameMode;\\n  const dailyChallengeRef = useRef(dailyChallenge);\\n  dailyChallengeRef.current = dailyChallenge;\\n\\n  const [reducedMotion, setReducedMotion] = useState<boolean>(() => {\\n    if (typeof window === \'undefined\' || !window.matchMedia) return false;\\n    return window.matchMedia(\'(prefers-reduced-motion: reduce)\').matches;\\n  });\\n\\n  const [stats, setStats] = useState<GameStats>(() => ({\\n    score: 0,\\n    bestScore: loadBestScore(),\\n    maxTile: 0,\\n    mergesCount: 0,\\n    linesCleared: 0,\\n    bestCombo: 0,\\n    turnsPlayed: 0,\\n    isNewBest: false,\\n  }));\\n\\n  useEffect(() => {\\n    if (typeof window === \'undefined\' || !window.matchMedia) return;\\n    const mq = window.matchMedia(\'(prefers-reduced-motion: reduce)\');\\n    const onChange = () => setReducedMotion(mq.matches);\\n    mq.addEventListener(\'change\', onChange);\\n    return () => mq.removeEventListener(\'change\', onChange);\\n  }, []);\\n\\n  // Keep local calendar date fresh if session spans midnight\\n  useEffect(() => {\\n    const id = window.setInterval(() => {\\n      const current = getLocalDateKey();\\n      if (current !== todayKey) {\\n        setTodayKey(current);\\n      }\\n    }, 30000);\\n    return () => window.clearInterval(id);\\n  }, [todayKey]);\\n\\n  const handleParticleIntensityChange = useCallback(\\n    (level: ParticleIntensity) => {\\n      neonAudio.unlock();\\n      neonAudio.playSelect();\\n      setParticleIntensity(level);\\n      saveParticleIntensity(level);\\n    },\\n    []\\n  );\\n\\n  const showDailyCelebration = useCallback((msg: string) => {\\n    if (dailyBannerTimerRef.current) {\\n      window.clearTimeout(dailyBannerTimerRef.current);\\n    }\\n    setDailyBanner(msg);\\n    dailyBannerTimerRef.current = window.setTimeout(() => {\\n      setDailyBanner(\'\');\\n    }, 3600);\\n  }, []);\\n\\n  const handleStatsChange = useCallback(\\n    (nextStats: GameStats) => {\\n      setStats(nextStats);\\n      if (nextStats.bestScore > bestScore) {\\n        setBestScore(nextStats.bestScore);\\n        saveBestScore(nextStats.bestScore);\\n      }\\n\\n      if (gameModeRef.current === \'DAILY\') {\\n        const challenge = dailyChallengeRef.current;\\n        const result = updateDailyProgressAndReward(\\n          dailyStateRef.current,\\n          challenge,\\n          nextStats\\n        );\\n        dailyStateRef.current = result.nextState;\\n        setDailyState(result.nextState);\\n\\n        if (result.newlyCompleted) {\\n          setDailyRunCompleted(true);\\n          setDailyRunShards(result.shardsAwarded);\\n          neonAudio.playDailyComplete();\\n          canvasHandleRef.current?.triggerFireworks(6);\\n          showDailyCelebration(\\n            `Daily Complete \302\267 +${result.shardsAwarded} Shards`\\n          );\\n        } else {\\n          const evalRes = evaluateDailyProgress(challenge, nextStats);\\n          if (evalRes.isComplete) {\\n            setDailyRunCompleted(true);\\n          }\\n        }\\n      }\\n    },\\n    [bestScore, showDailyCelebration]\\n  );\\n\\n  const handleComboEvent = useCallback((label: string) => {\\n    if (comboTimerRef.current) {\\n      window.clearTimeout(comboTimerRef.current);\\n    }\\n    setComboLabel(label);\\n    if (label) {\\n      comboTimerRef.current = window.setTimeout(() => {\\n        setComboLabel(\'\');\\n      }, 1500);\\n    }\\n  }, []);\\n\\n  const startClassicGame = useCallback(() => {\\n    neonAudio.unlock();\\n    neonAudio.playSelect();\\n    setShowHelp(false);\\n    setGameMode(\'CLASSIC\');\\n    setDailyRunCompleted(false);\\n    setDailyRunShards(0);\\n    setDailyBanner(\'\');\\n    setStatus(\'PLAYING\');\\n    canvasHandleRef.current?.startNewGame();\\n    window.setTimeout(() => {\\n      canvasHandleRef.current?.focusBoard();\\n    }, 30);\\n  }, []);\\n\\n  const startDailyGame = useCallback(() => {\\n    const currentKey = getLocalDateKey();\\n    if (currentKey !== todayKey) {\\n      setTodayKey(currentKey);\\n    }\\n    const freshChallenge = generateDailyChallenge(currentKey);\\n    neonAudio.unlock();\\n    neonAudio.playSelect();\\n    setShowHelp(false);\\n    setGameMode(\'DAILY\');\\n    setDailyRunCompleted(false);\\n    setDailyRunShards(0);\\n    setDailyBanner(\'\');\\n\\n    const updated = recordDailyAttempt(dailyStateRef.current, freshChallenge.dateKey);\\n    dailyStateRef.current = updated;\\n    setDailyState(updated);\\n\\n    setStatus(\'PLAYING\');\\n    canvasHandleRef.current?.startNewGame({ dailyChallenge: freshChallenge });\\n    window.setTimeout(() => {\\n      canvasHandleRef.current?.focusBoard();\\n    }, 30);\\n  }, [todayKey]);\\n\\n  const restartCurrentMode = useCallback(() => {\\n    if (gameModeRef.current === \'DAILY\') {\\n      startDailyGame();\\n    } else {\\n      startClassicGame();\\n    }\\n  }, [startClassicGame, startDailyGame]);\\n\\n  const openDailyScreen = useCallback(() => {\\n    const currentKey = getLocalDateKey();\\n    if (currentKey !== todayKey) {\\n      setTodayKey(currentKey);\\n    }\\n    neonAudio.unlock();\\n    neonAudio.playSelect();\\n    setShowHelp(false);\\n    setStatus(\'DAILY_SCREEN\');\\n  }, [todayKey]);\\n\\n  const toggleMute = useCallback(() => {\\n    setMuted((prev) => {\\n      const next = !prev;\\n      neonAudio.setMuted(next);\\n      saveMutedPref(next);\\n      if (!next) {\\n        neonAudio.unlock();\\n        neonAudio.playSelect();\\n      }\\n      return next;\\n    });\\n  }, []);\\n\\n  const pauseGame = useCallback(() => {\\n    if (status === \'PLAYING\') {\\n      neonAudio.playSelect();\\n      setStatus(\'PAUSED\');\\n    } else if (status === \'PAUSED\') {\\n      neonAudio.playSelect();\\n      setStatus(\'PLAYING\');\\n      window.setTimeout(() => {\\n        canvasHandleRef.current?.focusBoard();\\n      }, 30);\\n    }\\n  }, [status]);\\n\\n  const handleGameOver = useCallback(\\n    (finalStats: GameStats) => {\\n      setStats(finalStats);\\n      if (finalStats.bestScore > bestScore) {\\n        setBestScore(finalStats.bestScore);\\n        saveBestScore(finalStats.bestScore);\\n      }\\n      if (finalStats.isNewBest) {\\n        canvasHandleRef.current?.triggerFireworks(5);\\n      }\\n      setStatus(\'GAME_OVER\');\\n    },\\n    [bestScore]\\n  );\\n\\n  const returnToTitle = useCallback(() => {\\n    neonAudio.playSelect();\\n    setShowHelp(false);\\n    setDailyBanner(\'\');\\n    setStatus(\'TITLE_MENU\');\\n  }, []);\\n\\n  // Auto-focus primary CTA when modal states transition for seamless D-pad/Keyboard UX\\n  useEffect(() => {\\n    if (showHelp) {\\n      closeHelpBtnRef.current?.focus();\\n    } else if (status === \'TITLE_MENU\') {\\n      startBtnRef.current?.focus();\\n    } else if (status === \'PAUSED\') {\\n      resumeBtnRef.current?.focus();\\n    } else if (status === \'GAME_OVER\') {\\n      playAgainBtnRef.current?.focus();\\n    }\\n  }, [status, showHelp]);\\n\\n  // Global keyboard shortcuts for menus & modals\\n  useEffect(() => {\\n    const onKeyDown = (e: KeyboardEvent) => {\\n      const key = e.key;\\n\\n      if (key === \'m\' || key === \'M\') {\\n        if (status !== \'PLAYING\' || showHelp) {\\n          e.preventDefault();\\n          toggleMute();\\n          return;\\n        }\\n      }\\n\\n      if (showHelp) {\\n        if (key === \'Escape\' || key === \'GoBack\' || key === \'Backspace\') {\\n          e.preventDefault();\\n          setShowHelp(false);\\n          if (status === \'PLAYING\') {\\n            canvasHandleRef.current?.focusBoard();\\n          }\\n        }\\n        return;\\n      }\\n\\n      if (status === \'DAILY_SCREEN\') {\\n        if (key === \'Escape\' || key === \'GoBack\' || key === \'Backspace\') {\\n          e.preventDefault();\\n          returnToTitle();\\n        }\\n        return;\\n      }\\n\\n      if (status === \'TITLE_MENU\') {\\n        const activeAction = document.activeElement?.getAttribute(\'data-action\');\\n        if (\\n          (key === \'Enter\' || key === \' \' || key === \'Select\' || key === \'DPadCenter\') &&\\n          activeAction !== \'help\' &&\\n          activeAction !== \'daily\'\\n        ) {\\n          e.preventDefault();\\n          startClassicGame();\\n        } else if (key === \'h\' || key === \'H\' || key === \'?\') {\\n          e.preventDefault();\\n          setShowHelp(true);\\n        }\\n        return;\\n      }\\n\\n      if (status === \'PAUSED\') {\\n        if (\\n          key === \'Escape\' ||\\n          key === \'p\' ||\\n          key === \'P\' ||\\n          key === \'GoBack\' ||\\n          key === \'MediaPlayPause\'\\n        ) {\\n          e.preventDefault();\\n          pauseGame();\\n        }\\n        return;\\n      }\\n\\n      if (status === \'GAME_OVER\') {\\n        const activeAction = document.activeElement?.getAttribute(\'data-action\');\\n        if (\\n          (key === \'Enter\' || key === \' \' || key === \'Select\' || key === \'DPadCenter\') &&\\n          activeAction !== \'menu\' &&\\n          activeAction !== \'daily\'\\n        ) {\\n          e.preventDefault();\\n          restartCurrentMode();\\n        }\\n      }\\n    };\\n\\n    window.addEventListener(\'keydown\', onKeyDown);\\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\\n  }, [\\n    status,\\n    showHelp,\\n    startClassicGame,\\n    restartCurrentMode,\\n    returnToTitle,\\n    pauseGame,\\n    toggleMute,\\n  ]);\\n\\n  // Allow D-pad navigation across HUD buttons and back to Canvas\\n  const handleHudButtonKeyDown = (\\n    e: React.KeyboardEvent<HTMLButtonElement>,\\n    idx: number\\n  ) => {\\n    const key = e.key;\\n    if (key === \'ArrowDown\' || key === \'ArrowRight\') {\\n      e.preventDefault();\\n      if (idx < hudButtonRefs.current.length - 1) {\\n        hudButtonRefs.current[idx + 1]?.focus();\\n      } else if (status === \'PLAYING\') {\\n        canvasHandleRef.current?.focusBoard();\\n      }\\n    } else if (key === \'ArrowUp\' || key === \'ArrowLeft\') {\\n      e.preventDefault();\\n      if (idx > 0) {\\n        hudButtonRefs.current[idx - 1]?.focus();\\n      } else if (status === \'PLAYING\') {\\n        canvasHandleRef.current?.focusBoard();\\n      }\\n    } else if (key === \'Escape\' && status === \'PLAYING\') {\\n      e.preventDefault();\\n      canvasHandleRef.current?.focusBoard();\\n    }\\n  };\\n\\n  const activeStreak = getEffectiveStreak(dailyState, todayKey);\\n  const todayRecord = dailyState.records[dailyChallenge.dateKey];\\n  const dailyEval = evaluateDailyProgress(dailyChallenge, stats);\\n  const isPlayDisabled =\\n    status === \'TITLE_MENU\' || status === \'DAILY_SCREEN\' || status === \'GAME_OVER\';\\n\\n  return (\\n    <div className=\\\"h-dvh w-screen overflow-hidden bg-[#050711] text-slate-100 flex flex-col md:flex-row\\\">\\n      {/* Portrait / Narrow Top HUD Bar */}\\n      <header className=\\\"md:hidden shrink-0 px-3 py-2 bg-[#070B1A] border-b border-indigo-500/20 flex items-center justify-between gap-2 z-10\\\">\\n        <div className=\\\"flex items-center gap-2.5 min-w-0\\\">\\n          <NeonLogo compact />\\n          <div className=\\\"flex items-baseline gap-2.5 text-xs pl-2 border-l border-slate-800\\\">\\n            <div>\\n              <span className=\\\"text-slate-400 mr-1\\\">Score</span>\\n              <span className=\\\"font-mono-nums font-bold text-sm text-white\\\">\\n                {stats.score.toLocaleString()}\\n              </span>\\n            </div>\\n            {gameMode === \'DAILY\' ? (\\n              <div>\\n                <span className=\\\"text-purple-300 mr-1\\\">Goal</span>\\n                <span className=\\\"font-mono-nums font-bold text-xs text-cyan-300\\\">\\n                  {dailyEval.current}/{dailyEval.target}\\n                </span>\\n              </div>\\n            ) : (\\n              <div>\\n                <span className=\\\"text-slate-400 mr-1\\\">Best</span>\\n                <span className=\\\"font-mono-nums font-bold text-sm text-cyan-300\\\">\\n                  {bestScore.toLocaleString()}\\n                </span>\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-1 shrink-0\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={openDailyScreen}\\n            aria-label=\\\"Daily Challenge\\\"\\n            className=\\\"neon-focus min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg bg-[#0D142D] border border-indigo-500/25 text-purple-300 hover:text-cyan-300 hover:border-cyan-400/50 transition-colors\\\"\\n          >\\n            <Calendar className=\\\"w-4 h-4\\\" />\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={pauseGame}\\n            disabled={isPlayDisabled}\\n            aria-label={status === \'PAUSED\' ? \'Resume game\' : \'Pause game\'}\\n            className=\\\"neon-focus min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg bg-[#0D142D] border border-indigo-500/25 text-slate-200 hover:text-cyan-300 hover:border-cyan-400/50 disabled:opacity-35 transition-colors\\\"\\n          >\\n            {status === \'PAUSED\' ? (\\n              <Play className=\\\"w-4 h-4\\\" />\\n            ) : (\\n              <Pause className=\\\"w-4 h-4\\\" />\\n            )}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={restartCurrentMode}\\n            aria-label=\\\"Restart game\\\"\\n            className=\\\"neon-focus min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg bg-[#0D142D] border border-indigo-500/25 text-slate-200 hover:text-cyan-300 hover:border-cyan-400/50 transition-colors\\\"\\n          >\\n            <RotateCcw className=\\\"w-4 h-4\\\" />\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={toggleMute}\\n            aria-label={muted ? \'Unmute sound\' : \'Mute sound\'}\\n            className=\\\"neon-focus min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg bg-[#0D142D] border border-indigo-500/25 text-slate-200 hover:text-cyan-300 hover:border-cyan-400/50 transition-colors\\\"\\n          >\\n            {muted ? (\\n              <VolumeX className=\\\"w-4 h-4 text-slate-400\\\" />\\n            ) : (\\n              <Volume2 className=\\\"w-4 h-4 text-cyan-300\\\" />\\n            )}\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setShowHelp(true)}\\n            aria-label=\\\"How to play\\\"\\n            className=\\\"neon-focus min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg bg-[#0D142D] border border-indigo-500/25 text-slate-200 hover:text-cyan-300 hover:border-cyan-400/50 transition-colors\\\"\\n          >\\n            <HelpCircle className=\\\"w-4 h-4\\\" />\\n          </button>\\n        </div>\\n      </header>\\n\\n      {/* Landscape Tablet & Desktop Left Control Sidebar */}\\n      <aside className=\\\"hidden md:flex md:w-60 lg:w-68 xl:w-72 shrink-0 flex-col justify-between bg-[#070B1A] border-r border-indigo-500/20 p-4 lg:p-5 z-10 overflow-y-auto\\\">\\n        <div className=\\\"space-y-4\\\">\\n          <NeonLogo compact />\\n\\n          {/* Primary Score Telemetry */}\\n          <div className=\\\"pt-3 border-t border-slate-800/80 space-y-2.5\\\">\\n            <div>\\n              <div className=\\\"flex items-center justify-between text-xs font-medium text-slate-400\\\">\\n                <span>{gameMode === \'DAILY\' ? \'Daily Score\' : \'Score\'}</span>\\n                {activeStreak > 0 && (\\n                  <span className=\\\"inline-flex items-center gap-1 text-cyan-300 font-mono-nums\\\">\\n                    <Flame className=\\\"w-3.5 h-3.5\\\" />\\n                    {activeStreak}d\\n                  </span>\\n                )}\\n              </div>\\n              <div className=\\\"font-mono-nums text-3xl lg:text-4xl font-bold text-white tracking-tight\\\">\\n                {stats.score.toLocaleString()}\\n              </div>\\n            </div>\\n\\n            {gameMode === \'DAILY\' && (\\n              <div className=\\\"pt-2 border-t border-slate-800/60 space-y-1.5\\\">\\n                <div className=\\\"flex items-center justify-between text-xs\\\">\\n                  <span className=\\\"text-purple-300 font-medium\\\">\\n                    {dailyChallenge.title}\\n                  </span>\\n                  <span className=\\\"font-mono-nums font-bold text-cyan-300\\\">\\n                    {dailyEval.current.toLocaleString()} / {dailyEval.target.toLocaleString()}\\n                  </span>\\n                </div>\\n                <div className=\\\"w-full h-1.5 rounded-full bg-slate-900 overflow-hidden\\\">\\n                  <div\\n                    className=\\\"h-full bg-gradient-to-r from-cyan-400 to-purple-500 transition-all duration-150\\\"\\n                    style={{ width: `${dailyEval.pct}%` }}\\n                  />\\n                </div>\\n                <div className=\\\"text-[11px] text-slate-400\\\">\\n                  {dailyEval.isComplete ? (\\n                    <span className=\\\"inline-flex items-center gap-1 text-cyan-300 font-medium\\\">\\n                      <CheckCircle2 className=\\\"w-3 h-3\\\" />\\n                      Objective complete\\n                    </span>\\n                  ) : (\\n                    <span>{dailyChallenge.description}</span>\\n                  )}\\n                </div>\\n              </div>\\n            )}\\n\\n            <div className=\\\"flex items-baseline justify-between pt-2 border-t border-slate-800/60\\\">\\n              <span className=\\\"text-xs font-medium text-slate-400\\\">Best Score</span>\\n              <span className=\\\"font-mono-nums text-lg font-bold text-cyan-300\\\">\\n                {bestScore.toLocaleString()}\\n              </span>\\n            </div>\\n\\n            <div className=\\\"flex items-baseline justify-between\\\">\\n              <span className=\\\"text-xs font-medium text-slate-400\\\">Max Tile</span>\\n              <span className=\\\"font-mono-nums text-base font-semibold text-purple-300\\\">\\n                {stats.maxTile > 0 ? stats.maxTile : \'\342\200\224\'}\\n              </span>\\n            </div>\\n\\n            <div className=\\\"flex items-baseline justify-between text-xs text-slate-400\\\">\\n              <span>Merges / Lines</span>\\n              <span className=\\\"font-mono-nums text-slate-200\\\">\\n                {stats.mergesCount} / {stats.linesCleared}\\n              </span>\\n            </div>\\n          </div>\\n\\n          {/* Ephemeral Event Callout */}\\n          <div className=\\\"h-5 flex items-center\\\">\\n            {comboLabel && (\\n              <span className=\\\"font-display text-sm font-bold tracking-wider text-cyan-300\\\">\\n                {comboLabel}\\n              </span>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Action Controls + Particle Intensity Setting */}\\n        <div className=\\\"space-y-2.5 pt-3 border-t border-slate-800/80\\\">\\n          {/* Particle Intensity Selector */}\\n          <div className=\\\"space-y-1\\\">\\n            <div className=\\\"flex items-center justify-between text-[11px] text-slate-400\\\">\\n              <span className=\\\"inline-flex items-center gap-1\\\">\\n                <Sparkles className=\\\"w-3 h-3 text-cyan-400\\\" />\\n                Particles\\n              </span>\\n              {reducedMotion && (\\n                <span className=\\\"text-slate-500\\\">Reduced Motion</span>\\n              )}\\n            </div>\\n            <div\\n              role=\\\"group\\\"\\n              aria-label=\\\"Particle intensity\\\"\\n              className=\\\"grid grid-cols-3 gap-1 p-1 rounded-lg bg-[#0B1228] border border-indigo-500/20\\\"\\n            >\\n              {([\'LOW\', \'MEDIUM\', \'HIGH\'] as ParticleIntensity[]).map((lvl) => (\\n                <button\\n                  key={lvl}\\n                  type=\\\"button\\\"\\n                  onClick={() => handleParticleIntensityChange(lvl)}\\n                  className={`neon-focus min-h-[32px] rounded-md text-[11px] font-semibold transition-colors ${\\n                    particleIntensity === lvl\\n                      ? \'bg-cyan-500/20 text-cyan-200 border border-cyan-400/50\'\\n                      : \'text-slate-400 hover:text-slate-200 border border-transparent\'\\n                  }`}\\n                >\\n                  {lvl === \'LOW\' ? \'Low\' : lvl === \'MEDIUM\' ? \'Med\' : \'High\'}\\n                </button>\\n              ))}\\n            </div>\\n          </div>\\n\\n          <button\\n            ref={(el) => {\\n              hudFirstBtnRef.current = el;\\n              hudButtonRefs.current[0] = el;\\n            }}\\n            type=\\\"button\\\"\\n            onClick={openDailyScreen}\\n            onKeyDown={(e) => handleHudButtonKeyDown(e, 0)}\\n            className=\\\"neon-focus w-full min-h-[44px] px-3 py-2 rounded-lg bg-[#0D1530] border border-purple-400/30 hover:border-cyan-400/60 text-sm font-medium text-slate-100 flex items-center justify-between gap-2 transition-colors whitespace-nowrap\\\"\\n          >\\n            <span className=\\\"inline-flex items-center gap-2\\\">\\n              <Calendar className=\\\"w-4 h-4 text-purple-300 shrink-0\\\" />\\n              <span>Daily Challenge</span>\\n            </span>\\n            <span className=\\\"text-xs font-mono-nums text-cyan-300\\\">\\n              {todayRecord?.completed ? \'Done\' : activeStreak > 0 ? `${activeStreak}d` : \'Play\'}\\n            </span>\\n          </button>\\n\\n          <div className=\\\"grid grid-cols-2 gap-2\\\">\\n            <button\\n              ref={(el) => {\\n                hudButtonRefs.current[1] = el;\\n              }}\\n              type=\\\"button\\\"\\n              onClick={pauseGame}\\n              onKeyDown={(e) => handleHudButtonKeyDown(e, 1)}\\n              disabled={isPlayDisabled}\\n              className=\\\"neon-focus min-h-[44px] px-3 py-2 rounded-lg bg-[#0D1530] border border-indigo-500/25 hover:border-cyan-400/50 text-sm font-medium text-slate-100 flex items-center justify-center gap-2 disabled:opacity-35 transition-colors whitespace-nowrap\\\"\\n            >\\n              {status === \'PAUSED\' ? (\\n                <>\\n                  <Play className=\\\"w-4 h-4 text-cyan-300 shrink-0\\\" />\\n                  <span>Resume</span>\\n                </>\\n              ) : (\\n                <>\\n                  <Pause className=\\\"w-4 h-4 text-cyan-300 shrink-0\\\" />\\n                  <span>Pause</span>\\n                </>\\n              )}\\n            </button>\\n\\n            <button\\n              ref={(el) => {\\n                hudButtonRefs.current[2] = el;\\n              }}\\n              type=\\\"button\\\"\\n              onClick={restartCurrentMode}\\n              onKeyDown={(e) => handleHudButtonKeyDown(e, 2)}\\n              className=\\\"neon-focus min-h-[44px] px-3 py-2 rounded-lg bg-[#0D1530] border border-indigo-500/25 hover:border-cyan-400/50 text-sm font-medium text-slate-100 flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n            >\\n              <RotateCcw className=\\\"w-4 h-4 text-purple-300 shrink-0\\\" />\\n              <span>Restart</span>\\n            </button>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-2\\\">\\n            <button\\n              ref={(el) => {\\n                hudButtonRefs.current[3] = el;\\n              }}\\n              type=\\\"button\\\"\\n              onClick={toggleMute}\\n              onKeyDown={(e) => handleHudButtonKeyDown(e, 3)}\\n              className=\\\"neon-focus min-h-[44px] px-3 py-2 rounded-lg bg-[#0D1530] border border-indigo-500/25 hover:border-cyan-400/50 text-sm font-medium text-slate-100 flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n            >\\n              {muted ? (\\n                <>\\n                  <VolumeX className=\\\"w-4 h-4 text-slate-400 shrink-0\\\" />\\n                  <span>Muted</span>\\n                </>\\n              ) : (\\n                <>\\n                  <Volume2 className=\\\"w-4 h-4 text-cyan-300 shrink-0\\\" />\\n                  <span>Sound</span>\\n                </>\\n              )}\\n            </button>\\n\\n            <button\\n              ref={(el) => {\\n                hudButtonRefs.current[4] = el;\\n              }}\\n              type=\\\"button\\\"\\n              onClick={() => setShowHelp(true)}\\n              onKeyDown={(e) => handleHudButtonKeyDown(e, 4)}\\n              className=\\\"neon-focus min-h-[44px] px-3 py-2 rounded-lg bg-[#0D1530] border border-indigo-500/25 hover:border-cyan-400/50 text-sm font-medium text-slate-100 flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n            >\\n              <HelpCircle className=\\\"w-4 h-4 text-blue-300 shrink-0\\\" />\\n              <span>Rules</span>\\n            </button>\\n          </div>\\n\\n          <p className=\\\"text-[11px] leading-relaxed text-slate-400 pt-0.5\\\">\\n            Drag or tap to place \302\267 Arrows + Enter/Space \302\267 Esc Pause\\n          </p>\\n        </div>\\n      </aside>\\n\\n      {/* Main Playfield Stage */}\\n      <main className=\\\"relative flex-1 min-w-0 min-h-0 flex flex-col\\\">\\n        <NeonCanvas\\n          ref={canvasHandleRef}\\n          status={status}\\n          bestScore={bestScore}\\n          reducedMotion={reducedMotion}\\n          particleIntensity={particleIntensity}\\n          onStatsChange={handleStatsChange}\\n          onComboEvent={handleComboEvent}\\n          onGameOver={handleGameOver}\\n          onRequestPause={pauseGame}\\n          onRequestToggleMute={toggleMute}\\n          onRequestHudFocus={() => hudFirstBtnRef.current?.focus()}\\n        />\\n\\n        {/* Non-blocking Daily Challenge Complete Banner */}\\n        {dailyBanner && status === \'PLAYING\' && (\\n          <div className=\\\"pointer-events-none absolute top-4 left-1/2 -translate-x-1/2 z-10 px-5 py-2.5 rounded-xl bg-[#09122E]/95 border border-cyan-400/60 shadow-[0_0_28px_rgba(34,211,238,0.4)] animate-[fadeIn_160ms_ease-out]\\\">\\n            <div className=\\\"flex items-center gap-2 text-sm font-display font-bold tracking-wide text-cyan-200 whitespace-nowrap\\\">\\n              <CheckCircle2 className=\\\"w-4 h-4 text-cyan-300 shrink-0\\\" />\\n              <span>{dailyBanner}</span>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* TITLE SCREEN OVERLAY */}\\n        {status === \'TITLE_MENU\' && !showHelp && (\\n          <div className=\\\"absolute inset-0 z-20 flex items-center justify-center p-4 bg-[#050711]/75 animate-[fadeIn_160ms_ease-out]\\\">\\n            <div className=\\\"w-full max-w-md rounded-2xl bg-[#091026]/95 border border-cyan-400/30 shadow-[0_0_50px_rgba(34,211,238,0.16)] p-6 sm:p-7 text-center space-y-5\\\">\\n              <NeonLogo />\\n\\n              <div className=\\\"space-y-1.5 text-sm text-slate-300 leading-relaxed\\\">\\n                <p>\\n                  Place polyomino blocks onto the 6\303\2276 neon grid.\\n                </p>\\n                <p className=\\\"text-slate-400\\\">\\n                  Connect 3 or more matching numbers to merge and upgrade tiles, or fill full rows and columns to clear the board.\\n                </p>\\n              </div>\\n\\n              {(bestScore > 0 || activeStreak > 0) && (\\n                <div className=\\\"flex items-center justify-center gap-4 text-xs text-slate-400\\\">\\n                  {bestScore > 0 && (\\n                    <span>\\n                      Best Score{\' \'}\\n                      <span className=\\\"font-mono-nums font-bold text-cyan-300 text-sm ml-1\\\">\\n                        {bestScore.toLocaleString()}\\n                      </span>\\n                    </span>\\n                  )}\\n                  {bestScore > 0 && activeStreak > 0 && (\\n                    <span aria-hidden=\\\"true\\\">\302\267</span>\\n                  )}\\n                  {activeStreak > 0 && (\\n                    <span className=\\\"inline-flex items-center gap-1 text-purple-300 font-medium\\\">\\n                      <Flame className=\\\"w-3.5 h-3.5 text-cyan-300\\\" />\\n                      <span className=\\\"font-mono-nums font-bold\\\">\\n                        {activeStreak}d\\n                      </span>{\' \'}\\n                      Streak\\n                    </span>\\n                  )}\\n                </div>\\n              )}\\n\\n              <div className=\\\"flex flex-col gap-2.5 pt-1\\\">\\n                <button\\n                  ref={startBtnRef}\\n                  type=\\\"button\\\"\\n                  onClick={startClassicGame}\\n                  className=\\\"neon-focus w-full min-h-[48px] px-7 py-3 rounded-xl bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-500 hover:from-cyan-400 hover:via-blue-400 hover:to-purple-400 text-white font-display font-bold text-base tracking-wide shadow-[0_0_24px_rgba(56,189,248,0.45)] transition-transform active:scale-[0.98] whitespace-nowrap\\\"\\n                >\\n                  Start Game\\n                </button>\\n\\n                <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    data-action=\\\"daily\\\"\\n                    onClick={openDailyScreen}\\n                    className=\\\"neon-focus min-h-[46px] px-4 py-2.5 rounded-xl bg-[#0F1838] border border-purple-400/35 hover:border-cyan-400/60 text-slate-100 font-medium text-sm flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n                  >\\n                    <Calendar className=\\\"w-4 h-4 text-purple-300 shrink-0\\\" />\\n                    <span>Daily</span>\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    data-action=\\\"help\\\"\\n                    onClick={() => setShowHelp(true)}\\n                    className=\\\"neon-focus min-h-[46px] px-4 py-2.5 rounded-xl bg-[#0F1838] border border-indigo-400/30 hover:border-cyan-400/60 text-slate-200 font-medium text-sm transition-colors whitespace-nowrap\\\"\\n                  >\\n                    How to Play\\n                  </button>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"text-xs text-slate-400 pt-0.5\\\">\\n                Drag or Tap to Place \302\267 Arrows + Enter/Space \302\267 Esc Pause\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* DEDICATED DAILY CHALLENGE SCREEN */}\\n        {status === \'DAILY_SCREEN\' && !showHelp && (\\n          <DailyChallengeScreen\\n            challenge={dailyChallenge}\\n            dailyState={dailyState}\\n            onStartDaily={startDailyGame}\\n            onBack={returnToTitle}\\n          />\\n        )}\\n\\n        {/* PAUSE MODAL */}\\n        {status === \'PAUSED\' && !showHelp && (\\n          <div\\n            role=\\\"dialog\\\"\\n            aria-modal=\\\"true\\\"\\n            aria-label=\\\"Game Paused\\\"\\n            className=\\\"absolute inset-0 z-20 flex items-center justify-center p-4 bg-[#050711]/80 animate-[fadeIn_160ms_ease-out]\\\"\\n          >\\n            <div className=\\\"w-full max-w-sm rounded-2xl bg-[#091026] border border-indigo-400/30 shadow-[0_0_40px_rgba(99,102,241,0.2)] p-6 space-y-4 text-center\\\">\\n              <div className=\\\"space-y-1\\\">\\n                <h2 className=\\\"font-display text-2xl font-extrabold tracking-wide text-white\\\">\\n                  Game Paused\\n                </h2>\\n                <p className=\\\"text-xs text-slate-400 font-mono-nums\\\">\\n                  {gameMode === \'DAILY\' ? \'Daily Challenge \302\267 \' : \'\'}\\n                  Score {stats.score.toLocaleString()} \302\267 Best {bestScore.toLocaleString()}\\n                </p>\\n              </div>\\n\\n              {/* Particle Intensity Setting (accessible on mobile/tablet pause screen too) */}\\n              <div className=\\\"space-y-1.5 text-left\\\">\\n                <div className=\\\"text-xs text-slate-400 flex items-center justify-between\\\">\\n                  <span>Particle Intensity</span>\\n                  {reducedMotion && (\\n                    <span className=\\\"text-[11px] text-slate-500\\\">Reduced Motion Active</span>\\n                  )}\\n                </div>\\n                <div\\n                  role=\\\"group\\\"\\n                  aria-label=\\\"Particle intensity\\\"\\n                  className=\\\"grid grid-cols-3 gap-1 p-1 rounded-xl bg-[#0B1228] border border-indigo-500/20\\\"\\n                >\\n                  {([\'LOW\', \'MEDIUM\', \'HIGH\'] as ParticleIntensity[]).map((lvl) => (\\n                    <button\\n                      key={lvl}\\n                      type=\\\"button\\\"\\n                      onClick={() => handleParticleIntensityChange(lvl)}\\n                      className={`neon-focus min-h-[38px] rounded-lg text-xs font-semibold transition-colors ${\\n                        particleIntensity === lvl\\n                          ? \'bg-cyan-500/20 text-cyan-200 border border-cyan-400/50\'\\n                          : \'text-slate-400 hover:text-slate-200 border border-transparent\'\\n                      }`}\\n                    >\\n                      {lvl === \'LOW\' ? \'Low\' : lvl === \'MEDIUM\' ? \'Medium\' : \'High\'}\\n                    </button>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex flex-col gap-2\\\">\\n                <button\\n                  ref={resumeBtnRef}\\n                  type=\\\"button\\\"\\n                  onClick={pauseGame}\\n                  className=\\\"neon-focus min-h-[46px] px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-semibold text-sm transition-colors\\\"\\n                >\\n                  Resume Game\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={restartCurrentMode}\\n                  className=\\\"neon-focus min-h-[44px] px-5 py-2.5 rounded-xl bg-[#0F1838] border border-indigo-400/30 hover:border-cyan-400/60 text-slate-100 font-medium text-sm transition-colors\\\"\\n                >\\n                  Restart\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={toggleMute}\\n                  className=\\\"neon-focus min-h-[44px] px-5 py-2.5 rounded-xl bg-[#0F1838] border border-indigo-400/30 hover:border-cyan-400/60 text-slate-100 font-medium text-sm transition-colors\\\"\\n                >\\n                  {muted ? \'Sound: Off\' : \'Sound: On\'}\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowHelp(true)}\\n                  className=\\\"neon-focus min-h-[44px] px-5 py-2.5 rounded-xl bg-[#0F1838] border border-indigo-400/30 hover:border-cyan-400/60 text-slate-100 font-medium text-sm transition-colors\\\"\\n                >\\n                  How to Play\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={returnToTitle}\\n                  className=\\\"neon-focus min-h-[44px] px-5 py-2.5 rounded-xl bg-transparent border border-slate-700/80 hover:border-slate-500 text-slate-300 font-medium text-sm transition-colors\\\"\\n                >\\n                  Main Menu\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* GAME OVER MODAL */}\\n        {status === \'GAME_OVER\' && !showHelp && (\\n          <div\\n            role=\\\"dialog\\\"\\n            aria-modal=\\\"true\\\"\\n            aria-label=\\\"Game Over\\\"\\n            className=\\\"absolute inset-0 z-20 flex items-center justify-center p-4 bg-[#050711]/82 animate-[fadeIn_160ms_ease-out]\\\"\\n          >\\n            <div className=\\\"w-full max-w-md rounded-2xl bg-[#091026] border border-purple-400/35 shadow-[0_0_50px_rgba(168,85,247,0.22)] p-6 sm:p-7 space-y-5 text-center\\\">\\n              <div className=\\\"space-y-1\\\">\\n                <h2 className=\\\"font-display text-3xl font-extrabold tracking-wide text-white\\\">\\n                  {gameMode === \'DAILY\' && dailyRunCompleted\\n                    ? \'Daily Complete\'\\n                    : \'Game Over\'}\\n                </h2>\\n                <p className=\\\"text-sm text-slate-400\\\">\\n                  No valid moves remaining\\n                </p>\\n              </div>\\n\\n              {stats.isNewBest && (\\n                <div className=\\\"text-xs font-semibold tracking-wider text-cyan-300\\\">\\n                  New Best Score Achieved\\n                </div>\\n              )}\\n\\n              {gameMode === \'DAILY\' && (\\n                <div className=\\\"rounded-xl bg-[#0D1530] border border-cyan-400/25 px-4 py-2.5 text-xs flex items-center justify-between\\\">\\n                  <span className=\\\"text-slate-300\\\">\\n                    {dailyRunCompleted\\n                      ? dailyRunShards > 0\\n                        ? `Reward Claimed: +${dailyRunShards} Shards`\\n                        : \'Objective Complete\'\\n                      : `Daily Goal: ${dailyEval.current}/${dailyEval.target}`}\\n                  </span>\\n                  <span className=\\\"font-mono-nums font-bold text-cyan-300\\\">\\n                    {activeStreak}d Streak\\n                  </span>\\n                </div>\\n              )}\\n\\n              <div className=\\\"grid grid-cols-2 gap-3 py-3 border-y border-slate-800/80 text-left\\\">\\n                <div className=\\\"px-2\\\">\\n                  <div className=\\\"text-xs text-slate-400\\\">Final Score</div>\\n                  <div className=\\\"font-mono-nums text-2xl font-bold text-white\\\">\\n                    {stats.score.toLocaleString()}\\n                  </div>\\n                </div>\\n                <div className=\\\"px-2\\\">\\n                  <div className=\\\"text-xs text-slate-400\\\">Best Score</div>\\n                  <div className=\\\"font-mono-nums text-2xl font-bold text-cyan-300\\\">\\n                    {bestScore.toLocaleString()}\\n                  </div>\\n                </div>\\n                <div className=\\\"px-2\\\">\\n                  <div className=\\\"text-xs text-slate-400\\\">Max Tile</div>\\n                  <div className=\\\"font-mono-nums text-lg font-semibold text-purple-300\\\">\\n                    {stats.maxTile > 0 ? stats.maxTile : \'\342\200\224\'}\\n                  </div>\\n                </div>\\n                <div className=\\\"px-2\\\">\\n                  <div className=\\\"text-xs text-slate-400\\\">Merges / Lines</div>\\n                  <div className=\\\"font-mono-nums text-lg font-semibold text-blue-300\\\">\\n                    {stats.mergesCount} / {stats.linesCleared}\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"flex flex-col sm:flex-row gap-2.5 pt-1\\\">\\n                <button\\n                  ref={playAgainBtnRef}\\n                  type=\\\"button\\\"\\n                  onClick={restartCurrentMode}\\n                  className=\\\"neon-focus flex-1 min-h-[48px] px-5 py-3 rounded-xl bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-500 hover:from-cyan-400 hover:via-blue-400 hover:to-purple-400 text-white font-display font-bold text-base tracking-wide shadow-[0_0_24px_rgba(56,189,248,0.4)] transition-transform active:scale-[0.98] whitespace-nowrap\\\"\\n                >\\n                  Play Again\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  data-action=\\\"daily\\\"\\n                  onClick={openDailyScreen}\\n                  className=\\\"neon-focus min-h-[48px] px-4 py-3 rounded-xl bg-[#0F1838] border border-purple-400/35 hover:border-cyan-400/60 text-slate-100 font-medium text-sm transition-colors whitespace-nowrap\\\"\\n                >\\n                  Daily Hub\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  data-action=\\\"menu\\\"\\n                  onClick={returnToTitle}\\n                  className=\\\"neon-focus min-h-[48px] px-4 py-3 rounded-xl bg-[#0F1838] border border-indigo-400/30 hover:border-cyan-400/60 text-slate-200 font-medium text-sm transition-colors whitespace-nowrap\\\"\\n                >\\n                  Menu\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* HOW TO PLAY MODAL */}\\n        {showHelp && (\\n          <div\\n            role=\\\"dialog\\\"\\n            aria-modal=\\\"true\\\"\\n            aria-label=\\\"How to Play\\\"\\n            className=\\\"absolute inset-0 z-30 flex items-center justify-center p-4 bg-[#050711]/86 animate-[fadeIn_160ms_ease-out]\\\"\\n          >\\n            <div className=\\\"w-full max-w-lg max-h-[90dvh] overflow-y-auto rounded-2xl bg-[#091026] border border-cyan-400/30 shadow-[0_0_45px_rgba(34,211,238,0.18)] p-6 space-y-5\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <h2 className=\\\"font-display text-xl font-extrabold tracking-wide text-white\\\">\\n                  How to Play NEON BLOCK\\n                </h2>\\n                <button\\n                  ref={closeHelpBtnRef}\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    setShowHelp(false);\\n                    if (status === \'PLAYING\') {\\n                      canvasHandleRef.current?.focusBoard();\\n                    }\\n                  }}\\n                  aria-label=\\\"Close instructions\\\"\\n                  className=\\\"neon-focus min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg bg-[#0F1838] border border-indigo-400/25 text-slate-200 hover:text-cyan-300\\\"\\n                >\\n                  <X className=\\\"w-5 h-5\\\" />\\n                </button>\\n              </div>\\n\\n              <div className=\\\"space-y-4 text-sm text-slate-300\\\">\\n                <div className=\\\"space-y-1\\\">\\n                  <h3 className=\\\"font-semibold text-cyan-300\\\">\\n                    1. Place Polyomino Blocks\\n                  </h3>\\n                  <p className=\\\"text-slate-400 leading-relaxed\\\">\\n                    Drag any of the 3 blocks from the tray onto empty spaces on the 6\303\2276 grid, or tap a block then tap the grid. Placing all 3 blocks deals a fresh tray.\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"space-y-1\\\">\\n                  <h3 className=\\\"font-semibold text-blue-300\\\">\\n                    2. Connect 3+ Tiles to Merge\\n                  </h3>\\n                  <p className=\\\"text-slate-400 leading-relaxed\\\">\\n                    When 3 or more orthogonally connected tiles share the same number, they fuse into one doubled tile (<span className=\\\"font-mono-nums text-slate-200\\\">2 \342\206\222 4 \342\206\222 8 \342\206\222 16 \342\206\222 32...</span>). Cascading chain merges multiply your score!\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"space-y-1\\\">\\n                  <h3 className=\\\"font-semibold text-purple-300\\\">\\n                    3. Fill Rows or Columns to Clear\\n                  </h3>\\n                  <p className=\\\"text-slate-400 leading-relaxed\\\">\\n                    Complete any full 6-tile row or column to trigger a plasma beam clear, awarding bonus points and freeing space on the board.\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"space-y-1\\\">\\n                  <h3 className=\\\"font-semibold text-cyan-200\\\">\\n                    4. Daily Challenges & Streaks\\n                  </h3>\\n                  <p className=\\\"text-slate-400 leading-relaxed\\\">\\n                    Every local calendar day generates a unique challenge board, difficulty tier, and objective. Complete it once per day to build your streak and collect Neon Shards.\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"pt-3 border-t border-slate-800 space-y-1.5\\\">\\n                  <h3 className=\\\"font-semibold text-slate-200\\\">\\n                    Keyboard & Fire TV D-Pad Controls\\n                  </h3>\\n                  <ul className=\\\"text-xs text-slate-400 space-y-1 leading-relaxed\\\">\\n                    <li>\\n                      <span className=\\\"text-slate-200 font-medium\\\">Arrow Keys / D-Pad:</span> Move cursor across the grid. Move past the board edge into the tray to pick another block.\\n                    </li>\\n                    <li>\\n                      <span className=\\\"text-slate-200 font-medium\\\">Enter / Space / Select:</span> Place active block or select focused tray piece.\\n                    </li>\\n                    <li>\\n                      <span className=\\\"text-slate-200 font-medium\\\">1\342\200\2233 / Tab:</span> Quickly switch active tray piece.\\n                    </li>\\n                    <li>\\n                      <span className=\\\"text-slate-200 font-medium\\\">Esc / P / M:</span> Pause game or toggle sound.\\n                    </li>\\n                  </ul>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"pt-2 flex justify-end\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    setShowHelp(false);\\n                    if (status === \'PLAYING\') {\\n                      canvasHandleRef.current?.focusBoard();\\n                    }\\n                  }}\\n                  className=\\\"neon-focus min-h-[44px] px-6 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-semibold text-sm\\\"\\n                >\\n                  Got It\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n      </main>\\n    </div>\\n  );\\n}\\n\",\"Description\":\"Integrate Daily Challenge screen, streak & objective HUD, particle intensity settings, synchronized fireworks, and smooth screen transitions into App.tsx\",\"Overwrite\":true,\"TargetFile\":\"/src/App.tsx\",\"toolAction\":\"Updating App.tsx with Daily & VFX features\",\"toolSummary\":\"Update App.tsx with Daily & VFX features\"}"
