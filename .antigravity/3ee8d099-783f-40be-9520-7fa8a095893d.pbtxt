    command_line: "npx tsx -e \"\nimport assert from \'node:assert/strict\';\nimport {\n  INITIAL_NAV_STATE,\n  navigateToView,\n  startGameView,\n  enterGameOverView,\n  togglePauseView,\n  navigateBack,\n} from \'./src/game/navigation.ts\';\n\n// 1. TITLE_MENU -> DAILY_SCREEN -> DASHBOARD -> Escape -> DAILY_SCREEN -> Escape -> TITLE_MENU\nlet s = INITIAL_NAV_STATE;\ns = navigateToView(s, \'DAILY_SCREEN\');\nassert.equal(s.status, \'DAILY_SCREEN\');\ns = navigateToView(s, \'DASHBOARD\');\nassert.equal(s.status, \'DASHBOARD\');\ns = navigateBack(s);\nassert.equal(s.status, \'DAILY_SCREEN\');\ns = navigateBack(s);\nassert.equal(s.status, \'TITLE_MENU\');\n// Escape on TITLE_MENU stays on TITLE_MENU\ns = navigateBack(s);\nassert.equal(s.status, \'TITLE_MENU\');\n\n// 2. TITLE_MENU -> DASHBOARD -> DAILY_SCREEN -> Escape -> DASHBOARD -> Escape -> TITLE_MENU\ns = INITIAL_NAV_STATE;\ns = navigateToView(s, \'DASHBOARD\');\ns = navigateToView(s, \'DAILY_SCREEN\');\nassert.equal(s.status, \'DAILY_SCREEN\');\ns = navigateBack(s);\nassert.equal(s.status, \'DASHBOARD\');\ns = navigateBack(s);\nassert.equal(s.status, \'TITLE_MENU\');\n\n// 3. TITLE_MENU -> PLAYING -> Escape (PAUSED) -> DASHBOARD -> Escape (PAUSED) -> Escape (PLAYING)\ns = startGameView(INITIAL_NAV_STATE);\nassert.equal(s.status, \'PLAYING\');\ns = navigateBack(s);\nassert.equal(s.status, \'PAUSED\');\ns = navigateToView(s, \'DASHBOARD\');\nassert.equal(s.status, \'DASHBOARD\');\ns = navigateBack(s);\nassert.equal(s.status, \'PAUSED\');\ns = navigateBack(s);\nassert.equal(s.status, \'PLAYING\');\n\n// 4. PLAYING -> HUD Dashboard -> Escape (PAUSED) -> Escape (PLAYING)\ns = startGameView(INITIAL_NAV_STATE);\ns = navigateToView(s, \'DASHBOARD\');\nassert.equal(s.status, \'DASHBOARD\');\ns = navigateBack(s);\nassert.equal(s.status, \'PAUSED\');\ns = navigateBack(s);\nassert.equal(s.status, \'PLAYING\');\n\n// 5. TITLE_MENU -> DAILY_SCREEN -> PLAYING -> GAME_OVER -> DASHBOARD -> Escape (GAME_OVER) -> Escape (DAILY_SCREEN) -> Escape (TITLE_MENU)\ns = navigateToView(INITIAL_NAV_STATE, \'DAILY_SCREEN\');\ns = startGameView(s);\nassert.equal(s.status, \'PLAYING\');\ns = enterGameOverView(s);\nassert.equal(s.status, \'GAME_OVER\');\ns = navigateToView(s, \'DASHBOARD\');\nassert.equal(s.status, \'DASHBOARD\');\ns = navigateBack(s);\nassert.equal(s.status, \'GAME_OVER\');\ns = navigateBack(s);\nassert.equal(s.status, \'DAILY_SCREEN\');\ns = navigateBack(s);\nassert.equal(s.status, \'TITLE_MENU\');\n\n// 6. Classic Restart from PAUSED & GAME_OVER preserves TITLE_MENU as Escape target\ns = startGameView(INITIAL_NAV_STATE);\ns = togglePauseView(s);\nassert.equal(s.status, \'PAUSED\');\ns = startGameView(s);\nassert.equal(s.status, \'PLAYING\');\ns = enterGameOverView(s);\nassert.equal(s.status, \'GAME_OVER\');\ns = navigateBack(s);\nassert.equal(s.status, \'TITLE_MENU\');\n\nconsole.log(\'ALL NAVIGATION TESTS PASSED\');\n\""
    proposed_command_line: "npx tsx -e \"\nimport assert from \'node:assert/strict\';\nimport {\n  INITIAL_NAV_STATE,\n  navigateToView,\n  startGameView,\n  enterGameOverView,\n  togglePauseView,\n  navigateBack,\n} from \'./src/game/navigation.ts\';\n\n// 1. TITLE_MENU -> DAILY_SCREEN -> DASHBOARD -> Escape -> DAILY_SCREEN -> Escape -> TITLE_MENU\nlet s = INITIAL_NAV_STATE;\ns = navigateToView(s, \'DAILY_SCREEN\');\nassert.equal(s.status, \'DAILY_SCREEN\');\ns = navigateToView(s, \'DASHBOARD\');\nassert.equal(s.status, \'DASHBOARD\');\ns = navigateBack(s);\nassert.equal(s.status, \'DAILY_SCREEN\');\ns = navigateBack(s);\nassert.equal(s.status, \'TITLE_MENU\');\n// Escape on TITLE_MENU stays on TITLE_MENU\ns = navigateBack(s);\nassert.equal(s.status, \'TITLE_MENU\');\n\n// 2. TITLE_MENU -> DASHBOARD -> DAILY_SCREEN -> Escape -> DASHBOARD -> Escape -> TITLE_MENU\ns = INITIAL_NAV_STATE;\ns = navigateToView(s, \'DASHBOARD\');\ns = navigateToView(s, \'DAILY_SCREEN\');\nassert.equal(s.status, \'DAILY_SCREEN\');\ns = navigateBack(s);\nassert.equal(s.status, \'DASHBOARD\');\ns = navigateBack(s);\nassert.equal(s.status, \'TITLE_MENU\');\n\n// 3. TITLE_MENU -> PLAYING -> Escape (PAUSED) -> DASHBOARD -> Escape (PAUSED) -> Escape (PLAYING)\ns = startGameView(INITIAL_NAV_STATE);\nassert.equal(s.status, \'PLAYING\');\ns = navigateBack(s);\nassert.equal(s.status, \'PAUSED\');\ns = navigateToView(s, \'DASHBOARD\');\nassert.equal(s.status, \'DASHBOARD\');\ns = navigateBack(s);\nassert.equal(s.status, \'PAUSED\');\ns = navigateBack(s);\nassert.equal(s.status, \'PLAYING\');\n\n// 4. PLAYING -> HUD Dashboard -> Escape (PAUSED) -> Escape (PLAYING)\ns = startGameView(INITIAL_NAV_STATE);\ns = navigateToView(s, \'DASHBOARD\');\nassert.equal(s.status, \'DASHBOARD\');\ns = navigateBack(s);\nassert.equal(s.status, \'PAUSED\');\ns = navigateBack(s);\nassert.equal(s.status, \'PLAYING\');\n\n// 5. TITLE_MENU -> DAILY_SCREEN -> PLAYING -> GAME_OVER -> DASHBOARD -> Escape (GAME_OVER) -> Escape (DAILY_SCREEN) -> Escape (TITLE_MENU)\ns = navigateToView(INITIAL_NAV_STATE, \'DAILY_SCREEN\');\ns = startGameView(s);\nassert.equal(s.status, \'PLAYING\');\ns = enterGameOverView(s);\nassert.equal(s.status, \'GAME_OVER\');\ns = navigateToView(s, \'DASHBOARD\');\nassert.equal(s.status, \'DASHBOARD\');\ns = navigateBack(s);\nassert.equal(s.status, \'GAME_OVER\');\ns = navigateBack(s);\nassert.equal(s.status, \'DAILY_SCREEN\');\ns = navigateBack(s);\nassert.equal(s.status, \'TITLE_MENU\');\n\n// 6. Classic Restart from PAUSED & GAME_OVER preserves TITLE_MENU as Escape target\ns = startGameView(INITIAL_NAV_STATE);\ns = togglePauseView(s);\nassert.equal(s.status, \'PAUSED\');\ns = startGameView(s);\nassert.equal(s.status, \'PLAYING\');\ns = enterGameOverView(s);\nassert.equal(s.status, \'GAME_OVER\');\ns = navigateBack(s);\nassert.equal(s.status, \'TITLE_MENU\');\n\nconsole.log(\'ALL NAVIGATION TESTS PASSED\');\n\""
