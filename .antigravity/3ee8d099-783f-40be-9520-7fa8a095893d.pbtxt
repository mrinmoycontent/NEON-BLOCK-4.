      thinking_signature: "\022\275\016\n\272\016\001i\024}\0237\251Z@5\250\243If\032\002\374\026]\315q\003n\r\216\334\301\f\352\230\261D\316S\324i\022[@\020\363\204\177\274/+\006Xw\177\345\025r\240\340\312\354E\2701\026\276r\023\023\305\317 \002\021\026\202&\236\003\355\342F`\300\222\b*:\004&,\000\341L\264\325\235Q|\036\222r\203\302.\027\274\260Z\375\221\2244y$\006m\034\3737\312\317\251t.Z\353\2738N#\370\304\263\207\361\310*\200\361\326\310\332\333\342\267\331=\004\232N\340F\t\021\262T2W\a4-^\202\261j\251\242\177\004,\276\220\341%\274\233\025\267\345\201\310\234<:\335w\374\016\333\a\252\233\254\332\2572\335A\313\034OD\211\260\203<\342\221z\215\335\377rb\266\227\t\'N\271\030o\232\236\271\3361\370\252\201JZ^\374\276\275[7\312\261\a\254\273F\200\202J\330\377\205{\234\024\336\234\0328\347e\030E\260\246\220?I\271W\302m\250\324:sJs\246\256\254\r,\006C\200\335\373\270(\327e\227\302W\305v\362^D\322\002\261L\230E\351\037\\J\214\362<\r\315N\350\207n;\362 -9\033-\247\035E\332\371h*g\205\240\346\337\347\v+>!V2\034\224\273L\2535\202\362[\006&V\366xs\372\241\244\301\236\377 :\025G\322\237\304.\363tB\357\256&\244\373/\226\006\344\271U\202X\240\024\377\227\031\357\315=\3752T61\232\314),\202M\336\222H\316\320\327\361\001\273\030\000\234 Sz\2310Y|S\023\244\374\203\260\002\004q\307\213\377\037\247\310\326w\035\307]\333R\205\220k\205\a\360\245\327d\244\276\252\331\277gj_\207\2114\"!h*\301\254\250/\305\347^p\337\017\3411s\252[\022\036-\261b`\307\031\3720\361\211\226Px\330\201\254/\235\277\005#\326\035\361\243\312\024\nM\200K\212\267\365-\354\327\254\300\227\310\252%0\317%\361\t\207\231\317X\377\025\205\241\004\304\302\222\032\233t\307\377\215\366\207\336\335\257\342s\220\0004\025\213{\267mL-K,\361~\304\356\v\a\031[\362\020\244\200\337\210\023\226\'2S\334Z<\023\346\237\365\\u\003\225\336\023\237\245\320\361|\016\330=\\\344\350Y\230\245\314u\231\304TM\374y\016\260\2257;\036k\327\331\016\204\312\005I\347\312m7\024\303\376+ \301\366\0266\"\323\300[jS\213=^\3026J\034\303\220<\356\260L\222;a