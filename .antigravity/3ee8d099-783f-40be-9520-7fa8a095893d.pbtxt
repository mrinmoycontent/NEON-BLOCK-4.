ow: \'rgba(103, 232, 249, 0.88)\',\n    text: \'#FFFFFF\',\n    innerAccent: \'rgba(168, 85, 247, 0.40)\',\n  },\n  1024: {\n    bgTop: \'#6D28D9\',\n    bgBottom: \'#3B0764\',\n    border: \'#F0ABFC\',\n    glow: \'rgba(240, 171, 252, 0.92)\',\n    text: \'#FFFFFF\',\n    innerAccent: \'rgba(34, 211, 238, 0.42)\',\n  },\n  2048: {\n    bgTop: \'#0284C7\',\n    bgBottom: \'#581C87\',\n    border: \'#E0F2FE\',\n    glow: \'rgba(224, 242, 254, 0.95)\',\n    text: \'#FFFFFF\',\n    innerAccent: \'rgba(255, 255, 255, 0.45)\',\n  },\n};\n\nexport function getTilePalette(value: number): TilePaletteEntry {\n  if (TILE_PALETTE[value]) {\n    return TILE_PALETTE[value];\n  }\n  if (value > 2048) {\n    return {\n      bgTop: \'#0891B2\',\n      bgBottom: \'#6B21A8\',\n      border: \'#F0FDFA\',\n      glow: \'rgba(103, 232, 249, 0.98)\',\n      text: \'#FFFFFF\',\n      innerAccent: \'rgba(255, 255, 255, 0.5)\',\n    };\n  }\n  return TILE_PALETTE[2];\n}\n"
