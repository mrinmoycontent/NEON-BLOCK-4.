      thinking_signature: "\022\336\v\n\333\v\001i\024}\023x\225\303\031\177\323\365^oGGYg\006\350\032\341\260\321\337\255F\242\332g)j\002\347\240\203\263X\037\250\253\314O\305CV\262\f?\351\234y\217k\231L\377\a\3746ia\267& \016X6\271*\036\n\255\366t\271\207\317\240\304T;\274b&\026\322\n\347z\260\024R\005\244d\022H\340&_\257\342b\017\255so\364\253\271\334\003T\341\317Jpg\033J\310zA\240\224\222\357:g\020Zi\006\361\353t\300*\336\240A\006\035\306\023\324\271\256\203K\250n\b\237\375\202\340s\000\315y\t\0003Xk\241\237\a`\362My\312\336/\002\340\177\365\016T\224F\2024\332r\006j\3662kn\270\212\252\257w\343\334\327\223S\317:\372\375\363\000x\2761\316\224\203\b\001\301\025\210\307q\017NX4p\251\002X\246\323\321\v\257ci\240/\022l\206\201\\\233\311\034W\350\b\216\217{\373\004c\n\372\003\034\244]\345\321\340\375\245\270\f\233\255\254\310:\270\261r\341\201:\240\362\323\305MzZ\344\266\vJ8\362\270\330\300\332Jl\275\341$\243\316\026\215\274\241\263Y_\t\f\254\366\v]\336\233\373\232\001m\024\006\017\324\377S\331\220\364\320 HV\200\315\276*\340\262-\034\0227k\371&\\Fu\353e+|\255<\211,\f\275\360\a\327\353d<b*\aK\212\273_\021c:6>\246\314\204I\340\213^\252W\245\322I\235\aar`\360\377\341\224\356g\a\330u\rA\256\266I\242\202\351\200\231\310\211\3301st\360B9\252T\303^\256\340\032L\366\alf\304E(\310$\327\223\265\277\223\314\373P\334\256\225O8j\245\330w\237A\303\006#\320$\000\213\031\327s\250\357\202\345\233\205\016\347\275-\230\377\177\211\256\232g\333\375\256\300\335\000W\201\024\303\242\270a\271\214\256\374\372I#P\336\r\f\321[4\354n\352\3651HzS\310\362=\211/u\221x\316\350\316i\230\367\211\265\025\0051\246\30694?qZ\373b\303\300\271\254\247\v\322\274\363f\027\205\356V\023l\342\302\352\226V\300`rHr\364\372\363\250\225\241\024\036\277\322%v-\340\022)8\322\377\241\214\022\245\222\244c\'h7y\317\246\254Q:\361\030J\032\230\277\320`\342\201\025\037\017xM\021\330\247\274\247\271\200\023\177\322\211\335\342\265\336\a\342\242-\253\321\a\b\244\350K\345\017wb\n5\374\rs\331\350R\270\223]\216v\036\370\351\217