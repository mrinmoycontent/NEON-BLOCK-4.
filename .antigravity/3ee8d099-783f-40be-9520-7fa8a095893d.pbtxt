      thinking_signature: "\022\376\t\n\373\t\001i\024}\023\321\372\226%\216\362\253r\200A\274/\257\247\023\331\240\004Rg\247q\3606\310d1\222\203\354\206+Xx\354@\324#%\274\350\'\b\031\330\330mPg\275S\365S\327)}\217\367\v\372\r\273V3\270VP\034\021\223\321\213\336\301z\310\344\236D\354;^$\325\232\306S?\334\023\377\222E-\240r\021\032\253\263\205\373\231\304k\n\251\033I7\302\205\356\220\303\376\311gY\316\241\'\264j\327\216@z\374\241\'\245\354\342\232\206\356\220\004\017x\3071uk\325\001\361kC\200\360\341/\372\002\214\311\341\244K\330T8&\223\354B\326\033\304\v0rR8\274\2031\210\250e\001i%\221\020\336\360\230G\004\227\024\231\232\177\273\324>9\204&#\330\037\257\005\002\253D\340\215\323\364_V\317\at\027Bn\274o\323\336U]\303y\"\351\005\312\252{\006\327\'5\004\242L\213\263#\024\371+\372\av3\252\f\352{aD<l\356Z\017=2\323\005\213<\031\034B\256\305\370\303\034>N\325\b\203\352\270\240\033:\\\270o\aD\343 FEL\343\341>\365r\273K\327N\314\247\326\341\221\023\321@\\;\344\253\233\2406\371b\016|\357%\334\b/\231\223\n,h\320\274\335\314W\234\255(L\255\343\2469\303c\345R\215Q\303\277%\224%e\223\ru\250\246\227\237\024b\274\224\270\222O\304\340\275L\367#}\205\nziM\251\216Z\0057\353\004\347X\233\261;\322\243\227q\223\245g\3467\262\356\357q\202+\240\336\325\213\210\003\f\223M\232\235!\030\276?.\277\336\vu\"\220\240\307\253\267\331\244\340\025U\341!\311\300\267\346\364\220\336\221\027\243\005\352A\344 ?M\304QTl\200\030\017\2628\270\a@\205\323\330}\221U\201\020\3505)\327\270\324)v\235\2261S?\200\230\366\024\370\td\314*\\7\277$\261Km9u\210\252Q\373\225\313~\260\245c.\323\337\324\220\016\217?&\345\033\343xa\a\326\367\2752F\261\375+\031\025\017L\316\342\3304\222T(\036\2575NE\363z\255\273\016\254l\254K\336z\302\346\355\256h\227\002\262\231\303\261+\211\3275\230\003\257\344z\211\264\022\3002\300J\263bZ\023\352\002\256\214\371s!\245\241\270Y)\377\210\370\227~\324-\372\037\370\020\205\003\333\373\2638\343\3273\270\273\360\003\037p9\350\307x\272t=Mfij5\021\301\325\366[~\373\215\240\321Gm\023X\241\022~\n\256\204\247\244\222.\227\036\020\300\311\036F\320\262\021\300I%\373\005\337\216\025\316i\364\214\267G\f\324\243\375\024\315\217\0365\225\nVqs\347\024\225\363\271\247\225\376V\367\313#\256\253\332\364\023\374\234Um\246\224\346\222\214\206\301\266\202z\030\a\016t\236S\323\327\355\352\276\372\224\240\001\t\220\3773>e#\3446T\306\363O\024\343\215\2641\322\020\347\3533\b\330\244z\351gV\217j\251\322\242\247\327#\324\r\tzU\b\374r\n\t\323\201\225\210\330\373\f/\301\247\314\023\367\f\032\205H-#\346 +=0\237\r\362\225\233B\270>\320\302af\262sX\370\370`\202\251\033\327:\rZ\262\316\344\tEr\306\177N\342\f\324\335}mx\355\336&\307\311\205\305\341\326URV\373D\b\022n\314?h_\251\3008\236\003\v\303\025\036\353\331%\254\316\'#c\336\313&\f\360_\345\302\345\260\243\035b.\302\3612&\332V\312\232)\002\354V*>\v\225\244\374;;\005\265\277\360\226B?\004v\350\221\255\273\246<\220q\210<n\353\374\260\033\037n\313\017\330y\337\272\220\361a\215l\337\326\256\034\331\306X\210\321\363\312a\302\275\031a\2413A3\316\003<;\340\241:\031\304\224:u73k\260\246Z\211\b\031\374\026gG3\210\354\233l\357\276\366\353\211`\222^\0249\031\227H\322\230}t\207[>\274\033W\305\000_\250A\305\265\336#\344Zp\251\2021\005WK\372,>\344\364\354\a\021\3351![7\3568 \207\250\244\341\272WSo\265o\265$\323\305\321\222\307[f\304\033\322\034\032h\037\f\312\307s\232\3641d\326\024\230\nGS=\323\240\371\316@\260\020\252\031\342\323\006l4@\f\001R.-\265\253\021?\265V\323\246K\331g\235\ruj=\250\327\243`R\207<#\037\236\260\204\310\223:{\330X\240\367^z\370~\215eD\000i\337r)\355\211\333=\244\370\004\a\336\360\3348\252\025\365\231La,\302\277\002Cwk\026\340]r;\367D\271\275\363\372\312J\265\035\324R\246.LG\220\321\203\277\340\341+\211\242.%\252j\353\251\247\220\fsjY"
