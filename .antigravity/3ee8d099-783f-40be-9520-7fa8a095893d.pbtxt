            lines {
              text: "export function evaluateAchievements("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  profile: PlayerProfileState,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
