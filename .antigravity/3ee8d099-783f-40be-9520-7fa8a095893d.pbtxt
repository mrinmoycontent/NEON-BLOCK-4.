        target_content: "export const NeonCanvas = React.forwardRef<NeonCanvasHandle, NeonCanvasProps>(\n  (\n    {\n      status,\n      bestScore,\n      reducedMotion,\n      onStatsChange,\n      onComboEvent,\n      onGameOver,\n      onRequestPause,\n      onRequestToggleMute,\n      onRequestHudFocus,\n    },\n    ref\n  ) => {\n    const containerRef = useRef<HTMLDivElement>(null);\n    const canvasRef = useRef<HTMLCanvasElement>(null);\n    const layoutRef = useRef<CanvasLayout>(computeCanvasLayout(800, 600));\n\n    const statusRef = useRef(status);\n    statusRef.current = status;\n\n    const bestScoreRef = useRef(bestScore);\n    bestScoreRef.current = bestScore;\n\n    const reducedMotionRef = useRef(reducedMotion);\n    reducedMotionRef.current = reducedMotion;\n\n    const simRef = useRef<SimState>({\n      grid: createShowcaseGrid(),\n      tray: [null, null, null],\n      selectedSlot: -1,\n      stats: {\n        score: 0,\n        bestScore,\n        maxTile: 512,\n        mergesCount: 0,\n        linesCleared: 0,\n        bestCombo: 0,\n        turnsPlayed: 0,\n        isNewBest: false,\n      },\n      preview: null,\n      drag: null,\n      pointerDownPos: null,\n      cursor: {\n        visible: false,\n        zone: \'GRID\',\n        gridRow: 2,\n        gridCol: 2,\n        traySlot: 0,\n      },\n      particles: [],\n      shockwaves: [],\n      beams: [],\n      floatingTexts: [],\n      mergeGhosts: [],\n      motes: createAmbientMotes(26, 900, 600),\n      shakeTimer: 0,\n      shakeIntensity: 0,\n      time: 0,\n    });"
