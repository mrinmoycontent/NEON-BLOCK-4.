  view_file {
    absolute_path_uri: "file:///src/game/renderer.ts"
    end_line: 74
    content: "import { getTilePalette } from \'./palette\';\nimport {\n  BlockPiece,\n  FloatingText,\n  FocusZone,\n  GRID_SIZE,\n  GridMatrix,\n  LineBeam,\n  MergeGhostTile,\n  Particle,\n  PlacementPreview,\n  ShockwaveRing,\n  TRAY_SIZE,\n} from \'./types\';\n\nexport interface Rect {\n  x: number;\n  y: number;\n  w: number;\n  h: number;\n}\n\nexport interface CanvasLayout {\n  width: number;\n  height: number;\n  isLandscape: boolean;\n  boardRect: Rect;\n  cellSize: number;\n  cellGap: number;\n  boardInnerPad: number;\n  traySlots: Rect[];\n}\n\nexport interface AmbientMote {\n  x: number;\n  y: number;\n  r: number;\n  vx: number;\n  vy: number;\n  alpha: number;\n  color: string;\n}\n\nexport interface DragVisualState {\n  active: boolean;\n  slotIndex: number;\n  piece: BlockPiece;\n  pointerX: number;\n  pointerY: number;\n  liftY: number;\n}\n\nexport interface CursorVisualState {\n  visible: boolean;\n  zone: FocusZone;\n  gridRow: number;\n  gridCol: number;\n  traySlot: number;\n}\n\nexport interface RenderFrameState {\n  time: number;\n  grid: GridMatrix;\n  tray: (BlockPiece | null)[];\n  selectedSlot: number;\n  preview: PlacementPreview | null;\n  drag: DragVisualState | null;\n  cursor: CursorVisualState;\n  particles: Particle[];\n  shockwaves: ShockwaveRing[];\n  beams: LineBeam[];\n  floatingTexts: FloatingText[];\n  mergeGhosts: MergeGhostTile[];\n  motes: AmbientMote[];\n  shakeX: number;"
