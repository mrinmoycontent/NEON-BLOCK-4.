    content: "            <div className=\"w-full max-w-sm rounded-2xl bg-[#091026] border border-indigo-400/30 shadow-[0_0_40px_rgba(99,102,241,0.2)] p-6 space-y-4 text-center\">\n              <div className=\"space-y-1\">\n                <h2 className=\"font-display text-2xl font-extrabold tracking-wide text-white\">\n                  Game Paused\n                </h2>\n                <p className=\"text-xs text-slate-400 font-mono-nums\">\n                  {gameMode === \'DAILY\' ? \'Daily Challenge \302\267 \' : \'\'}\n                  Score {stats.score.toLocaleString()} \302\267 Best{\' \'}\n                  {bestScore.toLocaleString()}\n                </p>\n              </div>\n\n              {/* Particle Intensity Setting */}\n              <div className=\"space-y-1.5 text-left\">\n                <div className=\"text-xs text-slate-400 flex items-center justify-between\">\n                  <span>Particle Intensity</span>\n                  {reducedMotion && (\n                    <span className=\"text-[11px] text-slate-500\">\n                      Reduced Motion Active\n                    </span>\n                  )}\n                </div>\n                <div\n                  role=\"group\"\n                  aria-label=\"Particle intensity\"\n                  className=\"grid grid-cols-3 gap-1 p-1 rounded-xl bg-[#0B1228] border border-indigo-500/20\"\n                >\n                  {([\'LOW\', \'MEDIUM\', \'HIGH\'] as ParticleIntensity[]).map(\n                    (lvl) => (\n                      <button\n                        key={lvl}\n                        type=\"button\"\n                        onClick={() => handleParticleIntensityChange(lvl)}\n                        className={`neon-focus min-h-[38px] rounded-lg text-xs font-semibold transition-colors ${\n                          particleIntensity === lvl\n                            ? \'bg-cyan-500/20 text-cyan-200 border border-cyan-400/50\'\n                            : \'text-slate-400 hover:text-slate-200 border border-transparent\'\n                        }`}\n                      >\n                        {lvl === \'LOW\'\n                          ? \'Low\'\n                          : lvl === \'MEDIUM\'\n                            ? \'Medium\'\n                            : \'High\'}\n                      </button>\n                    )\n                  )}\n                </div>\n              </div>\n\n              <div className=\"flex flex-col gap-2\">\n                <button\n                  ref={resumeBtnRef}\n                  type=\"button\"\n                  onClick={pauseGame}\n                  className=\"neon-focus min-h-[46px] px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-semibold text-sm transition-colors\"\n                >\n                  Resume Game\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => openDashboard(\'OVERVIEW\')}\n                  className=\"neon-focus min-h-[44px] px-5 py-2.5 rounded-xl bg-[#0F1838] border border-cyan-400/30 hover:border-cyan-400/60 text-cyan-100 font-medium text-sm transition-colors\"\n                >\n                  Player Dashboard\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={restartCurrentMode}\n                  className=\"neon-focus min-h-[44px] px-5 py-2.5 rounded-xl bg-[#0F1838] border border-indigo-400/30 hover:border-cyan-400/60 text-slate-100 font-medium text-sm transition-colors\"\n                >\n                  Restart\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={toggleMute}\n                  className=\"neon-focus min-h-[44px] px-5 py-2.5 rounded-xl bg-[#0F1838] border border-indigo-400/30 hover:border-cyan-400/60 text-slate-100 font-medium text-sm transition-colors\"\n                >\n                  {muted ? \'Sound: Off\' : \'Sound: On\'}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={openHelp}\n                  className=\"neon-focus min-h-[44px] px-5 py-2.5 rounded-xl bg-[#0F1838] border border-indigo-400/30 hover:border-cyan-400/60 text-slate-100 font-medium text-sm transition-colors\"\n                >\n                  How to Play (H)\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={returnToTitle}\n                  className=\"neon-focus min-h-[44px] px-5 py-2.5 rounded-xl bg-transparent border border-slate-700/80 hover:border-slate-500 text-slate-300 font-medium text-sm transition-colors\"\n                >\n                  Main Menu\n                </button>\n              </div>\n            </div>"
