              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'bestStreak\':"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return Math.max("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
